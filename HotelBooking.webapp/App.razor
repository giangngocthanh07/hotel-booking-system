@* Filepath: HotelBooking.webapp\App.razor *@

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @* --- AuthorizeRouteView handles role-based access control --- *@
            <AuthorizeRouteView RouteData="@routeData">

                @* --- BEST PRACTICE: Render NotFound for Unauthorized users --- *@
                @* By using the same UI as the 404 page, we prevent "URL Enumeration" *@
                @* Attackers won't know if the Admin URL exists or not *@
                <NotAuthorized>
                    <PageTitle>404 - Not Found</PageTitle>
                    <LayoutView Layout="@typeof(MainLayout)">
                        @* Render the exact same 404 UI here *@
                        <div class="error-page-wrapper force-gpu">
                            <div class="error-card shadow-lg animate__animated animate__zoomIn">
                                <div class="error-code-bg">404</div>
                                <div class="error-icon-box primary-gradient shadow-sm">
                                    <i class="fas fa-map-marked-alt"></i>
                                </div>
                                <h1 class="error-title">Page Not Found</h1>
                                <p class="error-message">
                                    The destination you are looking for might have been moved,
                                    deleted, or the link is simply broken.
                                </p>
                                <div class="error-actions justify-content-center">
                                    <a href="/" class="btn-glass-primary px-5 shadow-sm">
                                        <i class="fas fa-arrow-left me-2"></i>Return to Homepage
                                    </a>
                                </div>
                            </div>
                        </div>
                    </LayoutView>
                </NotAuthorized>

            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>

        <NotFound>
            @* --- STANDARD 404 PAGE --- *@
            <PageTitle>404 - Not Found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="error-page-wrapper force-gpu">
                    <div class="error-card shadow-lg animate__animated animate__zoomIn">
                        <div class="error-code-bg">404</div>
                        <div class="error-icon-box primary-gradient shadow-sm">
                            <i class="fas fa-map-marked-alt"></i>
                        </div>
                        <h1 class="error-title">Page Not Found</h1>
                        <p class="error-message">
                            The destination you are looking for might have been moved,
                            deleted, or the link is simply broken.
                        </p>
                        <div class="error-actions justify-content-center">
                            <a href="/" class="btn-glass-primary px-5 shadow-sm">
                                <i class="fas fa-arrow-left me-2"></i>Return to Homepage
                            </a>
                        </div>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<style>
    /* --- ERROR PAGES CORE STYLES (Glassmorphism) --- */

    .error-page-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .error-card {
        background: var(--glass-bg-deep);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--glass-border);
        border-radius: 32px;
        padding: 4.5rem 3rem;
        max-width: 580px;
        width: 100%;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .error-icon-box {
        width: 80px;
        height: 80px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        font-size: 2.5rem;
        color: white;
        position: relative;
        z-index: 2;
    }

    .primary-gradient {
        background: var(--admin-primary-gradient);
    }

    .error-title {
        font-family: 'DM Serif Display', serif;
        font-size: 2.5rem;
        color: var(--text-dark);
        margin-bottom: 1rem;
    }

    .error-message {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 2.5rem;
    }

    /* Background Watermark */
    .error-code-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 13rem;
        font-weight: 900;
        color: rgba(0, 0, 0, 0.03);
        z-index: 1;
        user-select: none;
    }

    .btn-glass-primary {
        background: var(--admin-primary-gradient);
        color: white !important;
        text-decoration: none;
        padding: 12px 32px;
        border-radius: 14px;
        font-weight: 700;
        transition: 0.3s;
        position: relative;
        z-index: 2;
    }

    .btn-glass-primary:hover {
        transform: translateY(-3px);
        filter: brightness(1.1);
        box-shadow: 0 10px 20px rgba(58, 123, 213, 0.2);
    }

    .force-gpu {
        transform: translateZ(0);
        -webkit-backface-visibility: hidden;
    }

    @@media (max-width: 576px) {
        .error-card {
            padding: 3rem 1.5rem;
        }

        .error-title {
            font-size: 2rem;
        }
    }
</style>
