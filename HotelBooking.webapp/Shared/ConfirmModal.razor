@if (_isVisible)
{
    @* Blur Background *@
    <div class="modal-backdrop-glass fade show force-gpu"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content glass-modal-content force-gpu shadow-lg">

                @* HEADER: Danger Zone*@
                <div class="modal-header glass-modal-header border-0 shadow-sm">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center">
                        <div class="warning-icon-box me-3"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        @Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Hide"></button>
                </div>

                @* BODY *@
                <div class="modal-body py-5 px-4 text-center">
                    <p class="fw-bold fs-5 text-dark mb-2">@Message</p>
                    @ChildContent
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-circle-info me-1 text-danger"></i> 
                        This action cannot be undone. Please confirm carefully.
                    </p>
                </div>

                @* FOOTER *@
                <div class="modal-footer border-0 p-4 pt-0 d-flex justify-content-center gap-3">
                    <button type="button" class="btn-glass-cancel flex-grow-1" @onclick="Hide">
                        <i class="fa-solid fa-xmark me-2"></i>Cancel
                    </button>

                    <button type="button" class="flex-grow-1 shadow-sm @ConfirmButtonClass" @onclick="OnConfirmClicked" disabled="@IsProcessing">
                        @if (IsProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="fa-solid @ConfirmIcon me-2"></i>@ConfirmText
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<style>
    /* Blur Background*/
    .modal-backdrop-glass {
        position: fixed; top: 0; left: 0; z-index: 1040;
        width: 100vw; height: 100vh;
        background-color: rgba(15, 23, 42, 0.4); /* Slate 900 semi-transparent */
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    /* Modal Content Style */
    .glass-modal-content {
        background: rgba(255, 255, 255, 0.9) !important;
        border-radius: 28px !important;
        border: 1px solid var(--glass-border) !important;
        overflow: hidden;
    }

    .glass-modal-header {
        background: var(--admin-primary-gradient); 
        padding: 1.5rem 2rem;
        border-radius: 0;
    }
    
    /* Warning Icon Style*/
    .warning-icon-box {
        width: 35px; height: 35px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
    }

    /* Buttons Style */
    .btn-glass-cancel {
        background: #f1f5f9;
        border: 1.5px solid #e2e8f0;
        color: var(--text-muted);
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 700;
        transition: 0.3s;
    }
    .btn-glass-cancel:hover { background: #e2e8f0; color: var(--text-dark); }

    .btn-glass-confirm-danger {
        background: linear-gradient(135deg, #f43f5e, #dc2626);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 700;
        transition: 0.3s;
    }
    .btn-glass-confirm-danger:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
        box-shadow: 0 10px 20px rgba(220, 38, 38, 0.2) !important;
    }

    /* Fix table white spots when screenshot */
    .force-gpu {
        transform: translateZ(0);
        -webkit-backface-visibility: hidden;
    }
</style>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string ConfirmIcon { get; set; } = "fa-check";
    [Parameter] public string ConfirmButtonClass { get; set; } = "btn-glass-confirm-danger"; // Defaults to danger (red)
    [Parameter] public bool IsProcessing { get; set; } = false;

    // Modal Control
    [Parameter] public string Title { get; set; } = "Confirm Delete";
    [Parameter] public string Message { get; set; } = "Are you sure you want to delete this item?";
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _isVisible = false;

    public void Show() { _isVisible = true; StateHasChanged(); }
    public void Hide() { _isVisible = false; StateHasChanged(); }

    private async Task OnConfirmClicked()
    {
        await OnConfirm.InvokeAsync();
        Hide();
    }
}