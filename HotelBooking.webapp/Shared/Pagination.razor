@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Components\Common\Pagination.razor *@

@if (TotalPages > 1)
{
    <div class="glass-pagination-wrapper force-gpu animate__animated animate__fadeIn">
        @* Row 1: Pagination Buttons *@
        <nav class="d-flex justify-content-center">
            <ul class="pagination glass-pagination-list">
                @* Previous Button *@
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link glass-btn force-gpu" @onclick="GoToPrevious" disabled="@IsLoading">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </li>

                @foreach (var pageNumber in GetPageNumbers())
                {
                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                        <button class="page-link glass-btn force-gpu" @onclick="() => GoToPage(pageNumber)" disabled="@IsLoading">
                            @pageNumber
                        </button>
                    </li>
                }

                @* Next Button *@
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link glass-btn force-gpu" @onclick="GoToNext" disabled="@IsLoading">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </nav>

        @* Row 2: Pagination Info *@
        @if (ShowInfo)
        {
            <div class="glass-pagination-label">
                Page <strong class="text-dark">@CurrentPage</strong> of <strong>@TotalPages</strong> 
                <span class="mx-1 opacity-50">—</span> 
                Total <strong>@TotalCount</strong> items
            </div>
        }
    </div>
}

<style>
    /* --- INTEGRATED PAGINATION STYLES --- */
    .glass-pagination-wrapper {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin-top: 1.5rem !important;
        margin-bottom: 0.5rem !important;
        gap: 14px !important;
    }

    .glass-pagination-list {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        padding: 0 !important;
        margin: 0 !important;
        list-style: none !important;
        gap: 10px !important;
        border: none !important;
    }

    /* Glassmorphism Button Core */
    .glass-btn {
        background: var(--glass-bg) !important;
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--glass-border) !important;
        color: var(--text-main) !important;
        border-radius: 12px !important;
        width: 42px !important;
        height: 42px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-weight: 700 !important;
        font-size: 0.9rem !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
        padding: 0 !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03) !important;
    }

    /* Active State Sync with Admin Theme */
    .page-item.active .glass-btn {
        background: var(--admin-primary-gradient) !important;
        color: #ffffff !important;
        border: none !important;
        box-shadow: 0 8px 20px rgba(58, 123, 213, 0.25) !important;
        transform: scale(1.05);
    }

    /* Hover State */
    .glass-btn:hover:not(:disabled) {
        transform: translateY(-3px) !important;
        background: #ffffff !important;
        border-color: var(--admin-blue) !important;
        color: var(--admin-blue) !important;
    }

    .page-item.disabled .glass-btn {
        opacity: 0.3 !important;
        cursor: not-allowed !important;
        box-shadow: none !important;
    }

    /* Info Label Text */
    .glass-pagination-label {
        color: var(--text-muted) !important;
        font-size: 0.75rem !important;
        font-weight: 600 !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .glass-pagination-label strong {
        color: var(--text-dark) !important;
        font-weight: 800;
    }
</style>

@code {
    // Core logic unchanged
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool ShowInfo { get; set; } = true;
    [Parameter] public int Spread { get; set; } = 2;
    [Parameter] public string ContainerClass { get; set; } = "d-flex justify-content-center mt-4";
    [Parameter] public string PaginationClass { get; set; } = "";
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    private IEnumerable<int> GetPageNumbers()
    {
        var start = Math.Max(1, CurrentPage - Spread);
        var end = Math.Min(TotalPages, CurrentPage + Spread);
        return Enumerable.Range(start, end - start + 1);
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage && !IsLoading)
        {
            await OnPageChange.InvokeAsync(page);
        }
    }

    private async Task GoToPrevious() { if (CurrentPage > 1) await GoToPage(CurrentPage - 1); }
    private async Task GoToNext() { if (CurrentPage < TotalPages) await GoToPage(CurrentPage + 1); }
}