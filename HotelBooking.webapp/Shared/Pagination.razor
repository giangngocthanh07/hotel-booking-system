@* Reusable Pagination Component
    Usage: <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" 
                       TotalCount="@totalCount" OnPageChange="GoToPage" />
*@

@if (TotalPages > 1)
{
    <div class="glass-pagination-wrapper">
        @* Row 1: Pagination Buttons *@
        <nav class="d-flex justify-content-center">
            <ul class="pagination glass-pagination-list">
                @* Previous Button *@
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link glass-btn" @onclick="GoToPrevious" disabled="@IsLoading">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </li>

                @foreach (var pageNumber in GetPageNumbers())
                {
                    <li class="page-item @(pageNumber == CurrentPage ? "active" : "")">
                        <button class="page-link glass-btn" @onclick="() => GoToPage(pageNumber)" disabled="@IsLoading">
                            @pageNumber
                        </button>
                    </li>
                }

                @* Next Button *@
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link glass-btn" @onclick="GoToNext" disabled="@IsLoading">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </nav>

        @* Row 2: Pagination Info *@
        @if (ShowInfo)
        {
            <div class="glass-pagination-label">
                Page <strong>@CurrentPage</strong> of <strong>@TotalPages</strong> — Total @TotalCount items
            </div>
        }
    </div>
}

<style>
    /* Center the entire pagination block */
    .glass-pagination-wrapper {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100% !important;
        margin-top: 2rem !important;
        margin-bottom: 1rem !important;
        gap: 12px !important;
    }

    /* Force the pagination list to always be horizontal, no wrapping */
    .glass-pagination-list {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        padding: 0 !important;
        margin: 0 !important;
        list-style: none !important;
        gap: 8px !important;
        border: none !important;
    }

    .page-item {
        border: none !important;
        margin: 0 !important;
    }

    /* Glassmorphism button design */
    .glass-btn {
        background: rgba(255, 255, 255, 0.7) !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.8) !important;
        color: #334155 !important;
        border-radius: 12px !important;
        width: 40px !important;
        height: 40px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-weight: 700 !important;
        transition: all 0.3s ease !important;
        padding: 0 !important;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02) !important;
    }

    /* Active page button */
    .page-item.active .glass-btn {
        background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%) !important;
        color: #ffffff !important;
        border: none !important;
        box-shadow: 0 8px 15px rgba(0, 210, 255, 0.3) !important;
    }

    .glass-btn:hover:not(:disabled) {
        transform: translateY(-3px) !important;
        background: #ffffff !important;
        border-color: #0060e6 !important;
        color: #0060e6 !important;
    }

    .page-item.disabled .glass-btn {
        opacity: 0.4 !important;
        cursor: not-allowed !important;
    }

    /* Row 2: Pagination Info */
    .glass-pagination-label {
        color: #64748b !important;
        font-size: 0.85rem !important;
        font-weight: 500 !important;
        text-align: center !important;
        width: 100% !important;
        display: block !important;
    }

    .glass-pagination-label strong {
        color: #1e293b !important;
    }
</style>

@code {
    /// <summary>
    /// Current active page (1-indexed)
    /// </summary>
    [Parameter] public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Total number of pages
    /// </summary>
    [Parameter] public int TotalPages { get; set; }

    /// <summary>
    /// Total number of items (optional, used for informational display)
    /// </summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>
    /// Loading state flag to disable interactions
    /// </summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>
    /// Whether to display the "Page x of y" info text
    /// </summary>
    [Parameter] public bool ShowInfo { get; set; } = true;

    /// <summary>
    /// Number of pages to show on each side of the current page
    /// E.g., CurrentPage=5, Spread=2 -> shows [3,4,5,6,7]
    /// </summary>
    [Parameter] public int Spread { get; set; } = 2;

    /// <summary>
    /// CSS class for the container div (Default: d-flex justify-content-center mt-4)
    /// </summary>
    [Parameter] public string ContainerClass { get; set; } = "d-flex justify-content-center mt-4";

    /// <summary>
    /// Additional CSS classes for the ul.pagination element
    /// </summary>
    [Parameter] public string PaginationClass { get; set; } = "";

    /// <summary>
    /// Event callback triggered when a user navigates to a different page
    /// </summary>
    [Parameter] public EventCallback<int> OnPageChange { get; set; }

    /// <summary>
    /// Calculates the range of page numbers to display based on the spread parameter.
    /// </summary>
    private IEnumerable<int> GetPageNumbers()
    {
        var start = Math.Max(1, CurrentPage - Spread);
        var end = Math.Min(TotalPages, CurrentPage + Spread);
        return Enumerable.Range(start, end - start + 1);
    }

    private async Task GoToPage(int page)
    {
        // Guard clause: Prevent unnecessary or invalid calls
        if (page >= 1 && page <= TotalPages && page != CurrentPage && !IsLoading)
        {
            await OnPageChange.InvokeAsync(page);
        }
    }

    private async Task GoToPrevious()
    {
        if (CurrentPage > 1)
            await GoToPage(CurrentPage - 1);
    }

    private async Task GoToNext()
    {
        if (CurrentPage < TotalPages)
            await GoToPage(CurrentPage + 1);
    }
}