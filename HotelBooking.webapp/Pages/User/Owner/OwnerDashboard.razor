@page "/owner-dashboard"
@using HotelBooking.webapp.ViewModels.Hotel
@using HotelBooking.webapp.Services
@attribute [Authorize(Roles = "Owner")]
@layout OwnerLayout
@inject IDashboardService DashboardService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">Owner Dashboard</MudText>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else if (_dashboardData != null)
    {
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="d-flex flex-row pt-6 pb-4" Style="height:100px;">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Primary" Class="mx-4" Style="width:54px; height:54px;"></MudIcon>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-n1">Arrivals Today</MudText>
                        <MudText Typo="Typo.h5">@_dashboardData.TodayArrivals</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="d-flex flex-row pt-6 pb-4" Style="height:100px;">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Warning" Class="mx-4" Style="width:54px; height:54px;"></MudIcon>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-n1">Departures Today</MudText>
                        <MudText Typo="Typo.h5">@_dashboardData.TodayDepartures</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="d-flex flex-row pt-6 pb-4" Style="height:100px;">
                    <MudIcon Icon="@Icons.Material.Filled.Hotel" Color="Color.Info" Class="mx-4" Style="width:54px; height:54px;"></MudIcon>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-n1">Occupancy Rate</MudText>
                        <MudText Typo="Typo.h5">@_dashboardData.OccupancyRate%</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="d-flex flex-row pt-6 pb-4" Style="height:100px;">
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Success" Class="mx-4" Style="width:54px; height:54px;"></MudIcon>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-n1">Revenue (30d)</MudText>
                        <MudText Typo="Typo.h5">@_dashboardData.TotalRevenue.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Style="height:400px;">
                    <MudText Typo="Typo.h6" GutterBottom="true">Daily Revenue (Last 30 Days)</MudText>
                    <MudChart ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_xAxisLabels" Width="100%" Height="300px" ChartOptions="@_chartOptions" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Style="height:400px; overflow-y: auto;">
                    <MudText Typo="Typo.h6" GutterBottom="true">Room Availability</MudText>
                    <MudList T="string">
                        @foreach (var room in _dashboardData.RoomAvailability)
                        {
                            <MudListItem>
                                <div class="d-flex justify-space-between align-center">
                                    <MudText>@room.RoomTypeName</MudText>
                                    <MudChip T="string" Color="@(room.AvailableRooms > 0 ? Color.Success : Color.Error)" Size="Size.Small">
                                        @room.AvailableRooms / @room.TotalRooms Available
                                    </MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" GutterBottom="true">Recent Bookings</MudText>
                    <MudTable Items="@_dashboardData.RecentBookings" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>ID</MudTh>
                            <MudTh>Customer</MudTh>
                            <MudTh>Room Type</MudTh>
                            <MudTh>Check In</MudTh>
                            <MudTh>Check Out</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="ID">#BK-@context.Id</MudTd>
                            <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                            <MudTd DataLabel="Room Type">@context.RoomTypeName</MudTd>
                            <MudTd DataLabel="Check In">@context.CheckIn.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Check Out">@context.CheckOut.ToShortDateString()</MudTd>
                            <MudTd DataLabel="Total">@context.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private OwnerDashboardVM? _dashboardData;
    private bool _loading = true;
    private List<ChartSeries> _series = new();
    private string[] _xAxisLabels = Array.Empty<string>();
    private ChartOptions _chartOptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var response = await DashboardService.GetOwnerDashboardStats();
            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
            {
                _dashboardData = response.Content;
                
                // Prepare Chart Data (Sample every 5 days for clarity)
                var trend = _dashboardData.DailyRevenueTrend;
                _xAxisLabels = trend.Where((x, i) => i % 5 == 0).Select(t => t.DateLabel).ToArray();
                _series = new List<ChartSeries>
                {
                    new ChartSeries { Name = "Revenue", Data = trend.Select(t => (double)t.Amount).ToArray() }
                };
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load dashboard data.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("An unexpected error occurred.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Confirmed" => Color.Success,
        "Pending" => Color.Info,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}