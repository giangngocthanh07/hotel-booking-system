@page "/owner/bookings"
@using HotelBooking.webapp.ViewModels.Booking
@using HotelBooking.webapp.Services
@using HotelBooking.webapp.Helpers
@attribute [Authorize(Roles = "Owner")]
@layout OwnerLayout
@inject IBookingService BookingService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">Booking Management</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_searchTerm" Placeholder="Search by Reference ID or Guest Name..." 
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" 
                              OnClearClick="@(async () => await Search())" Immediate="true" 
                              OnKeyDown="@(async e => { if (e.Key == "Enter") await Search(); })" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" Label="Status" @bind-Value="_currentStatus" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("All")">All Status</MudSelectItem>
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                    <MudSelectItem Value="@("Confirmed")">Confirmed</MudSelectItem>
                    <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                    <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-end">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Search">Filter</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_bookings" Loading="@_loading" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Guest</MudTh>
            <MudTh>Room Type</MudTh>
            <MudTh>Stay Period</MudTh>
            <MudTh>Total Price</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.BookingReference</MudTd>
            <MudTd DataLabel="Guest">@context.CustomerName</MudTd>
            <MudTd DataLabel="Room Type">@context.RoomTypeName</MudTd>
            <MudTd DataLabel="Stay Period">
                <MudText Typo="Typo.body2">@context.CheckInDate.ToShortDateString() - @context.CheckOutDate.ToShortDateString()</MudText>
            </MudTd>
            <MudTd DataLabel="Total Price">@context.TotalPrice.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Icon="@Icons.Material.Filled.Visibility">View Details</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">Check-in</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error">No Show</MudMenuItem>
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No bookings found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading bookings...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<BookingHistoryVM> _bookings = new();
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private string _currentStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task Search()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        _loading = true;
        try
        {
            var response = await BookingService.GetOwnerBookingManagement(_currentStatus == "All" ? null : _currentStatus, _searchTerm);
            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
            {
                _bookings = response.Content.ToList();
            }
            else
            {
                Snackbar.Add(response.Message ?? "Failed to load bookings.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("An unexpected error occurred.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Confirmed" => Color.Success,
        "Pending" => Color.Info,
        "Completed" => Color.Primary,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
