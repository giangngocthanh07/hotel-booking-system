    public class HotelRegistrationFormVM
    {
        [Required(ErrorMessage = "Hotel name is required.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Hotel name must be 2–50 characters.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(500, ErrorMessage = "Description cannot exceed 500 characters.")]
        public string Description { get; set; } = string.Empty;

        [Required]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a property type.")]
        public int PropertyTypeId { get; set; } = 0;

        [Range(1, 5, ErrorMessage = "Star rating must be between 1 and 5.")]
        public int? StarRating { get; set; }

        [Required(ErrorMessage = "Public phone is required.")]
        [RegularExpression(@"^\d{10}$", ErrorMessage = "Phone number must be exactly 10 digits.")]
        public string PublicPhone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Public email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string PublicEmail { get; set; } = string.Empty;

        [Required(ErrorMessage = "Address is required.")]
        [StringLength(500, MinimumLength = 5, ErrorMessage = "Please enter a valid address (min. 5 characters).")]
        public string Address { get; set; } = string.Empty;

        [Required]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a province.")]
        public int ProvinceId { get; set; } = 0;

        [Required]
        [Range(1, int.MaxValue, ErrorMessage = "Please select a ward.")]
        public int WardId { get; set; } = 0;

        [Range(-90.0, 90.0, ErrorMessage = "Latitude must be between -90 and 90.")]
        public double? Latitude { get; set; }

        [Range(-180.0, 180.0, ErrorMessage = "Longitude must be between -180 and 180.")]
        public double? Longitude { get; set; }

        [Required(ErrorMessage = "Tax code is required.")]
        [RegularExpression(@"^(\d{10}|\d{13})$", ErrorMessage = "Tax code must be exactly 10 or 13 digits.")]
        public string TaxCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Business license URL is required.")]
        [Url(ErrorMessage = "Please enter a valid URL (e.g., https://...).")]
        public string BusinessLicenseUrl { get; set; } = string.Empty;
    }
