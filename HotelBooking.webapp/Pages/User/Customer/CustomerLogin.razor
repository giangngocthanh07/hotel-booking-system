@page "/customer-login"
@layout AuthLayout

@using HotelBooking.Client

@using HotelBooking.webapp.ViewModels.Form
@using HotelBooking.webapp.ViewModels.Response

@inject NavigationManager _nav
@inject AuthenticationStateProvider AuthStateProvider

@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Login - Hotel Booking</PageTitle>

<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header text-center">
                <a href="/" class="auth-logo">
                    <img src="favicon.ico" alt="Hotel Booking Logo" />
                    <span class="ms-2">Hotel Booking</span>
                </a>
                <h2 class="mt-4 fw-bold">Welcome Back</h2>
                <p class="text-muted">Sign in to continue your journey</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="custom-alert-error" role="alert">
                    <div class="alert-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <div class="alert-content">
                        <div class="alert-message">@errorMessage</div>
                    </div>
                    <button type="button" class="alert-close" @onclick="() => errorMessage = null">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            }

            <EditForm Model="userLogin" OnValidSubmit="HandleValidSubmit" class="auth-form mt-2">
                <DataAnnotationsValidator />

                <div class="form-floating mb-3">
                    <InputText @bind-Value="userLogin.UsernameOrEmail" class="form-control auth-input"
                        id="inputUsernameEmail" placeholder="name@example.com" />
                    <label for="inputUsernameEmail">Username or Email</label>
                    <ValidationMessage For="@(() => userLogin.UsernameOrEmail)" class="text-danger small" />
                </div>

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="userLogin.Password" class="form-control auth-input"
                        id="inputPassword" placeholder="••••••••" />
                    <label for="inputPassword">Password</label>
                    <ValidationMessage For="@(() => userLogin.Password)" class="text-danger small" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check custom-checkbox">
                        <InputCheckbox class="form-check-input" @bind-Value="rememberMe" id="rememberCheck" />
                        <label class="form-check-label small text-muted" for="rememberCheck">
                            Remember me
                        </label>
                    </div>
                    <a href="#" class="auth-link small">Forgot password?</a>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button type="submit" class="btn btn-primary auth-btn btn-lg py-3">
                        <span class="btn-text">Sign In</span>
                    </button>
                </div>

                <div class="text-center">
                    <p class="mb-0 text-muted small">
                        Don't have an account?
                        <a href="/customer-register" class="auth-link fw-bold">Create one now</a>
                    </p>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer text-center mt-4">
            <p class="text-muted small">© @DateTime.Now.Year Hotel Booking. All rights reserved.</p>
            <div class="auth-footer-links">
                <a href="/" class="text-muted me-3">Privacy Policy</a>
                <a href="/" class="text-muted">Terms of Service</a>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #0060e6;
        --secondary-color: #00b4d8;
        --card-bg: rgba(255, 255, 255, 0.65);
        --text-main: #1e293b;
        --text-muted: #64748b;
        --input-bg: #ffffff;
        --input-border: #cbd5e1;
        --input-focus: #0060e6;
    }

    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f0f9ff;
        background-image:
            radial-gradient(at 0% 0%, hsla(190, 100%, 90%, 1) 0px, transparent 50%),
            radial-gradient(at 50% 0%, hsla(205, 100%, 85%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 0%, hsla(188, 100%, 92%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 100%, hsla(215, 100%, 88%, 1) 0px, transparent 50%),
            radial-gradient(at 0% 100%, hsla(195, 100%, 95%, 1) 0px, transparent 50%);
        background-size: 150% 150%;
        animation: gradientShift 20s ease infinite;
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
    }

    .auth-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.5) 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.4) 0%, transparent 40%);
        pointer-events: none;
    }

    .auth-container {
        width: 100%;
        max-width: 450px;
        animation: fadeIn 0.6s ease-out;
        position: relative;
        z-index: 1;
    }

    .auth-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        padding: 3rem 2.5rem;
        border-radius: 28px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .auth-logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--primary-color);
        font-weight: 800;
        font-size: 1.25rem;
        font-family: 'DM Serif Display', serif;
    }

    .auth-logo img {
        height: 32px;
        width: 32px;
    }

    .auth-header h2 {
        color: var(--text-main);
        font-size: 2rem;
        font-family: 'DM Serif Display', serif;
        margin-bottom: 0.5rem;
    }

    .auth-header .text-muted {
        color: var(--text-muted) !important;
        font-size: 0.95rem;
    }

    .auth-input {
        background: var(--input-bg) !important;
        border: 1.5px solid var(--input-border) !important;
        border-radius: 14px;
        height: 58px;
        color: var(--text-main) !important;
        transition: all 0.3s ease;
    }

    .auth-input:focus {
        border-color: var(--input-focus) !important;
        box-shadow: 0 0 0 4px rgba(0, 96, 230, 0.1);
        outline: none;
    }

    .form-floating label {
        color: #94a3b8;
    }

    .auth-btn {
        background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
        border: none;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        color: #ffffff;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .auth-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(58, 123, 213, 0.3);
        filter: brightness(1.05);
        color: #ffffff;
    }

    .auth-link {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

    .auth-link:hover {
        color: #3a7bd5;
        text-decoration: underline;
    }

    .custom-checkbox .form-check-input {
        border: 1.5px solid var(--input-border);
        cursor: pointer;
    }

    .custom-checkbox .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .custom-alert-error {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        margin-bottom: 1.5rem;
        background: #fef2f2;
        border: 1px solid #fee2e2;
        border-radius: 14px;
        color: #991b1b;
        animation: slideIn 0.3s ease-out;
    }

    .alert-icon svg {
        color: #dc2626;
    }

    .alert-close {
        background: transparent;
        border: none;
        color: #991b1b;
        opacity: 0.5;
        display: flex;
    }

    .auth-footer .text-muted {
        color: #94a3b8 !important;
    }

    .auth-footer-links a {
        color: #64748b !important;
        text-decoration: none;
        font-size: 0.85rem;
    }

    .auth-footer-links a:hover {
        color: var(--primary-color) !important;
    }

    @@keyframes gradientShift {
        0% {
            background-position: 0% 0%;
        }

        50% {
            background-position: 100% 100%;
        }

        100% {
            background-position: 0% 0%;
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@media (max-width: 576px) {
        .auth-card {
            padding: 2.5rem 1.5rem;
        }
    }
</style>

@code {
    private UserLoginVM userLogin = new UserLoginVM();
    private string? errorMessage;
    private HttpClient? _httpClient;
    private bool rememberMe = false;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");

        var savedRememberMe = await localStorage.GetItemAsync<bool>("rememberMe");
        if (savedRememberMe)
        {
            rememberMe = true;
            var savedUsername = await localStorage.GetItemAsync<string>("savedUsername");
            if (!string.IsNullOrEmpty(savedUsername))
            {
                userLogin.UsernameOrEmail = savedUsername;
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (_httpClient == null)
            {
                errorMessage = "System error: HttpClient is not initialized.";
                return;
            }

            var response = await _httpClient.PostAsJsonAsync("v1/authentication/login", userLogin);
            var loginResponse = await response.Content.ReadFromJsonAsync<ApiResponse<LoginResponseVM>>();

            if (response.IsSuccessStatusCode)
            {
                if (loginResponse?.Content?.AccessToken != null)
                {
                    if (rememberMe)
                    {
                        await localStorage.SetItemAsync("rememberMe", true);
                        await localStorage.SetItemAsync("savedUsername", userLogin.UsernameOrEmail);
                    }
                    else
                    {
                        await localStorage.RemoveItemAsync("rememberMe");
                        await localStorage.RemoveItemAsync("savedUsername");
                    }

                    await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(loginResponse.Content.AccessToken);
                    errorMessage = null;
                    _nav.NavigateTo("/", forceLoad: true);
                }
                else
                {
                    errorMessage = "Login successful, but no security token was received.";
                }
            }
            else
            {
                errorMessage = loginResponse?.Message ?? "Invalid username or password. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the server. Please check your internet connection.";
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }


}