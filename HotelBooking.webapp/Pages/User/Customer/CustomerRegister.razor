@page "/customer-register"
@layout AuthLayout

@inject IHttpClientFactory HttpClientFactory;
@inject NavigationManager _navManager;
@inject MudBlazor.ISnackbar Snackbar;

@using System.Net.Http.Json
@using System.Text.Json
@using HotelBooking.webapp.ViewModels.Form
@using MudBlazor

<PageTitle>Create Account - Hotel Booking</PageTitle>

<div class="auth-wrapper force-gpu">
    <div class="auth-container wide">
        @* --- REGISTER CARD (Glassmorphism Deep) --- *@
        <div class="auth-card shadow-lg force-gpu">
            <div class="auth-header text-center mb-4">
                <a href="/" class="auth-logo-wrap">
                    <img src="favicon.ico" alt="Logo" class="logo-img" />
                    <span class="ms-2">Hotel Booking</span>
                </a>
                <h2 class="mt-4 fw-bold text-dark">Create Account</h2>
                <p class="text-muted small uppercase-tracking">Join us to experience exclusive booking services</p>
            </div>

            <EditForm Model="@userRegister" OnValidSubmit="HandleValidSubmit" class="auth-form mt-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(messageAlert))
                {
                    <div class="glass-alert @(isError ? "error" : "success") animate__animated animate__fadeIn" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas @(isError ? "fa-exclamation-circle" : "fa-check-circle") me-3"></i>
                            <div class="alert-message">@messageAlert</div>
                        </div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Username" class="form-control glass-input-auth" id="username" placeholder="Username" />
                            <label for="username">Username</label>
                            <ValidationMessage For="@(() => userRegister.Username)" class="val-msg-custom" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Email" type="email" class="form-control glass-input-auth" id="email" placeholder="Email" />
                            <label for="email">Email address</label>
                            <ValidationMessage For="@(() => userRegister.Email)" class="val-msg-custom" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.FullName" class="form-control glass-input-auth" id="fullname" placeholder="Full Name" />
                            <label for="fullname">Full Name</label>
                            <ValidationMessage For="@(() => userRegister.FullName)" class="val-msg-custom" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.PhoneNumber" class="form-control glass-input-auth" id="phone" placeholder="Phone" />
                            <label for="phone">Phone Number</label>
                            <ValidationMessage For="@(() => userRegister.PhoneNumber)" class="val-msg-custom" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Password" type="password" class="form-control glass-input-auth" id="password" placeholder="Password" />
                            <label for="password">Password</label>
                            <ValidationMessage For="@(() => userRegister.Password)" class="val-msg-custom" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.ConfirmPassword" type="password" class="form-control glass-input-auth" id="confirmPassword" placeholder="Confirm Password" />
                            <label for="confirmPassword">Confirm Password</label>
                            <ValidationMessage For="@(() => userRegister.ConfirmPassword)" class="val-msg-custom" />
                        </div>
                    </div>
                </div>

                <div class="auth-options mt-4 px-1">
                    <div class="form-check custom-checkbox-glass mb-2">
                        <InputCheckbox class="form-check-input" id="receiveEmail" @bind-Value="userRegister.ReceiveEmail" />
                        <label class="form-check-label small fw-600 text-muted" for="receiveEmail">
                            Yes, I want to receive exclusive offers and news
                        </label>
                    </div>

                    <div class="form-check custom-checkbox-glass">
                        <InputCheckbox @bind-Value="userRegister.AgreeTerm" class="form-check-input" id="agreeTerm" />
                        <label class="form-check-label small fw-600 text-muted" for="agreeTerm">
                            I agree to the <a href="/terms" class="auth-link-primary">Terms</a> and <a href="/privacy" class="auth-link-primary">Privacy Policy</a>.
                        </label>
                        <ValidationMessage For="@(() => userRegister.AgreeTerm)" class="val-msg-custom" />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 mb-3">
                    <button type="submit" class="btn-auth-primary force-gpu py-3">SIGN UP</button>
                </div>

                <div class="text-center">
                    <p class="mb-0 text-muted small">
                        Already have an account?
                        <a href="/customer-login" class="auth-link-login fw-bold ms-1">Sign In</a>
                    </p>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer text-center mt-4 animate__animated animate__fadeIn">
            <p class="text-muted extra-small uppercase-tracking">© @DateTime.Now.Year Hotel Booking System. All rights reserved.</p>
        </div>
    </div>
</div>

<style>
    /* --- INTEGRATED REGISTER STYLES --- */
    .auth-wrapper {
        min-height: 100vh; width: 100%;
        display: flex; justify-content: center; align-items: center;
        background: radial-gradient(circle at top left, #f0f9ff 0%, #e0f2fe 100%);
        padding: 3rem 1rem; position: relative;
    }

    .auth-container.wide { width: 100%; max-width: 800px; }

    .auth-card {
        background: var(--glass-bg-deep);
        backdrop-filter: var(--glass-blur) saturate(150%);
        -webkit-backdrop-filter: var(--glass-blur) saturate(150%);
        padding: 3.5rem 3rem;
        border-radius: 32px;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
    }

    /* Logo & Header */
    .auth-logo-wrap {
        display: inline-flex; align-items: center;
        text-decoration: none; color: var(--admin-blue);
        font-weight: 800; font-size: 1.4rem; font-family: 'DM Serif Display', serif;
    }
    .logo-img { height: 36px; }
    .uppercase-tracking { text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }

    /* Inputs */
    .glass-input-auth {
        background: #ffffff !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 16px !important;
        height: 60px !important;
        color: var(--text-dark) !important;
        font-weight: 600 !important;
    }
    .glass-input-auth:focus {
        border-color: var(--admin-blue) !important;
        box-shadow: 0 0 0 4px rgba(58, 123, 213, 0.1) !important;
    }

    /* Checkbox & Links */
    .custom-checkbox-glass .form-check-input:checked {
        background-color: var(--admin-blue); border-color: var(--admin-blue);
    }
    .auth-link-primary { color: var(--admin-blue); text-decoration: none; font-weight: 700; }
    .auth-link-login { color: var(--admin-blue); text-decoration: none; border-bottom: 2px solid transparent; transition: 0.2s; }
    .auth-link-login:hover { border-bottom-color: var(--admin-blue); }

    /* Action Button */
    .btn-auth-primary {
        background: var(--admin-primary-gradient);
        border: none; border-radius: 16px;
        font-weight: 800; font-size: 1.1rem; color: #fff;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .btn-auth-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 25px rgba(58, 123, 213, 0.35);
    }

    /* Glass Alerts */
    .glass-alert {
        padding: 14px 20px; border-radius: 16px; margin-bottom: 2rem;
        font-weight: 700; font-size: 0.9rem; border: 1px solid transparent;
    }
    .glass-alert.error { background: rgba(244, 63, 94, 0.1); color: var(--color-danger); border-color: rgba(244, 63, 94, 0.2); }
    .glass-alert.success { background: rgba(16, 185, 129, 0.1); color: var(--color-success); border-color: rgba(16, 185, 129, 0.2); }

    /* Validation & Utilities */
    .val-msg-custom { font-size: 0.7rem; font-weight: 700; color: var(--color-danger); margin-top: 4px; display: block; }
    .fw-600 { font-weight: 600; }
    .extra-small { font-size: 0.65rem; }

    @@media(max-width: 768px) {
        .auth-card { padding: 2.5rem 1.5rem; }
    }
</style>

@code {
    private UserRegisterVM userRegister = new UserRegisterVM();
    private string messageAlert = "";
    private bool isError = false;

    private async Task HandleValidSubmit()
    {
        if (!userRegister.AgreeTerm)
        {
            isError = true;
            messageAlert = "You must agree to the Terms and Conditions.";
            Snackbar.Add(messageAlert, Severity.Warning);
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("HotelBookingAPI");
            var response = await client.PostAsJsonAsync("v1/auth/register", new
            {
                Username = userRegister.Username,
                Email = userRegister.Email,
                Password = userRegister.Password,
                ConfirmPassword = userRegister.ConfirmPassword,
                FullName = userRegister.FullName,
                PhoneNumber = userRegister.PhoneNumber,
                ReceiveEmail = userRegister.ReceiveEmail
            });

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                messageAlert = "Account created successfully!";
                Snackbar.Add(messageAlert, Severity.Success);
                await Task.Delay(2000);
                _navManager.NavigateTo("/customer-login");
            }
            else
            {
                isError = true;
                var errorContent = await response.Content.ReadAsStringAsync();
                try {
                    var apiResp = JsonSerializer.Deserialize<ApiResponse<RegisterResponseVM>>(errorContent, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    messageAlert = apiResp?.Message ?? "Registration failed. Please check your data.";
                } catch { messageAlert = $"Error: {errorContent}"; }
                Snackbar.Add(messageAlert, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isError = true;
            messageAlert = $"A system error occurred: {ex.Message}";
            Snackbar.Add(messageAlert, Severity.Error);
        }
    }
}
