@page "/customer-register"
@layout AuthLayout

@* Add Service http client *@
@inject IHttpClientFactory HttpClientFactory;
@inject NavigationManager _navManager;
@inject MudBlazor.ISnackbar Snackbar;

@using System.Net.Http.Json
@using System.Text.Json
@using HotelBooking.webapp.ViewModels.Form
@using MudBlazor

<PageTitle>Create Account - Hotel Booking</PageTitle>

<div class="auth-wrapper">
    <div class="auth-container wide">
        <div class="auth-card">
            <div class="auth-header text-center">
                <a href="/" class="auth-logo">
                    <img src="favicon.ico" alt="Hotel Booking Logo" />
                    <span class="ms-2">Hotel Booking</span>
                </a>
                <h2 class="mt-4 fw-bold">Create Account</h2>
                <p class="text-muted">Join us to experience exclusive booking services</p>
            </div>

            <EditForm Model="@userRegister" OnValidSubmit="HandleValidSubmit" class="auth-form mt-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(messageAlert))
                {
                    <div class="alert @(isError ? "alert-danger" : "alert-success") custom-alert animate__animated animate__fadeIn"
                    role="alert">
                        <div class="alert-content">
                            @messageAlert
                        </div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Username" class="form-control auth-input" id="username"
                                placeholder="Enter username" />
                            <label for="username">Username</label>
                            <ValidationMessage For="@(() => userRegister.Username)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Email" type="email" class="form-control auth-input"
                                id="email" placeholder="name@domain.com" />
                            <label for="email">Email address</label>
                            <ValidationMessage For="@(() => userRegister.Email)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.FullName" class="form-control auth-input" id="fullname"
                                placeholder="John Doe" />
                            <label for="fullname">Full Name</label>
                            <ValidationMessage For="@(() => userRegister.FullName)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.PhoneNumber" class="form-control auth-input" id="phone"
                                placeholder="e.g., +84..." />
                            <label for="phone">Phone Number</label>
                            <ValidationMessage For="@(() => userRegister.PhoneNumber)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Password" type="password"
                                class="form-control auth-input" id="password" placeholder="••••••••" />
                            <label for="password">Password</label>
                            <ValidationMessage For="@(() => userRegister.Password)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.ConfirmPassword" type="password"
                                class="form-control auth-input" id="confirmPassword" placeholder="••••••••" />
                            <label for="confirmPassword">Confirm Password</label>
                            <ValidationMessage For="@(() => userRegister.ConfirmPassword)"
                                class="text-danger small mt-1" />
                        </div>
                    </div>
                </div>

                <div class="auth-options mt-4">
                    <div class="form-check custom-checkbox mb-2">
                        <InputCheckbox class="form-check-input" id="receiveEmail"
                            @bind-Value="userRegister.ReceiveEmail" />
                        <label class="form-check-label small text-muted" for="receiveEmail">
                            Yes, I want to receive exclusive offers and news
                        </label>
                    </div>

                    <div class="form-check custom-checkbox">
                        <InputCheckbox @bind-Value="userRegister.AgreeTerm" class="form-check-input" id="agreeTerm" />
                        <label class="form-check-label small text-muted" for="agreeTerm">
                            I agree to the <a href="/terms" class="auth-link">Terms & Conditions</a> and <a
                                href="/privacy" class="auth-link">Privacy Policy</a>.
                        </label>
                        <ValidationMessage For="@(() => userRegister.AgreeTerm)"
                            class="text-danger small d-block mt-1" />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 mb-3">
                    <button type="submit" class="btn btn-primary auth-btn btn-lg py-3">Sign Up</button>
                </div>

                <div class="text-center">
                    <p class="mb-0 text-muted small">
                        Already have an account?
                        <a href="/customer-login" class="auth-link fw-bold">Sign In</a>
                    </p>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer text-center mt-4">
            <p class="text-muted small">© @DateTime.Now.Year Hotel Booking. All rights reserved.</p>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #0060e6;
        --secondary-color: #00b4d8;
        --card-bg: rgba(255, 255, 255, 0.65);
        --text-main: #1e293b;
        --text-muted: #64748b;
        --input-bg: #ffffff;
        --input-border: #cbd5e1;
        --input-focus: #0060e6;
    }

    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f0f9ff;
        background-image:
            radial-gradient(at 0% 0%, hsla(190, 100%, 90%, 1) 0px, transparent 50%),
            radial-gradient(at 50% 0%, hsla(205, 100%, 85%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 0%, hsla(188, 100%, 92%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 100%, hsla(215, 100%, 88%, 1) 0px, transparent 50%),
            radial-gradient(at 0% 100%, hsla(195, 100%, 95%, 1) 0px, transparent 50%);
        background-size: 150% 150%;
        animation: gradientShift 20s ease infinite;
        padding: 3rem 1rem;
        position: relative;
        overflow: hidden;
    }

    .auth-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.5) 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.4) 0%, transparent 40%);
        pointer-events: none;
    }

    .auth-container {
        width: 100%;
        max-width: 500px;
        animation: fadeIn 0.6s ease-out;
        position: relative;
        z-index: 1;
    }

    .auth-container.wide {
        max-width: 800px;
    }

    .auth-card {
        background: var(--card-bg);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        padding: 3rem 2.5rem;
        border-radius: 28px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .auth-logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--primary-color);
        font-weight: 800;
        font-size: 1.25rem;
        font-family: 'DM Serif Display', serif;
    }

    .auth-logo img {
        height: 32px;
        width: 32px;
    }

    .auth-header h2 {
        color: var(--text-main);
        font-size: 2.2rem;
        font-family: 'DM Serif Display', serif;
        margin-bottom: 0.5rem;
    }

    .auth-header .text-muted {
        color: var(--text-muted) !important;
        font-size: 0.95rem;
    }

    .auth-input {
        background: var(--input-bg) !important;
        border: 1.5px solid var(--input-border) !important;
        border-radius: 14px;
        height: 58px;
        color: var(--text-main) !important;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .auth-input:focus {
        border-color: var(--input-focus) !important;
        box-shadow: 0 0 0 4px rgba(0, 96, 230, 0.1);
        outline: none;
    }

    .form-floating label {
        color: #94a3b8;
    }

    .auth-btn {
        background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
        border: none;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.15rem;
        color: #ffffff;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .auth-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(58, 123, 213, 0.3);
        filter: brightness(1.05);
        color: #ffffff;
    }

    .auth-link {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
    }

    .auth-link:hover {
        color: #3a7bd5;
        text-decoration: underline;
    }

    .custom-checkbox .form-check-input {
        border: 1.5px solid var(--input-border);
        cursor: pointer;
        background-color: #fff;
    }

    .custom-checkbox .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .custom-alert {
        border-radius: 14px;
        padding: 14px 18px;
        margin-bottom: 1.5rem;
        font-weight: 500;
        font-size: 0.95rem;
        border: none;
    }

    .custom-alert.alert-danger {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
    }

    .custom-alert.alert-success {
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        color: #15803d;
    }

    .auth-footer .text-muted {
        color: #94a3b8 !important;
    }

    @@keyframesgradientShift {
        0% {
            background-position: 0% 0%;
        }

        50% {
            background-position: 100% 100%;
        }

        100% {
            background-position: 0% 0%;
        }
    }

    @@keyframesfadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media(max-width: 768px) {
        .auth-card {
            padding: 2.5rem 1.5rem;
        }

        .auth-header h2 {
            font-size: 1.8rem;
        }
    }
</style>

@code {
    private UserRegisterVM userRegister = new UserRegisterVM();
    private string messageAlert = "";
    private bool isError = false;

    private async Task HandleValidSubmit()
    {
        if (!userRegister.AgreeTerm)
        {
            isError = true;
            messageAlert = "You must agree to the Terms and Conditions.";
            Snackbar.Add(messageAlert, Severity.Warning);
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("HotelBookingAPI");
            var response = await client.PostAsJsonAsync("v1/authentication/register", new
            {
                Username = userRegister.Username,
                Email = userRegister.Email,
                Password = userRegister.Password,
                FullName = userRegister.FullName,
                PhoneNumber = userRegister.PhoneNumber,
                ReceiveEmail = userRegister.ReceiveEmail
            });

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                messageAlert = "Account created successfully!";
                Snackbar.Add(messageAlert, Severity.Success);

                await Task.Delay(2000);
                _navManager.NavigateTo("/customer-login");
            }
            else
            {
                isError = true;
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var apiResp = JsonSerializer.Deserialize<ApiResponse<RegisterResponseVM>>(errorContent, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
                    messageAlert = apiResp?.Message ?? "Registration failed. Please check your data.";
                }
                catch
                {
                    messageAlert = $"Error: {errorContent}";
                }
                Snackbar.Add(messageAlert, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isError = true;
            messageAlert = $"A system error occurred: {ex.Message}";
            Snackbar.Add(messageAlert, Severity.Error);
        }
    }
}