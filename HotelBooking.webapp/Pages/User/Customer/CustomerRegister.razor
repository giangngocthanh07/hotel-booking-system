@page "/customer-register"
@layout AuthLayout

@* Add Service http client *@
@inject IHttpClientFactory HttpClientFactory;
@inject NavigationManager _navManager;
@inject MudBlazor.ISnackbar Snackbar;

@using System.Net.Http.Json
@using System.Text.Json
@using HotelBooking.webapp.ViewModels.Form
@using MudBlazor

<PageTitle>Create Account - Hotel Booking</PageTitle>

<div class="auth-wrapper">
    <div class="auth-container wide">
        <div class="auth-card">
            <div class="auth-header text-center">
                <a href="/" class="auth-logo">
                    <img src="favicon.ico" alt="Hotel Booking Logo" />
                    <span class="ms-2">Hotel Booking</span>
                </a>
                <h2 class="mt-4 fw-bold">Create Account</h2>
                <p class="text-muted">Join us to experience exclusive booking services</p>
            </div>

            <EditForm Model="@userRegister" OnValidSubmit="HandleValidSubmit" class="auth-form mt-2">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(messageAlert))
                {
                    <div class="alert @(isError ? "alert-danger" : "alert-success") custom-alert animate__animated animate__fadeIn"
                         role="alert">
                        <div class="alert-content">
                            @messageAlert
                        </div>
                    </div>
                }

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Username" class="form-control auth-input" id="username"
                                       placeholder="Enter username" />
                            <label for="username">Username</label>
                            <ValidationMessage For="@(() => userRegister.Username)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Email" type="email" class="form-control auth-input" id="email"
                                       placeholder="name@domain.com" />
                            <label for="email">Email address</label>
                            <ValidationMessage For="@(() => userRegister.Email)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.FullName" class="form-control auth-input" id="fullname"
                                       placeholder="John Doe" />
                            <label for="fullname">Full Name</label>
                            <ValidationMessage For="@(() => userRegister.FullName)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.PhoneNumber" class="form-control auth-input" id="phone"
                                       placeholder="e.g., +84..." />
                            <label for="phone">Phone Number</label>
                            <ValidationMessage For="@(() => userRegister.PhoneNumber)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.Password" type="password" class="form-control auth-input"
                                       id="password" placeholder="••••••••" />
                            <label for="password">Password</label>
                            <ValidationMessage For="@(() => userRegister.Password)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <InputText @bind-Value="userRegister.ConfirmPassword" type="password"
                                       class="form-control auth-input" id="confirmPassword" placeholder="••••••••" />
                            <label for="confirmPassword">Confirm Password</label>
                            <ValidationMessage For="@(() => userRegister.ConfirmPassword)"
                                               class="text-danger small mt-1" />
                        </div>
                    </div>
                </div>

                <div class="auth-options mt-4">
                    <div class="form-check custom-checkbox mb-2">
                        <InputCheckbox class="form-check-input" id="receiveEmail" @bind-Value="userRegister.ReceiveEmail" />
                        <label class="form-check-label small text-muted" for="receiveEmail">
                            Yes, I want to receive exclusive offers and news
                        </label>
                    </div>

                    <div class="form-check custom-checkbox">
                        <InputCheckbox @bind-Value="userRegister.AgreeTerm" class="form-check-input" id="agreeTerm" />
                        <label class="form-check-label small text-muted" for="agreeTerm">
                            I agree to the <a href="/terms" class="auth-link">Terms & Conditions</a> and <a
                            href="/privacy" class="auth-link">Privacy Policy</a>.
                        </label>
                        <ValidationMessage For="@(() => userRegister.AgreeTerm)" class="text-danger small d-block mt-1" />
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4 mb-3">
                    <button type="submit" class="btn btn-primary auth-btn btn-lg py-3">Sign Up</button>
                </div>

                <div class="text-center">
                    <p class="mb-0 text-muted small">
                        Already have an account? 
                        <a href="/customer-login" class="auth-link fw-bold">Sign In</a>
                    </p>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer text-center mt-4">
            <p class="text-muted small">© @DateTime.Now.Year Hotel Booking. All rights reserved.</p>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-color: #4facfe;
        --secondary-color: #00f2fe;
        --card-bg: rgba(255, 255, 255, 0.12);
        --text-main: #ffffff;
        --text-muted: #cbd5e1;
        --input-border: rgba(255, 255, 255, 0.25);
        --input-focus: #4facfe;
    }

    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(-45deg, #0f2027, #203a43, #2c5364, #4facfe);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
        padding: 3rem 1rem;
        position: relative;
    }

    .auth-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 50%, rgba(79, 172, 254, 0.15) 0%, transparent 50%),
                    radial-gradient(circle at 80% 20%, rgba(0, 242, 254, 0.1) 0%, transparent 50%);
        pointer-events: none;
    }

    .auth-container {
        width: 100%;
        max-width: 500px;
        animation: fadeIn 0.6s ease-out;
        position: relative;
        z-index: 1;
    }

    .auth-container.wide {
        max-width: 800px;
    }

    .auth-card {
        background: var(--card-bg);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        padding: 3rem 2.5rem;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .auth-logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: var(--text-main);
        font-weight: 800;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        font-family: 'DM Serif Display', serif;
    }

    .auth-logo img {
        height: 32px;
        width: 32px;
    }

    .auth-header h2 {
        color: var(--text-main);
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        font-family: 'DM Serif Display', serif;
    }

    .auth-header .text-muted {
        color: var(--text-muted) !important;
    }

    .auth-input {
        border: 1.5px solid var(--input-border);
        border-radius: 12px;
        height: 58px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
    }

    .auth-input:focus {
        border-color: var(--input-focus);
        box-shadow: 0 0 0 4px rgba(79, 172, 254, 0.2);
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    .form-floating label {
        color: var(--text-muted);
    }

    .auth-btn {
        background: linear-gradient(135deg, var(--primary-color) 0%, #00c6ff 100%);
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        color: #fff;
    }

    .auth-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.4);
        background: linear-gradient(135deg, #3fa1f7 0%, #00b8ef 100%);
    }

    .auth-link {
        color: var(--primary-color);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .auth-link:hover {
        color: #7dc4ff;
        text-decoration: underline;
    }

    .custom-checkbox .form-check-input {
        border-radius: 4px;
        border: 1.5px solid var(--input-border);
        cursor: pointer;
        background-color: rgba(255, 255, 255, 0.08);
    }

    .custom-checkbox .form-check-input:checked {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

    .form-check-label,
    .text-muted {
        color: var(--text-muted) !important;
    }

    .custom-alert {
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 1.5rem;
        font-weight: 500;
        font-size: 0.9rem;
        border: none;
    }

    .custom-alert.alert-danger {
        background: rgba(190, 18, 60, 0.2);
        border: 1px solid rgba(254, 205, 211, 0.3);
        color: #fca5a5;
    }

    .custom-alert.alert-success {
        background: rgba(22, 163, 74, 0.2);
        border: 1px solid rgba(134, 239, 172, 0.3);
        color: #86efac;
    }

    .auth-footer .text-muted {
        color: rgba(255, 255, 255, 0.4) !important;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .auth-card {
            padding: 2rem 1.5rem;
        }
        .auth-container.wide {
            max-width: 100%;
        }
    }
</style>

@code {
    private UserRegisterVM userRegister = new UserRegisterVM();
    private string messageAlert = "";
    private bool isError = false;

    private async Task HandleValidSubmit()
    {
        if (!userRegister.AgreeTerm)
        {
            isError = true;
            messageAlert = "You must agree to the Terms and Conditions.";
            Snackbar.Add(messageAlert, Severity.Warning);
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("HotelBookingAPI");
            var response = await client.PostAsJsonAsync("v1/authentication/register", new
            {
                Username = userRegister.Username,
                Email = userRegister.Email,
                Password = userRegister.Password,
                FullName = userRegister.FullName,
                PhoneNumber = userRegister.PhoneNumber,
                ReceiveEmail = userRegister.ReceiveEmail
            });

            if (response.IsSuccessStatusCode)
            {
                isError = false;
                messageAlert = "Account created successfully!";
                Snackbar.Add(messageAlert, Severity.Success);

                await Task.Delay(2000);
                _navManager.NavigateTo("/customer-login");
            }
            else
            {
                isError = true;
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var apiResp = JsonSerializer.Deserialize<ApiResponse<RegisterResponseVM>>(errorContent, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });
                    messageAlert = apiResp?.Message ?? "Registration failed. Please check your data.";
                }
                catch
                {
                    messageAlert = $"Error: {errorContent}";
                }
                Snackbar.Add(messageAlert, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            isError = true;
            messageAlert = $"A system error occurred: {ex.Message}";
            Snackbar.Add(messageAlert, Severity.Error);
        }
    }
}