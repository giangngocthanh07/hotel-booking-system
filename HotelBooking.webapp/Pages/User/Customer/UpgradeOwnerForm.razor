@page "/upgrade-owner"
@attribute [Authorize(Roles = "Customer")]
@layout AuthLayout
@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager NavigationManager

@using HotelBooking.webapp.Helpers.Common
@using MudBlazor
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Become a Partner - Hotel Booking</PageTitle>

<div class="auth-wrapper force-gpu">
    <div class="auth-container wide">
        @if (userInfo == null)
        {
            <div class="glass-loader-center p-5 text-center force-gpu">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-bold text-primary text-uppercase tracking-wider">Syncing Account Data...</div>
            </div>
        }
        else
        {
            <div class="auth-card shadow-lg force-gpu">
                @* --- Header Section --- *@
                <div class="text-center mb-5">
                    <a href="/" class="auth-logo-wrap mb-3">
                        <img src="favicon.ico" alt="Logo" class="logo-img" />
                        <span class="ms-2">Hotel Booking</span>
                    </a>
                    <h2 class="mt-4 fw-bold text-dark">Partner Registration</h2>
                    <p class="text-muted small uppercase-tracking">Upgrade your account to start business</p>
                </div>

                @* --- Request Status Banner (Glass Style) --- *@
                @if (requestStatus != "None")
                {
                    <div class="glass-status-banner @GetStatusTheme(requestStatus) mb-4 animate__animated animate__fadeIn">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <div class="status-icon-circle me-3">
                                    <i class="@GetStatusIcon(requestStatus)"></i>
                                </div>
                                <div>
                                    <div class="status-label">CURRENT APPLICATION STATUS</div>
                                    <div class="status-value">@requestStatus.ToUpper()</div>
                                </div>
                            </div>
                            @if (requestStatus == "Pending")
                            {
                                <span class="pulse-indicator"></span>
                            }
                        </div>
                    </div>
                }

                <p class="text-muted small mb-4 px-1 italic-info">
                    <i class="fas fa-info-circle me-1"></i> Please verify your profile info and provide business details
                    below.
                </p>

                <EditForm Model="@requestModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    @* Row 1: Account Information (Readonly) *@
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control glass-input-readonly" value="@userInfo.Content?.UserName"
                                readonly />
                                <label>Account Username</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control glass-input-readonly" value="@userInfo.Content?.FullName"
                                readonly />
                                <label>Full Name</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control glass-input-readonly" value="@userInfo.Content?.Email"
                                readonly />
                                <label>Email Contact</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input class="form-control glass-input-readonly" value="@userInfo.Content?.PhoneNumber"
                                readonly />
                                <label>Phone Number</label>
                            </div>
                        </div>
                    </div>

                    @* Row 2: Business Details (Editable) *@
                    <div class="row g-4">
                        <div class="col-md-8">
                            <div class="form-floating">
                                <InputText class="form-control glass-input-auth" @bind-Value="requestModel.Address"
                                readonly="@isFormReadOnly" placeholder="Address" />
                                <label>Registered Business Address</label>
                                <ValidationMessage For="@(() => requestModel.Address)" class="val-msg-custom" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <InputText class="form-control glass-input-auth" @bind-Value="requestModel.TaxCode"
                                readonly="@isFormReadOnly" placeholder="Tax Code" />
                                <label>Tax Identification (TIN)</label>
                                <ValidationMessage For="@(() => requestModel.TaxCode)" class="val-msg-custom" />
                            </div>
                        </div>
                    </div>

                    @* Action Button *@
                    <div class="mt-5">
                        <button type="submit" class="btn-auth-primary w-100 py-3 force-gpu" disabled="@isFormReadOnly">
                            @if (isFormReadOnly)
                            {
                                <i class="fas fa-lock me-2"></i>

                                <span>APPLICATION UNDER REVIEW</span>
                            }
                            else
                            {
                                <i class="fas fa-paper-plane me-2"></i>

                                <span>SUBMIT PARTNER REQUEST</span>
                            }
                        </button>

                        @if (requestStatus == "Pending")
                        {
                            <button type="button" class="btn-glass-cancel-danger w-100 py-3 mt-3 force-gpu"
                        @onclick="CancelMyRequest" disabled="@isProcessingCancel">
                                @if (isProcessingCancel)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle me-2"></i>
                                }
                                <span>CANCEL PENDING REQUEST</span>
                            </button>
                        }
                    </div>

                    @* Context Messages *@
                    <div class="mt-4">
                        @if (requestStatus == "Pending")
                        {
                            <div class="upgrade-helper-box info">
                                <i class="fas fa-clock me-2"></i>
                                Our admins are reviewing your business details. This usually takes 24-48h.
                            </div>
                        }
                        else if (requestStatus == "Rejected")
                        {
                            <div class="upgrade-helper-box danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Your previous request was rejected. Please update your TIN or Address and re-submit.
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
        }

        <div class="text-center mt-4">
            <a href="/" class="auth-link-back">
                <i class="fas fa-chevron-left me-2"></i>Return to Homepage
            </a>
        </div>
    </div>
</div>

<style>
    /* --- INTEGRATED UPGRADE FORM STYLES --- */
    .auth-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: radial-gradient(circle at top left, #f0f9ff 0%, #e0f2fe 100%);
        padding: 3rem 1rem;
        position: relative;
    }

    .auth-container.wide {
        width: 100%;
        max-width: 850px;
    }

    .auth-card {
        background: var(--glass-bg-deep);
        backdrop-filter: var(--glass-blur) saturate(150%);
        padding: 3.5rem 3rem;
        border-radius: 32px;
        border: 1px solid var(--glass-border);
        box-shadow: var(--glass-shadow);
    }

    /* Status Banners */
    .glass-status-banner {
        padding: 1.25rem 1.5rem;
        border-radius: 20px;
        border: 1px solid transparent;
    }

    .glass-status-banner.pending {
        background: #e0f2fe;
        border-color: #bae6fd;
        color: #0369a1;
    }

    .glass-status-banner.approved {
        background: #dcfce7;
        border-color: #bbf7d0;
        color: #15803d;
    }

    .glass-status-banner.rejected {
        background: #fee2e2;
        border-color: #fecaca;
        color: #991b1b;
    }

    .status-icon-circle {
        width: 42px;
        height: 42px;
        background: #fff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }

    .status-label {
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1px;
        opacity: 0.8;
    }

    .status-value {
        font-weight: 800;
        font-size: 1.1rem;
    }

    /* Form Elements Sync */
    .glass-input-auth {
        background: #ffffff !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 16px !important;
        height: 60px !important;
        color: var(--text-dark) !important;
        font-weight: 600 !important;
    }

    .glass-input-readonly {
        background: rgba(0, 0, 0, 0.03) !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 16px !important;
        height: 60px !important;
        color: var(--text-muted) !important;
        font-weight: 600 !important;
    }

    .btn-auth-primary {
        background: var(--admin-primary-gradient);
        border: none;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1rem;
        color: #fff;
        transition: 0.3s;
    }

    .btn-auth-primary:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(58, 123, 213, 0.3);
    }

    .btn-auth-primary:disabled {
        background: #cbd5e1;
        opacity: 0.8;
        cursor: not-allowed;
    }

    .upgrade-helper-box {
        padding: 1rem;
        border-radius: 14px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .upgrade-helper-box.info {
        background: rgba(14, 165, 233, 0.08);
        color: #0369a1;
    }

    .upgrade-helper-box.danger {
        background: rgba(244, 63, 94, 0.08);
        color: #991b1b;
    }

    .auth-link-back {
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 700;
        transition: 0.2s;
        font-size: 0.9rem;
    }

    .auth-link-back:hover {
        color: var(--admin-blue);
    }

    .pulse-indicator {
        width: 10px;
        height: 10px;
        background: #0ea5e9;
        border-radius: 50%;
        animation: pulse-blue 2s infinite;
    }

    .glass-status-banner.cancelled {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #475569;
    }

    .upgrade-helper-box.cancelled {
        background: rgba(100, 116, 139, 0.08);
        color: #475569;
    }

    /* CSS Cancel Request */
    .btn-glass-cancel-danger {
        background: transparent;
        border: 1.5px solid #fecaca;
        color: #ef4444;
        border-radius: 16px;
        font-weight: 800;
        font-size: 1rem;
        transition: 0.3s;
    }

    .btn-glass-cancel-danger:hover:not(:disabled) {
        background: #fef2f2;
        border-color: #ef4444;
        color: #dc2626;
    }

    .btn-glass-cancel-danger:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    @@keyframes pulse-blue {
        0% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.7);
        }

        70% {
            transform: scale(1);
            box-shadow: 0 0 0 10px rgba(14, 165, 233, 0);
        }

        100% {
            transform: scale(0.95);
            box-shadow: 0 0 0 0 rgba(14, 165, 233, 0);
        }
    }

    .val-msg-custom {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--color-danger);
        margin-top: 4px;
        display: block;
    }

    .uppercase-tracking {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .italic-info {
        font-style: italic;
    }
</style>

@code {
    private ApiResponse<UserForUpgradeVM?>? userInfo;
    private CreateUpgradeRequestVM requestModel = new();
    private string message = "";
    private string alertClass = "alert-success";
    private HttpClient? _httpClient;
    private string requestStatus = "None";
    private bool isFormReadOnly = false;
    private bool isProcessingCancel = false;
    private int pendingRequestId = 0;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer",
            token);

        try
        {
            userInfo = await _httpClient.GetFromJsonAsync<ApiResponse<UserForUpgradeVM?>>("v1/upgrade-requests/my-info");
            if (userInfo?.Content != null)
            {
                requestStatus = userInfo.Content.RequestStatus ?? RequestStatusConst.None;

                pendingRequestId = userInfo.Content.RequestId ?? 0;

                isFormReadOnly = requestStatus == RequestStatusConst.Pending || requestStatus == RequestStatusConst.Approved;
                if (requestStatus == RequestStatusConst.Approved) NavigationManager.NavigateTo("/owner-dashboard");
            }
        }
        catch (Exception ex) { message = $"Error: {ex.Message}"; }
    }

    private async Task HandleValidSubmit()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (_httpClient == null || string.IsNullOrEmpty(token)) return;

        try
        {
            var response = await _httpClient.PostAsJsonAsync("v1/upgrade-requests/create-request", requestModel);
            var apiResp = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();

            if (apiResp?.StatusCode == StatusCodeResponse.Success)
            {
                requestStatus = RequestStatusConst.Pending;
                isFormReadOnly = true;
                if (apiResp.Content != null)
                {
                    pendingRequestId = apiResp.Content.RequestId;
                }
                else
                {
                    await OnInitializedAsync();
                }
                Snackbar.Add(MessageResponse.RequestManagement.UpgradeRequest.REQUEST_CREATED_SUCCESS, Severity.Success);
            }
            else Snackbar.Add(apiResp?.Message ?? MessageResponse.Common.ERROR_IN_SERVER, Severity.Error);
        }
        catch (Exception) { Snackbar.Add(MessageResponse.Common.ERROR_IN_SERVER, Severity.Error); }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task CancelMyRequest()
    {
        if (isProcessingCancel || _httpClient == null) return;
        isProcessingCancel = true;
        StateHasChanged();

        try
        {

            var response = await _httpClient.PutAsync($"v1/upgrade-requests/{pendingRequestId}/cancel", null);

            if (response.IsSuccessStatusCode)
            {
                var apiResp = await response.Content.ReadFromJsonAsync<ApiResponse<bool>>();
                if (apiResp?.StatusCode == StatusCodeResponse.Success)
                {
                    requestStatus = "Cancelled";
                    isFormReadOnly = false;
                    Snackbar.Add("Request has been cancelled.", Severity.Info);
                }
                else
                {
                    Snackbar.Add(apiResp?.Message ?? "Failed to cancel request.", Severity.Error);
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Server error while cancelling.", Severity.Error);
        }
        finally
        {
            isProcessingCancel = false;
            StateHasChanged();
        }
    }

    private string GetStatusTheme(string status) => status switch
    {
        "Pending" => "pending",
        "Approved" => "approved",
        "Rejected" => "rejected",
        _ => ""
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Pending" => "fas fa-history",
        "Approved" => "fas fa-check-double",
        "Rejected" => "fas fa-times-circle",
        _ => "fas fa-info-circle"
    };
}