@page "/upgrade-owner"
@attribute [Authorize(Roles = "Customer")]
@layout AuthLayout
@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject MudBlazor.ISnackbar Snackbar
@inject NavigationManager NavigationManager

@using HotelBooking.webapp.Helpers.Common
@using MudBlazor
@using System.Net.Http.Json
@using System.Text.Json

<PageTitle>Become a Partner - Hotel Booking</PageTitle>

<div class="upgrade-wrapper">
    <div class="upgrade-container">
        @if (userInfo == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                <div class="spinner-border text-light me-2"></div>
                <span class="text-light">Loading account information...</span>
            </div>
        }
        else if (userInfo.Content == null)
        {
            <div class="upgrade-card">
                <div class="alert alert-danger shadow-sm">
                    <i class="fas fa-exclamation-circle me-2"></i>@userInfo.Message
                </div>
            </div>
        }
        else
        {
            <div class="upgrade-card">
                <div class="text-center mb-4">
                    <a href="/" class="upgrade-logo">
                        <img src="favicon.ico" alt="Hotel Booking Logo" />
                        <span class="ms-2">Hotel Booking</span>
                    </a>
                    <h2 class="mt-3 fw-bold">Register for Partner Account</h2>
                    <p class="upgrade-subtitle">Become a partner and start listing your services</p>
                </div>

                <p class="upgrade-desc mb-4">Please verify your account information and provide your business address
                    and tax code to submit your upgrade request.</p>

                @if (requestStatus != "None")
                {
                    <div class="alert @GetStatusAlertClass(requestStatus) d-flex align-items-center shadow-sm" role="alert">
                        <strong>Request Status:</strong>
                        <span class="badge @GetStatusBadgeClass(requestStatus) ms-2 px-3 py-2">@requestStatus</span>
                    </div>
                }

                <EditForm Model="@requestModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label">Username</label>
                            <input class="form-control upgrade-input-readonly" value="@userInfo.Content.UserName"
                            readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label">Full Name</label>
                            <input class="form-control upgrade-input-readonly" value="@userInfo.Content.FullName"
                            readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label">Email Address</label>
                            <input class="form-control upgrade-input-readonly" value="@userInfo.Content.Email" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label">Phone Number</label>
                            <input class="form-control upgrade-input-readonly" value="@userInfo.Content.PhoneNumber"
                            readonly />
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label-editable">Business Address</label>
                            <InputText class="form-control upgrade-input" @bind-Value="requestModel.Address"
                            readonly="@isFormReadOnly" placeholder="Enter your business address" />
                            <ValidationMessage For="@(() => requestModel.Address)" class="text-warning small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold upgrade-label-editable">Tax Code</label>
                            <InputText class="form-control upgrade-input" @bind-Value="requestModel.TaxCode"
                            readonly="@isFormReadOnly" placeholder="Enter your business tax code" />
                            <ValidationMessage For="@(() => requestModel.TaxCode)" class="text-warning small" />
                        </div>
                    </div>

                    <button type="submit" class="btn upgrade-btn w-100 mt-4 py-3 fw-bold" disabled="@isFormReadOnly">
                        Submit Upgrade Request
                    </button>

                    @if (requestStatus == "Pending")
                    {
                        <div class="upgrade-status-msg info mt-3">
                            <i class="fas fa-clock me-2"></i>Your request has been submitted and is awaiting admin approval.
                        </div>
                    }
                    else if (requestStatus == "Approved")
                    {
                        <div class="upgrade-status-msg success mt-3">
                            <i class="fas fa-check-circle me-2"></i>Congratulations! Your request has been approved. You are now
                            a partner.
                        </div>
                    }
                    else if (requestStatus == "Rejected")
                    {
                        <div class="upgrade-status-msg warning mt-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>Your request was rejected. Please review your
                            information and try again.
                        </div>
                    }
                </EditForm>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @alertClass mt-3 shadow-sm">@message</div>
                }
            </div>
        }

        <div class="text-center mt-4">
            <a href="/" class="upgrade-back-link">
                <i class="fas fa-arrow-left me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>

CSS
<style>
    .upgrade-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f0f9ff;
        background-image:
            radial-gradient(at 0% 0%, hsla(190, 100%, 90%, 1) 0px, transparent 50%),
            radial-gradient(at 50% 0%, hsla(205, 100%, 85%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 0%, hsla(188, 100%, 92%, 1) 0px, transparent 50%),
            radial-gradient(at 100% 100%, hsla(215, 100%, 88%, 1) 0px, transparent 50%),
            radial-gradient(at 0% 100%, hsla(195, 100%, 95%, 1) 0px, transparent 50%);
        background-size: 150% 150%;
        animation: upgradeGradientShift 20s ease infinite;
        padding: 3rem 1rem;
        position: relative;
        overflow: hidden;
    }

    .upgrade-wrapper::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.5) 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.4) 0%, transparent 40%);
        pointer-events: none;
    }

    .upgrade-container {
        width: 100%;
        max-width: 800px;
        animation: upgradeFadeIn 0.6s ease-out;
        position: relative;
        z-index: 1;
    }

    .upgrade-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        padding: 3rem 2.5rem;
        border-radius: 28px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .upgrade-logo {
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: #0060e6;
        font-weight: 800;
        font-size: 1.25rem;
        font-family: 'DM Serif Display', serif;
    }

    .upgrade-card h2 {
        color: #1e293b;
        font-family: 'DM Serif Display', serif;
        font-size: 2.2rem;
        margin-bottom: 0.5rem;
    }

    .upgrade-subtitle {
        color: #475569;
        font-weight: 500;
    }

    .upgrade-desc {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.6;
    }

    .upgrade-label {
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .upgrade-label-editable {
        color: #1e293b;
        font-weight: 600;
    }

    .upgrade-input-readonly {
        background: #f1f5f9 !important;
        border: 1px solid #e2e8f0 !important;
        color: #64748b !important;
        border-radius: 12px;
    }

    .upgrade-input {
        background: #ffffff !important;
        border: 1.5px solid #cbd5e1 !important;
        color: #1e293b !important;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .upgrade-input::placeholder {
        color: #94a3b8 !important;
    }

    .upgrade-input:focus {
        background: #ffffff !important;
        border-color: #0060e6 !important;
        box-shadow: 0 0 0 4px rgba(0, 96, 230, 0.1);
        outline: none;
    }

    .upgrade-btn {
        background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
        border: none;
        border-radius: 14px;
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .upgrade-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(58, 123, 213, 0.3);
        filter: brightness(1.05);
        color: #ffffff;
    }

    .upgrade-status-msg {
        padding: 14px 18px;
        border-radius: 14px;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .upgrade-status-msg.info {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .upgrade-status-msg.success {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .upgrade-status-msg.warning {
        background: #fef9c3;
        color: #a16207;
        border: 1px solid #fef08a;
    }

    .upgrade-back-link {
        color: #64748b;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
    }

    .upgrade-back-link:hover {
        color: #0060e6;
    }

    @@keyframes upgradeGradientShift {
        0% {
            background-position: 0% 0%;
        }

        50% {
            background-position: 100% 100%;
        }

        100% {
            background-position: 0% 0%;
        }
    }

    @@keyframes upgradeFadeIn {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .upgrade-card {
            padding: 2.5rem 1.5rem;
        }

        .upgrade-card h2 {
            font-size: 1.75rem;
        }
    }
</style>

@code {
    private ApiResponse<UserForUpgradeVM?>? userInfo;
    private CreateUpgradeRequestVM requestModel = new();
    private string message = "";
    private string alertClass = "alert-success";
    private HttpClient? _httpClient;
    private string requestStatus = "None";
    private bool isFormReadOnly = false;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("HotelBookingAPI");

        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
        {
            _httpClient.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        try
        {
            userInfo = await _httpClient.GetFromJsonAsync<ApiResponse<UserForUpgradeVM?>>("v1/upgrade-requests/my-info");

            if (userInfo?.Content != null)
            {
                requestStatus = userInfo.Content.RequestStatus ?? "None";
                isFormReadOnly = requestStatus == "Pending" || requestStatus == "Approved";

                if (requestStatus == "Approved")
                {
                    NavigationManager.NavigateTo("/owner-dashboard");
                }
            }
            else
            {
                message = userInfo?.Message ?? "Unable to load user information.";
                alertClass = "alert-danger";
                requestStatus = "None";
            }
        }
        catch (Exception ex)
        {
            message = $"Error loading profile data: {ex.Message}";
            alertClass = "alert-danger";
        }
    }

    private async Task HandleValidSubmit()
    {
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (string.IsNullOrEmpty(token))
        {
            message = "Authentication required. Please sign in.";
            alertClass = "alert-danger";
            Snackbar.Add(message, Severity.Error);
            return;
        }

        if (_httpClient == null)
        {
            message = "Critical error: HTTP client initialization failed.";
            alertClass = "alert-danger";
            Snackbar.Add(message, Severity.Error);
            return;
        }

        _httpClient.DefaultRequestHeaders.Authorization =
        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        try
        {
            var response = await _httpClient.PostAsJsonAsync("v1/upgrade-requests/create-request", requestModel);
            var content = await response.Content.ReadAsStringAsync();

            try
            {
                var apiResp = JsonSerializer.Deserialize<ApiResponse<bool>>(content, new JsonSerializerOptions
                { PropertyNameCaseInsensitive = true });

                if (apiResp?.StatusCode == StatusCodeResponse.Success)
                {
                    alertClass = "alert-success";
                    requestStatus = "Pending";
                    isFormReadOnly = true;
                    message = apiResp.Message ?? "Request submitted successfully. Please wait for admin approval.";
                    Snackbar.Add(message, Severity.Success);
                }
                else
                {
                    message = apiResp?.Message ?? "Failed to submit request.";
                    alertClass = "alert-danger";
                    Snackbar.Add(message, Severity.Error);
                }
            }
            catch
            {
                message = content ?? "Unexpected error occurred.";
                alertClass = "alert-danger";
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            message = $"System Error: {ex.Message}";
            alertClass = "alert-danger";
            Snackbar.Add(message, Severity.Error);
        }
    }

    private string GetStatusAlertClass(string status) => status switch
    {
        "Pending" => "alert-info",
        "Approved" => "alert-success",
        "Rejected" => "alert-warning",
        _ => "alert-secondary"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-info text-white",
        "Approved" => "bg-success text-white",
        "Rejected" => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };
}