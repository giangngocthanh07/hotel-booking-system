@typeparam TItem
@typeparam TModel where TModel : BaseCreateOrUpdateAdminVM
@using HotelBooking.webapp.ViewModels.Admin.Base

@* --- OUTER CONTAINER --- *@
<div class="container-fluid p-3 overflow-hidden-lg manage-layout-animate">
    <div class="row g-4">

        @* --- LEFT COLUMN: CONFIGURATION FORM --- *@
        <div class="col-12 col-lg-3 order-2 order-lg-1">
            <div class="glass-side-card h-100 force-gpu">
                <div class="glass-card-header-manage">
                    <h6 class="m-0 fw-bold"><i class="bi bi-sliders me-2"></i>Configuration</h6>
                    @if (IsEditMode)
                    {
                        <span class="badge-editing">EDIT MODE</span>
                    }
                </div>

                <div class="glass-card-body-manage custom-scroll">
                    @* Module Navigation *@
                    <div class="mb-4">@SidebarTopContent</div>

                    @* Data Entry Form *@
                    <div class="mt-auto pt-4 border-top-glass">
                        <h6 class="form-title @(IsEditMode ? "edit" : "add")">
                            @(IsEditMode ? "UPDATE INFORMATION" : "CREATE NEW ENTRY")
                        </h6>

                        <EditForm Model="@Model" OnSubmit="HandleSubmit" @ref="_internalForm">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label class="custom-form-label">Display Name</label>
                                <input type="text" class="form-control glass-input-manage" value="@Model.Name"
                                       @oninput="@(e => HandleCommonChange(e.Value?.ToString(), "Name"))"
                                       @onblur="HandleNameBlur" placeholder="e.g. Premium Service" />
                                <ValidationMessage For="() => Model.Name" class="val-msg-custom" />
                            </div>

                            <div class="mb-4">
                                <label class="custom-form-label">Description</label>
                                <textarea class="form-control glass-input-manage" rows="4" value="@Model.Description"
                                          @oninput="@(e => HandleCommonChange(e.Value?.ToString(), "Description"))"
                                          placeholder="Enter details..."></textarea>
                                <ValidationMessage For="() => Model.Description" class="val-msg-custom" />
                            </div>

                            @if (FormContent != null)
                            {
                                @FormContent(Model)
                            }

                            <div class="d-grid gap-3 mt-4">
                                <button type="submit" class="btn-save-manage @(IsEditMode ? "warning" : "primary")">
                                    <i class="bi bi-check-lg me-2"></i>Save Changes
                                </button>
                                @if (IsEditMode)
                                {
                                    <button type="button" class="btn-cancel-manage" @onclick="CancelEdit">Cancel</button>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>

        @* --- RIGHT COLUMN: DATA LISTING --- *@
        <div class="col-12 col-lg-9 order-1 order-lg-2">
            <div class="glass-main-card h-100 d-flex flex-column force-gpu">
                <div class="glass-main-header d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold">Data Management List</h5>
                    <div class="items-counter">
                        Showing <strong>@Items?.Count</strong> / @TotalCount items
                    </div>
                </div>

                <div class="glass-main-body p-0 flex-grow-1">
                    @if (Items == null)
                    {
                        <div class="p-5 text-center">
                            <div class="spinner-grow text-primary"></div>
                        </div>
                    }
                    else if (!Items.Any())
                    {
                        <div class="p-5 text-center text-muted"><i class="bi bi-inbox fa-3x d-block mb-3 opacity-25"></i>No
                            entries found.</div>
                        }
                    else
                        {
                            <div class="table-responsive h-100 custom-scroll px-2">
                                <table class="table table-hover align-middle mb-0 glass-table">
                                    <thead>
                                        <tr>
                                            @TableHeader
                                            <th class="text-center sticky-action-head">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Items)
                                        {
                                            <tr class="glass-tr">
                                                @RowTemplate(item)
                                                <td class="text-center sticky-action-col">
                                                    <div class="d-flex justify-content-center gap-2">
                                                        <button class="btn-action edit" @onclick="() => EditItem(item)"><i
                                                            class="bi bi-pencil-fill"></i></button>
                                                            <button class="btn-action delete" @onclick="() => RequestDelete(item)"><i
                                                                class="bi bi-trash-fill"></i></button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            @if (TotalPages > 1)
                            {
                                <div class="glass-main-footer py-3 border-top-glass">
                                    <Pagination CurrentPage="PageIndex" TotalPages="TotalPages" TotalCount="TotalCount"
                                                OnPageChange="HandlePageChange" ShowInfo="false" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <style>
                /* --- THEME VARIABLES --- */
                :root {
                    --glass-bg: rgba(255, 255, 255, 0.65);
                    --glass-border: rgba(255, 255, 255, 0.8);
                    --glass-header: rgba(255, 255, 255, 0.35);
                    --text-dark: #1e293b;
                    --text-muted: #64748b;
                    --primary-gradient: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
                }

                .manage-layout-animate {
                    animation: fadeIn 0.6s ease;
                }

                /* --- HARDWARE ACCELERATION (Fixes FullPage Screenshot white gaps) --- */
                .force-gpu {
                    transform: translateZ(0);
                    -webkit-backface-visibility: hidden;
                    backface-visibility: hidden;
                }

                /* --- GLASS CARDS --- */
                .glass-side-card,
                .glass-main-card {
                    background: var(--glass-bg);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border: 1px solid var(--glass-border);
                    border-radius: 24px;
                    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
                    overflow: hidden;
                }

                .glass-card-header-manage,
                .glass-main-header {
                    padding: 1.25rem 1.5rem;
                    background: var(--glass-header);
                    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
                }

                .glass-card-body-manage {
                    padding: 1.5rem;
                    height: calc(100vh - 220px);
                    /* Adjust based on your top nav height */
                    overflow-y: auto;
                }

                /* --- FORM STYLING --- */
                .custom-form-label {
                    font-size: 0.75rem;
                    font-weight: 800;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    margin-bottom: 6px;
                    display: block;
                }

                .glass-input-manage {
                    background: #fff !important;
                    border: 1.5px solid #e2e8f0 !important;
                    border-radius: 12px;
                    padding: 0.7rem;
                    color: var(--text-dark) !important;
                    font-weight: 500;
                    transition: border-color 0.2s;
                }

                .glass-input-manage:focus {
                    border-color: #0060e6 !important;
                    outline: none;
                }

                .form-title {
                    font-size: 0.85rem;
                    font-weight: 800;
                    margin-bottom: 1.5rem;
                    letter-spacing: 0.5px;
                }

                .form-title.add {
                    color: #0060e6;
                }

                .form-title.edit {
                    color: #d97706;
                }

                /* --- TABLE ALIGNMENT FIXES --- */
                .glass-table {
                    table-layout: auto;
                    width: 100%;
                }

                .glass-table thead th {
                    background: rgba(0, 0, 0, 0.02);
                    color: var(--text-muted) !important;
                    font-size: 0.7rem;
                    font-weight: 800;
                    text-transform: uppercase;
                    padding: 1rem;
                    border: none;
                }

                .glass-tr {
                    transition: 0.2s;
                    border-bottom: 1px solid rgba(0, 0, 0, 0.02);
                }

                .glass-tr td {
                    padding: 1.25rem 0.75rem;
                }

                .sticky-action-head,
                .sticky-action-col {
                    position: sticky;
                    right: 0;
                    background: rgba(255, 255, 255, 0.95) !important;
                    backdrop-filter: blur(10px);
                    z-index: 5;
                    border-left: 1px solid rgba(0, 0, 0, 0.03) !important;
                }

                /* --- BUTTONS & BADGES --- */
                .btn-save-manage {
                    border: none;
                    padding: 12px;
                    border-radius: 14px;
                    font-weight: 700;
                    color: #fff;
                    transition: 0.3s;
                }

                .btn-save-manage.primary {
                    background: var(--primary-gradient);
                    box-shadow: 0 4px 15px rgba(58, 123, 213, 0.2);
                }

                .btn-save-manage.warning {
                    background: #d97706;
                }

                .btn-action {
                    width: 36px;
                    height: 36px;
                    border-radius: 10px;
                    border: none;
                    color: #fff;
                    transition: 0.2s;
                }

                .btn-action.edit {
                    background: #0ea5e9;
                }

                .btn-action.delete {
                    background: #f43f5e;
                }

                .items-counter {
                    font-size: 0.75rem;
                    color: var(--text-muted);
                }

                .badge-editing {
                    background: #fef3c7;
                    color: #92400e;
                    padding: 4px 10px;
                    border-radius: 8px;
                    font-size: 0.7rem;
                    font-weight: 800;
                }

                /* --- RESPONSIVE ADJUSTMENTS --- */
                @@media (min-width: 992px) {
                    .overflow-hidden-lg {
                        overflow: hidden !important;
                    }

                    .table-responsive {
                        height: calc(100vh - 280px) !important;
                    }
                }
            </style>

<ConfirmModal @ref="_confirmModal" Title="Delete Record?"
              Message="Are you sure you want to permanently delete this entry?" OnConfirm="ConfirmDelete" />

@code {
    // --- DATA PROPERTIES ---
    [Parameter] public List<TItem>? Items { get; set; }
    [Parameter] public TModel Model { get; set; } = default!;

    // --- UI RENDER FRAGMENTS ---
    [Parameter] public RenderFragment SidebarTopContent { get; set; } = default!;
    [Parameter] public RenderFragment<TModel> FormContent { get; set; } = default!;
    [Parameter] public RenderFragment TableHeader { get; set; } = default!;
    [Parameter] public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    // --- PAGINATION PROPERTIES ---
    [Parameter] public int PageIndex { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 0;
    [Parameter] public int TotalCount { get; set; } = 0;

    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    // --- EVENT CALLBACKS ---
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
    [Parameter] public EventCallback OnNameBlur { get; set; }

    // --- LOGIC PROPERTIES ---
    [Parameter] public bool IsEditMode { get; set; }

    // Delete Confirmation Logic
    private ConfirmModal? _confirmModal;
    private TItem _itemToDelete = default!;

    private EditForm? _internalForm;

    // Triggers full model validation based on DataAnnotations
    public void TriggerValidate()
    {
        _internalForm?.EditContext?.Validate();
    }

    // Centralized state handling for common form fields
    private void HandleCommonChange(string? val, string prop)
    {
        if (prop == "Name") Model.Name = val ?? "";
        else if (prop == "Description") Model.Description = val;

        // Trigger real-time validation feedback
        _internalForm?.EditContext?.Validate();
    }

    private async Task HandleNameBlur()
    {
        await OnNameBlur.InvokeAsync();
    }

    private async Task HandlePageChange(int newPage)
    {
        // Guard clause: prevent invalid page navigation
        if (newPage < 1 || newPage > TotalPages || newPage == PageIndex) return;

        await OnPageChanged.InvokeAsync(newPage);
    }

    private async Task EditItem(TItem item)
    {
        await OnEdit.InvokeAsync(item);
    }

    private async Task CancelEdit()
    {
        await OnCancel.InvokeAsync();
    }

    private void RequestDelete(TItem item)
    {
        _itemToDelete = item;
        _confirmModal?.Show();
    }

    private async Task ConfirmDelete()
    {
        await OnDelete.InvokeAsync(_itemToDelete);
        _itemToDelete = default!;
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }
}