@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITION --- *@
@page "/admin/manage/bedtype"

@* --- 2. LAYOUT CONFIGURATION --- *@
@layout AdminLayout
@inject ILogger<BedTypeManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI LOADING STATE --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-grow text-primary me-2"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_DATA</span>
    </div>
}
else
{
    <MasterDetailLayout @ref="_layoutRef" TItem="BedTypeVM" TModel="BaseCreateOrUpdateAdminVM" Items="_items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="_totalPages" TotalCount="_totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="BedType" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            @{
                double? currentCapacity = _isUpdate ? _updateModel.DefaultCapacity : _createModel.DefaultCapacity;
                bool isVarying = _isUpdate ? _updateModel.IsVaryingSize : _createModel.IsVaryingSize;

                RenderFragment RenderVal(string prop) => __builder =>
                {
                    if (prop == "Capacity")
                    {
                        if (_isUpdate)
                        {
                            <ValidationMessage For="() => _updateModel.DefaultCapacity" class="val-msg-custom" />
                        }
                        else
                        {
                            <ValidationMessage For="() => _createModel.DefaultCapacity" class="val-msg-custom" />
                        }
                    }
                    else if (prop == "Width")
                    {
                        if (_isUpdate)
                        {
                            <ValidationMessage For="() => _updateModel.MinWidth" class="val-msg-custom" />
                        }
                        else
                        {
                            <ValidationMessage For="() => _createModel.MinWidth" class="val-msg-custom" />
                        }
                    }
                };
            }

            @* --- 1. CAPACITY SETTINGS --- *@
            <div class="glass-field-group mb-4 animate__animated animate__fadeIn">
                <label class="glass-label-bold">Default Occupancy</label>
                <div class="input-group glass-input-group-manage shadow-sm">
                    <span class="input-group-text border-0 bg-transparent text-primary">
                        <i class="fa-solid fa-users-viewfinder"></i>
                    </span>
                    <input type="number" class="form-control glass-input-inner fw-bold text-end" min="1"
                           value="@currentCapacity" @oninput="@(e => HandleNumericInput(e.Value?.ToString(), "Capacity"))" />
                    <span class="input-group-text border-0 bg-light-glass fw-bold small">Pers.</span>
                </div>
                @RenderVal("Capacity")
                <div class="helper-text-glass">Standard maximum guests for this bed type.</div>
            </div>

            @* --- 2. DIMENSION SETTINGS --- *@
            <div class="dimension-glass-card shadow-sm force-gpu">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <label class="glass-label-bold m-0 text-primary">Dimensions</label>
                    <div class="form-check form-switch custom-switch">
                        <input type="checkbox" class="form-check-input glass-switch" role="switch" id="swVarying"
                               checked="@isVarying" @onchange="@(e => HandleToggleVarying((bool)(e.Value ?? false)))" />
                    </div>
                </div>

                <div class="dimension-status-pill mb-3 @(isVarying ? "warning" : "info")">
                    <i class="fa-solid @(isVarying ? "fa-arrows-left-right" : "fa-lock") me-2"></i>
                    @(isVarying ? "Variable Dimensions" : "Fixed Standard Size")
                </div>

                @if (!isVarying)
                {
                    <div class="dimension-inputs-row animate__animated animate__slideInDown">
                        <label class="extra-small-label">Width (Inches)</label>
                        <div class="d-flex align-items-center gap-2">
                            @if (_isUpdate)
                            {
                                <InputNumber class="form-control glass-input-sm" @bind-Value="_updateModel.MinWidth" />
                                <span class="text-muted">→</span>
                                <InputNumber class="form-control glass-input-sm" @bind-Value="_updateModel.MaxWidth" />
                            }
                            else
                            {
                                <input type="number" class="form-control glass-input-sm" value="@(_createModel.MinWidth)"
                                       @oninput="@(e => HandleNumericInput(e.Value?.ToString(), "Min"))" />
                                <span class="text-muted">→</span>
                                <input type="number" class="form-control glass-input-sm" value="@(_createModel.MaxWidth)"
                                       @oninput="@(e => HandleNumericInput(e.Value?.ToString(), "Max"))" />
                            }
                        </div>
                        @RenderVal("Width")
                    </div>
                }
            </div>
        </FormContent>

        <TableHeader>
            <th class="text-center" style="width: 60px;">ID</th>
            <th class="text-start px-3" style="width: 200px;">Bed Type Name</th>
            <th class="text-center" style="width: 140px;">Capacity</th>
            <th class="text-center" style="width: 220px;">Dimensions (In)</th>
            <th class="text-start px-3">Description</th>
        </TableHeader>

        <RowTemplate Context="row">
            <td class="text-center fw-bold text-muted small">#@row.Id</td>
            <td class="text-start align-middle px-3">
                <div class="fw-bold text-dark fs-6">@row.Name</div>
            </td>

            <td class="text-center align-middle">
                <span class="capacity-pill-solid force-gpu">
                    <i class="fa-solid fa-user-check me-2"></i>@row.DefaultCapacity
                </span>
            </td>

            <td class="text-center align-middle">
                @if (row.IsVaryingSize)
                {
                    <span class="badge-varying">Varying Size</span>
                }
                else
                {
                    <div class="dimension-pill-outline shadow-none">
                        <i class="fa-solid fa-ruler-combined me-2"></i>@row.MinWidth - @row.MaxWidth
                    </div>
                }
            </td>

            <td class="text-start align-middle px-3">
                <div class="text-muted small text-truncate-custom" title="@row.Description">
                    @(string.IsNullOrWhiteSpace(row.Description) ? "---" : row.Description)
                </div>
            </td>
        </RowTemplate>
    </MasterDetailLayout>
}

<style>
    /* --- THEMED UI COMPONENTS --- */
    .glass-loader-container {
        padding: 5rem;
        text-align: center;
        background: var(--glass-bg);
        border-radius: 24px;
    }

    .glass-label-bold {
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
        margin-bottom: 10px;
        color: var(--text-dark);
    }

    .extra-small-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 5px;
        display: block;
    }

    .glass-input-group-manage {
        background: #fff;
        border: 1.5px solid #cbd5e1;
        border-radius: 12px;
        overflow: hidden;
    }

    .glass-input-inner {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
    }

    .bg-light-glass {
        background: rgba(0, 0, 0, 0.03);
        border-left: 1px solid #e2e8f0 !important;
    }

    .helper-text-glass {
        font-size: 0.65rem;
        color: var(--text-muted);
        margin-top: 5px;
        font-style: italic;
    }

    /* Dimension Settings Card */
    .dimension-glass-card {
        background: var(--glass-bg-deep);
        border: 1px solid var(--glass-border);
        border-radius: 18px;
        padding: 1.25rem;
    }

    .dimension-status-pill {
        padding: 6px;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 800;
        text-align: center;
        text-transform: uppercase;
    }

    .dimension-status-pill.info {
        background: #e0f2fe;
        color: #0369a1;
        border: 1px solid #bae6fd;
    }

    .dimension-status-pill.warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .glass-input-sm {
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        text-align: center;
        font-weight: 700;
        color: var(--admin-blue);
        padding: 4px;
    }

    /* Table Visual Elements */
    .capacity-pill-solid {
        background: #e0f2fe;
        color: var(--admin-blue);
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(58, 123, 213, 0.2);
    }

    .dimension-pill-outline {
        background: #fff;
        color: var(--text-muted);
        border: 1.5px solid #e2e8f0;
        padding: 5px 12px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
    }

    .badge-varying {
        background: #f8fafc;
        color: #94a3b8;
        border: 1px solid #e2e8f0;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .text-truncate-custom {
        max-width: 350px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .val-msg-custom {
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--color-danger);
        margin-top: 4px;
        display: block;
    }

    .glass-table td {
        padding-top: 1.25rem !important;
        padding-bottom: 1.25rem !important;
    }
</style>

@code {
    // --- URL PARAMETERS ---
    [Parameter] public int? TypeId { get; set; }

    // --- STATE MANAGEMENT ---
    private List<BedTypeVM>? _items;
    private BedTypeCreateVM _createModel = new BedTypeCreateVM();
    private BedTypeUpdateVM _updateModel = new BedTypeUpdateVM();

    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    // --- PAGINATION ---
    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int _totalPages = 0;
    private int _totalCount = 0;

    private bool _isFirstLoad = true;

    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? _updateModel : _createModel;

    private MasterDetailLayout<BedTypeVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    // --- NUMERIC INPUT HANDLING (REACTIVE) ---
    private void HandleNumericInput(string? val, string field)
    {
        double.TryParse(val, out var num);

        if (_isUpdate)
        {
            if (field == "Capacity") _updateModel.DefaultCapacity = (int)num;
            else if (field == "Min") _updateModel.MinWidth = num;
            else if (field == "Max") _updateModel.MaxWidth = num;
        }
        else
        {
            if (field == "Capacity") _createModel.DefaultCapacity = (int)num;
            else if (field == "Min") _createModel.MinWidth = num;
            else if (field == "Max") _createModel.MaxWidth = num;
        }

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandleToggleVarying(bool val)
    {
        if (_isUpdate)
        {
            _updateModel.IsVaryingSize = val;
            // Inject standard size (Twin bed) if toggled off and currently zero
            if (!val && _updateModel.MinWidth <= 0) { _updateModel.MinWidth = 38; _updateModel.MaxWidth = 75; }
        }
        else
        {
            _createModel.IsVaryingSize = val;
            if (!val && _createModel.MinWidth <= 0) { _createModel.MinWidth = 38; _createModel.MaxWidth = 75; }
        }

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    // --- 1. LOAD DATA ---
    protected override async Task LoadDataAsync()
    {
        _items = null;
        StateHasChanged();

        try
        {
            var res = await Service.GetBedTypes(_paging);

            if (!Disposed)
            {
                if (res.StatusCode == StatusCodeResponse.Success && res.Content != null)
                {
                    _items = res.Content.Items;
                    _totalPages = res.Content.TotalPages;
                    _totalCount = res.Content.TotalCount;
                }
                else
                {
                    _items = new List<BedTypeVM>();
                    if (res.StatusCode != StatusCodeResponse.Success)
                    {
                        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading bed type data");
            _items = new List<BedTypeVM>();
        }
    }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    // --- 2. PARAMETERS HANDLING ---
    protected override async Task OnParametersSetAsync()
    {
        if (_isFirstLoad && IsJsReady)
        {
            _isFirstLoad = false;
            ResetForm();
            await LoadDataAsync();
        }
    }

    // --- PAGINATION HANDLING ---
    private async Task HandlePageChanged(int newPage)
    {
        _paging.PageIndex = newPage;
        await LoadDataAsync();
    }

    // --- CRUD METHODS ---
    private void OnEditItem(BedTypeVM item)
    {
        _isUpdate = true;
        _currentEditingId = item.Id;

        var updateModel = RoomAttributeHelper.MapToUpdateVM(item);

        if (updateModel is BedTypeUpdateVM mapped)
        {
            _updateModel = mapped;
        }

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task HandleDelete(BedTypeVM item)
    {
        var res = await Service.DeleteBedType(item.Id);
        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            await LoadDataAsync();
        }
    }

    private void ResetForm()
    {
        _isUpdate = false;
        _currentEditingId = 0;

        if (RoomAttributeHelper.CreateNewCreateModel(RoomAttributeType.BedType) is BedTypeCreateVM newModel)
        {
            _createModel = newModel;
        }

        _updateModel = new BedTypeUpdateVM();

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task SaveData()
    {
        ApiResponse<BedTypeVM> res;

        if (_isUpdate)
        {
            res = await Service.UpdateBedType(_currentEditingId, _updateModel);
        }
        else
        {
            res = await Service.CreateBedType(_createModel);
        }

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
            await LoadDataAsync();
            ResetForm();
        }
        else
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
        }
    }
}