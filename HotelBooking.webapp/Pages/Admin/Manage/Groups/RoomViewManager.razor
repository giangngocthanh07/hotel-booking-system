@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Helpers.Manage.Icon
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Helpers
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITION --- *@
@page "/admin/manage/roomview"

@* --- 2. LAYOUT CONFIGURATION --- *@
@layout AdminLayout
@inject ILogger<RoomViewManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI LOADING STATE (Controlled by Base Class) --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_DATA</span>
    </div>
}
else
{
    <MasterDetailLayout @ref="_layoutRef" TItem="RoomViewVM" TModel="BaseCreateOrUpdateAdminVM" Items="_items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="_totalPages" TotalCount="_totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="RoomView" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            @{
                string currentName = _isUpdate ? _updateModel.Name : _createModel.Name;
            }
            @if (!string.IsNullOrEmpty(currentName))
            {
                @* --- 1. ICON PREVIEW (Linked to Sky variables) --- *@
                <div class="view-preview-card animate__animated animate__fadeIn force-gpu">
                    <div class="preview-icon-wrap shadow-sm">
                        <i class="@GetViewIcon(currentName)"></i>
                    </div>
                    <div class="preview-text">
                        <label class="extra-small-label">Visual Perspective</label>
                        <div class="view-title">@currentName</div>
                    </div>
                    <div class="glass-shine"></div>
                </div>

                @* --- 2. STATUS INFO (Sky Style) --- *@
                <div class="view-status-box mt-3 force-gpu">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-mountain-sun me-2 text-info pulse-slow"></i>
                        <span class="small fw-bold text-info">Global room views are available for all properties.</span>
                    </div>
                </div>
            }
        </FormContent>

        <TableHeader>
            <th class="text-center" style="width: 60px;">ID</th>
            <th class="text-center" style="width: 80px;">Icon</th>
            <th class="text-start px-3" style="width: 300px;">View Perspective</th>
            <th class="text-start px-3">Description / Details</th>
            <th class="text-center" style="width: 120px;">Status</th>
        </TableHeader>

        <RowTemplate Context="row">
            <td class="text-center fw-bold text-muted small">#@row.Id</td>

            <td class="text-center">
                <div class="view-icon-circle shadow-sm force-gpu">
                    <i class="@GetViewIcon(row.Name)"></i>
                </div>
            </td>

            <td class="text-start align-middle px-3">
                <div class="fw-bold text-dark fs-6">@row.Name</div>
                <small class="text-muted extra-small">ID: RQ-@row.Id</small>
            </td>

            <td class="text-start align-middle px-3">
                @if (string.IsNullOrWhiteSpace(row.Description))
                {
                    <span class="text-muted opacity-30 small italic">--- No remarks ---</span>
                }
                else
                {
                    <div class="text-muted small text-truncate-custom" title="@row.Description">
                        @row.Description
                    </div>
                }
            </td>

            <td class="text-center">
                <span class="view-badge-active force-gpu">
                    <span class="active-dot me-2"></span> Active
                </span>
            </td>
        </RowTemplate>
    </MasterDetailLayout>
}

<style>
    /* --- CSS LINKED TO site.css VARIABLES --- */
    .glass-loader-container {
        padding: 5rem;
        text-align: center;
        background: var(--glass-bg);
        border-radius: 24px;
    }

    /* Icon Preview Card (Sky Blue Theme) */
    .view-preview-card {
        background: var(--glass-bg-deep);
        border: 1px solid #bae6fd;
        /* Light Blue Border */
        border-radius: 20px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 15px;
        position: relative;
        overflow: hidden;
    }

    .preview-icon-wrap {
        width: 50px;
        height: 50px;
        background: #f0f9ff;
        color: var(--color-info);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        border: 1px solid rgba(14, 165, 233, 0.2);
    }

    .extra-small-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        margin: 0;
    }

    .view-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: #0c4a6e;
    }

    .view-status-box {
        background: rgba(14, 165, 233, 0.08);
        border: 1px solid rgba(14, 165, 233, 0.2);
        padding: 10px 15px;
        border-radius: 12px;
    }

    /* Table Visual Polish */
    .view-icon-circle {
        width: 38px;
        height: 38px;
        background: #fff;
        border: 1px solid #e2e8f0;
        color: var(--color-info);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .view-badge-active {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        padding: 4px 14px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
    }

    .active-dot {
        width: 6px;
        height: 6px;
        background: var(--color-success);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--color-success);
    }

    .text-truncate-custom {
        max-width: 400px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pulse-slow {
        animation: pulseIcon 3s infinite ease-in-out;
    }

    @@keyframes pulseIcon {

        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }

    .glass-table td {
        padding-top: 1.25rem !important;
        padding-bottom: 1.25rem !important;
    }
</style>

@code {
    // --- URL PARAMETERS ---
    [Parameter] public int? TypeId { get; set; }

    // --- STATE MANAGEMENT ---
    private List<RoomViewVM>? _items;
    private RoomViewCreateVM _createModel = new RoomViewCreateVM();
    private RoomViewUpdateVM _updateModel = new RoomViewUpdateVM();

    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    // --- PAGINATION ---
    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int _totalPages = 0;
    private int _totalCount = 0;

    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? (BaseCreateOrUpdateAdminVM)_updateModel :
    (BaseCreateOrUpdateAdminVM)_createModel;

    private MasterDetailLayout<RoomViewVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    // --- HELPER: Resolve icon based on name ---
    private string GetViewIcon(string? name) => RoomViewIconHelper.GetIcon(name);

    // --- LIFECYCLE ---
    protected override async Task LoadDataAsync()
    {
        _items = null;
        StateHasChanged();

        try
        {
            var res = await Service.GetRoomViews(_paging);

            if (!Disposed)
            {
                if (res.StatusCode == StatusCodeResponse.Success && res.Content != null)
                {
                    _items = res.Content.Items;
                    _totalPages = res.Content.TotalPages;
                    _totalCount = res.Content.TotalCount;
                }
                else
                {
                    _items = new List<RoomViewVM>();
                    if (res.StatusCode != StatusCodeResponse.Success)
                    {
                        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading room view data");
            _items = new List<RoomViewVM>();
        }
    }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    // --- PARAMETERS HANDLING ---
    protected override async Task OnParametersSetAsync()
    {
        ResetForm();
        if (IsJsReady)
        {
            await LoadDataAsync();
        }
    }

    // --- PAGINATION HANDLING ---
    private async Task HandlePageChanged(int newPage)
    {
        _paging.PageIndex = newPage;
        await LoadDataAsync();
    }

    // --- CRUD OPERATIONS ---
    private void OnEditItem(RoomViewVM item)
    {
        _isUpdate = true;
        _currentEditingId = item.Id;

        _updateModel = new RoomViewUpdateVM
        {
            Name = item.Name,
            Description = item.Description
        };

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task HandleDelete(RoomViewVM item)
    {
        var res = await Service.DeleteRoomView(item.Id);
        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            await LoadDataAsync();
        }
    }

    private void ResetForm()
    {
        _isUpdate = false;
        _currentEditingId = 0;

        _createModel = new RoomViewCreateVM();
        _updateModel = new RoomViewUpdateVM();

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task SaveData()
    {
        ApiResponse<RoomViewVM> res;
        if (_isUpdate)
            res = await Service.UpdateRoomView(_currentEditingId, _updateModel);
        else
            res = await Service.CreateRoomView(_createModel);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
            await LoadDataAsync();
            ResetForm();
        }
        else
        {
            // Do NOT reset form on server-side error to allow correction
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
        }
    }
}