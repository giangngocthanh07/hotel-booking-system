@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Helpers.Manage.Icon
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@using HotelBooking.webapp.ViewModels.Hotel
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Helpers

@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITIONS --- *@
@page "/admin/manage/service"
@page "/admin/manage/service/{TypeId:int}"

@* --- 2. LAYOUT CONFIGURATION --- *@
@layout AdminLayout
@inject ILogger<ServiceManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI RENDERING --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_AUTH</span>
    </div>
}
else
{
    <MasterDetailLayout TItem="ServiceVM" @ref="_layoutRef" TModel="BaseCreateOrUpdateAdminVM" Items="items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="totalPages" TotalCount="totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm" OnNameBlur="SuggestDefaultValues">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="Service" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            @{
                decimal currentPrice = _isUpdate ? _updateModel.Price : _createModel.Price;

                RenderFragment RenderVal(string prop) => __builder =>
                {
                    if (_isUpdate)
                    {
                        if (prop == "Price")
                        {
                            <ValidationMessage For="() => _updateModel.Price" class="val-msg-custom" />
                        }
                        else if (prop == "Unit" && StdUp != null)
                        {
                            <ValidationMessage For="() => StdUp.Unit" class="val-msg-custom" />
                        }
                        else if (prop == "RoundTripPrice")
                        {
                            <ValidationMessage For="() => ((ServiceAirportUpdateVM)_updateModel).RoundTripPrice" class="val-msg-custom" />
                        }
                        else if (prop == "AdditionalFee")
                        {
                            <ValidationMessage For="() => ((ServiceAirportUpdateVM)_updateModel).AdditionalFee" class="val-msg-custom" />
                        }
                    }
                    else
                    {
                        if (prop == "Price")
                        {
                            <ValidationMessage For="() => _createModel.Price" class="val-msg-custom" />
                        }
                        else if (prop == "Unit" && StdCr != null)
                        {
                            <ValidationMessage For="() => StdCr.Unit" class="val-msg-custom" />
                        }
                        else if (prop == "RoundTripPrice")
                        {
                            <ValidationMessage For="() => ((ServiceAirportCreateVM)_createModel).RoundTripPrice" class="val-msg-custom" />
                        }
                        else if (prop == "AdditionalFee")
                        {
                            <ValidationMessage For="() => ((ServiceAirportCreateVM)_createModel).AdditionalFee" class="val-msg-custom" />
                        }
                    }
                };
            }

            @if (TypeId == 1 || TypeId == null)
            {
                <div class="glass-field-group mb-4 animate__animated animate__fadeIn">
                    <label class="glass-label-bold">Pricing Configuration</label>
                    <div class="mb-3">
                        <label class="extra-small-label">Unit of Measurement</label>
                        <input type="text" class="form-control glass-input-simple"
                               value="@(_isUpdate? StdUp?.Unit : StdCr?.Unit)"
                               @oninput="@(e => HandleUnitInput(e.Value?.ToString()))" placeholder="e.g. Trip, Person, Kg" />
                        @RenderVal("Unit")
                    </div>
                    <div class="mb-2">
                        <label class="extra-small-label">Suggested Base Price</label>
                        <div class="input-group glass-input-group-manage shadow-sm">
                            <span class="input-group-text border-0 bg-transparent text-success"><i
                                class="fa-solid fa-tag"></i></span>
                                <input type="text" class="form-control glass-input-inner fw-bold text-success text-end"
                                       value="@(currentPrice.ToString("N0"))"
                                       @oninput="@(e => HandlePriceInput(e.Value?.ToString(), "Price"))" />
                                <span class="input-group-text border-0 bg-light-glass fw-bold">VND</span>
                            </div>
                            @RenderVal("Price")
                        </div>
                    </div>
                }
        else if (TypeId == 2)
                {
                    <div class="airport-config-wrapper animate__animated animate__fadeIn">
                        <div class="specs-glass-pill mb-4 shadow-sm">
                            <div class="spec-item">
                                <i class="fa-solid fa-users text-primary"></i>
                                <div class="spec-control">
                                    <label>Max Pax</label>
                                    <input type="number" value="@(_isUpdate? AirUp!.MaxPassengers : AirCr!.MaxPassengers)"
                                           @onchange="@(e => { int.TryParse(e.Value?.ToString(), out var v); if (_isUpdate) AirUp!.MaxPassengers = v; else AirCr!.MaxPassengers = v; })" />
                                </div>
                            </div>
                            <div class="spec-divider"></div>
                            <div class="spec-item">
                                <i class="fa-solid fa-suitcase-rolling text-primary"></i>
                                <div class="spec-control">
                                    <label>Luggage</label>
                                    <input type="number" value="@(_isUpdate? AirUp!.MaxLuggage : AirCr!.MaxLuggage)"
                                           @onchange="@(e => { int.TryParse(e.Value?.ToString(), out var v); if (_isUpdate) AirUp!.MaxLuggage = v; else AirCr!.MaxLuggage = v; })" />
                                </div>
                            </div>
                        </div>

                        @{
                            bool is1W = (_isUpdate && AirUp?.IsOneWayPaid == true) || (!_isUpdate && AirCr?.IsOneWayPaid == true);
                        }
                        <div class="glass-section-card mb-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="glass-label-bold m-0"><i class="fa-solid fa-route me-2"></i>One-Way Service</label>
                                <div class="form-check form-switch custom-switch">
                                    <input class="form-check-input" type="checkbox" checked="@is1W"
                                           @onchange="@(e => HandleOneWayToggle((bool)e.Value!))" />
                                </div>
                            </div>
                            @if (is1W)
                            {
                                <div class="input-group glass-input-group-manage sm">
                                    <input type="text" class="form-control glass-input-inner text-end fw-bold text-primary"
                                           value="@(currentPrice.ToString("N0"))"
                                           @oninput="@(e => HandlePriceInput(e.Value?.ToString(), "Price"))" />
                                    <span class="input-group-text border-0 bg-transparent fw-bold small">VND</span>
                                </div>
                                @RenderVal("Price")
                            }
                            else
                            {

                                <div class="badge-complimentary">Complimentary</div>
                            }
                        </div>

                        @{
                            bool hasRT = _isUpdate ? AirUp?.HasRoundTrip == true : AirCr?.HasRoundTrip == true;
                            bool rtPaid = _isUpdate ? AirUp?.IsRoundTripPaid == true : AirCr?.IsRoundTripPaid == true;
                            decimal rtPriceValue = _isUpdate ? (AirUp?.RoundTripPrice ?? 0) : (AirCr?.RoundTripPrice ?? 0);
                        }
                        <div class="glass-section-card mb-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="glass-label-bold m-0"><i
                                    class="fa-solid fa-arrows-left-right me-2"></i>Round-Trip</label>
                                    <div class="form-check form-switch custom-switch">
                                        <input class="form-check-input" type="checkbox" checked="@hasRT"
                                               @onchange="@(e => HandleRoundTripToggle((bool)e.Value!))" />
                                    </div>
                                </div>
                                @if (hasRT)
                                {
                                    <div class="rt-options d-flex gap-2 mb-2">
                                        <button type="button" class="btn-option @(!rtPaid ? "active" : "")"
                                                @onclick="() => SetRoundTripPaid(false)">Free</button>
                                        <button type="button" class="btn-option @(rtPaid ? "active" : "")"
                                                @onclick="() => SetRoundTripPaid(true)">Paid</button>
                                    </div>
                                    @if (rtPaid)
                                    {
                                        <div class="input-group glass-input-group-manage sm">
                                            <input type="text" class="form-control glass-input-inner text-end fw-bold text-warning"
                                                   value="@(rtPriceValue.ToString("N0"))"
                                                   @oninput="@(e => HandlePriceInput(e.Value?.ToString(), "RoundTrip"))" />
                                            <span class="input-group-text border-0 bg-transparent fw-bold small">VND</span>
                                        </div>
                                        @RenderVal("RoundTripPrice")
                                    }
                                }
                            </div>

                            @{
                                bool hasNight = _isUpdate ? AirUp?.HasNightFee == true : AirCr?.HasNightFee == true;
                                decimal nightFeeValue = _isUpdate ? (AirUp?.AdditionalFee ?? 0) : (AirCr?.AdditionalFee ?? 0);
                            }
                            <div class="glass-section-card border-night shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <label class="glass-label-bold m-0 text-danger"><i class="fa-solid fa-moon me-2"></i>Night
                                        Surcharge</label>
                                        <div class="form-check form-switch custom-switch">
                                            <input class="form-check-input shadow-none" type="checkbox" checked="@hasNight"
                                                   @onchange="@(e => HandleNightFeeToggle((bool)e.Value!))" />
                                        </div>
                                    </div>
                                    @if (hasNight)
                                    {
                                        <div class="row g-2 mb-2">
                                            <div class="col-6">
                                                <input type="time" class="form-control glass-input-sm"
                                                       value="@((_isUpdate ? AirUp!.AdditionalFeeStartTime : AirCr!.AdditionalFeeStartTime)?.ToString("HH:mm"))"
                                                       @onchange="@(e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) { if (_isUpdate) AirUp!.AdditionalFeeStartTime = t; else AirCr!.AdditionalFeeStartTime = t; } })" />
                                            </div>
                                            <div class="col-6">
                                                <input type="time" class="form-control glass-input-sm"
                                                       value="@((_isUpdate ? AirUp!.AdditionalFeeEndTime : AirCr!.AdditionalFeeEndTime)?.ToString("HH:mm"))"
                                                       @onchange="@(e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var t)) { if (_isUpdate) AirUp!.AdditionalFeeEndTime = t; else AirCr!.AdditionalFeeEndTime = t; } })" />
                                            </div>
                                        </div>
                                        <div class="input-group glass-input-group-manage sm border-danger-glass">
                                            <input type="text" class="form-control glass-input-inner text-end fw-bold text-danger"
                                                   value="@(nightFeeValue.ToString("N0"))"
                                                   @oninput="@(e => HandlePriceInput(e.Value?.ToString(), "NightFee"))" />
                                            <span class="input-group-text border-0 bg-transparent fw-bold small text-danger">VND</span>
                                        </div>
                                        @RenderVal("AdditionalFee")
                                    }
                                </div>
                            </div>
                        }
                    </FormContent>

                    <TableHeader>
                        <th class="text-center" style="width: 60px;">ID</th>
                        <th class="text-center" style="width: 70px;">Icon</th>
                        <th class="text-start px-3" style="width: 220px;">Service Template</th>
                        <th class="text-start px-3">Description</th>
                        @if (TypeId == 1 || TypeId == null)
                        {
                            <th class="text-center" style="width: 120px;">Unit</th>
                            <th class="text-end pe-4" style="width: 150px;">Price</th>
                        }
                        else if (TypeId == 2)
                        {
                            <th class="text-center" style="width: 160px;">Price (1W/2W)</th>
                            <th class="text-center" style="width: 130px;">Capacity</th>
                            <th class="text-center" style="width: 160px;">Night Surcharge</th>
                        }
                    </TableHeader>

                    <RowTemplate Context="row">
                        <td class="text-center fw-bold text-muted small">#@row.Id</td>
                        <td class="text-center">
                            <div class="service-icon-box shadow-sm mx-auto force-gpu"><i class="@GetServiceIcon(row.Name)"></i></div>
                        </td>
                        <td class="text-start align-middle px-3">
                            <div class="fw-bold text-dark fs-6">@row.Name</div>
                            @if (row is ServiceAirportTransferVM)
                            {
                                <small class="text-primary fw-bold"
                                       style="font-size: 0.65rem;">Airport Transfer</small>
                            }
                        </td>
                        <td class="text-start align-middle px-3">
                            <div class="text-muted small text-truncate" style="max-width: 280px;" title="@row.Description">
                                @(row.Description ?? "---")</div>
                            </td>

                            @if (row is ServiceStandardVM standard)
                            {
                                <td class="text-center"><span class="badge-unit">@standard.Unit</span></td>
                                <td class="text-end fw-bold text-success pe-4 fs-6">@standard.Price.ToString("N0")<small>đ</small></td>
                            }
                            else if (row is ServiceAirportTransferVM at)
                            {
                                <td class="text-center align-middle px-3">
                                    <div class="price-stack-aligned mx-auto">
                                        <div class="price-row">
                                            <span class="p-label">1W:</span>
                                            <span class="p-value @(at.IsOneWayPaid ? "text-primary" : "text-success")">
                                                @(at.IsOneWayPaid? at.Price.ToString("N0") + "đ" : "Free")
                                            </span>
                                        </div>
                                        <div class="price-row">
                                            <span class="p-label">2W:</span>
                                            <span class="p-value @(at.IsRoundTripPaid ? "text-warning" : "text-success")">
                                                @(at.HasRoundTrip ? (at.IsRoundTripPaid ? at.RoundTripPrice?.ToString("N0") + "đ" : "Free") :
                                                "N/A")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="specs-pill-compact shadow-sm force-gpu">
                                        <i class="fa-solid fa-users me-1"></i>@at.MaxPassengers
                                        <span class="mx-2 opacity-25">|</span>
                                        <i class="fa-solid fa-suitcase-rolling me-1"></i>@at.MaxLuggage
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (at.HasNightFee)
                                    {
                                        <div class="night-badge-modern mx-auto force-gpu">
                                            <span class="n-fee">+@at.AdditionalFee?.ToString("N0")đ</span>
                                            <span
                                            class="n-time">@at.AdditionalFeeStartTime?.ToString("HH:mm")-@at.AdditionalFeeEndTime?.ToString("HH:mm")</span>
                                        </div>
                                    }
                                    else
                                    {

                                        <span class="text-muted opacity-25 small italic">None</span>
                                    }
                                </td>
                            }
                        </RowTemplate>
                    </MasterDetailLayout>
                }

                <style>
                    /* --- CSS REORGANIZED & LINKED TO site.css VARIABLES --- */
                    .glass-loader-container {
                        padding: 5rem;
                        text-align: center;
                        background: var(--glass-bg);
                        border-radius: 24px;
                    }

                    /* Form Labels & Inputs */
                    .glass-label-bold {
                        font-size: 0.75rem;
                        font-weight: 800;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        display: block;
                        margin-bottom: 12px;
                        color: var(--text-dark);
                    }

                    .extra-small-label {
                        font-size: 0.65rem;
                        font-weight: 800;
                        color: var(--text-muted);
                        text-transform: uppercase;
                        margin-bottom: 4px;
                        display: block;
                    }

                    .glass-input-simple {
                        background: #fff !important;
                        border: 1.5px solid #cbd5e1 !important;
                        border-radius: 10px;
                        padding: 0.6rem;
                        font-weight: 600;
                        color: var(--text-dark);
                    }

                    .glass-input-group-manage {
                        background: #fff;
                        border: 1.5px solid #cbd5e1;
                        border-radius: 12px;
                        overflow: hidden;
                    }

                    .glass-input-inner {
                        border: none !important;
                        box-shadow: none !important;
                        background: transparent !important;
                    }

                    .bg-light-glass {
                        background: rgba(0, 0, 0, 0.03);
                        border-left: 1px solid #e2e8f0 !important;
                    }

                    /* Airport Transfer Form Components */
                    .specs-glass-pill {
                        background: #fff;
                        border: 1.5px solid #e2e8f0;
                        border-radius: 16px;
                        display: flex;
                        align-items: center;
                        padding: 10px 15px;
                    }

                    .spec-item {
                        flex: 1;
                        display: flex;
                        align-items: center;
                        gap: 10px;
                    }

                    .spec-control label {
                        display: block;
                        font-size: 0.6rem;
                        font-weight: 800;
                        color: var(--text-muted);
                        text-transform: uppercase;
                        margin: 0;
                    }

                    .spec-control input {
                        border: none;
                        width: 45px;
                        font-weight: 800;
                        color: var(--text-dark);
                        outline: none;
                        background: transparent;
                    }

                    .spec-divider {
                        width: 1.5px;
                        height: 30px;
                        background: #e2e8f0;
                        margin: 0 15px;
                    }

                    .glass-section-card {
                        background: rgba(255, 255, 255, 0.7);
                        border: 1px solid var(--glass-border);
                        border-radius: 16px;
                        padding: 1.25rem;
                    }

                    .border-night {
                        border-color: rgba(244, 63, 94, 0.2);
                        background: rgba(244, 63, 94, 0.02);
                    }

                    .badge-complimentary {
                        font-size: 0.7rem;
                        font-weight: 800;
                        color: var(--color-success);
                        text-transform: uppercase;
                        background: #dcfce7;
                        padding: 4px 12px;
                        border-radius: 20px;
                        display: inline-block;
                        border: 1px solid rgba(16, 185, 129, 0.2);
                    }

                    .btn-option {
                        flex: 1;
                        border: 1.5px solid #cbd5e1;
                        background: #fff;
                        border-radius: 8px;
                        padding: 6px;
                        font-size: 0.75rem;
                        font-weight: 700;
                        color: var(--text-muted);
                        transition: 0.2s;
                    }

                    .btn-option.active {
                        border-color: var(--admin-blue);
                        background: #e0f2fe;
                        color: var(--admin-blue);
                    }

                    /* Table Visual Alignment Fixes */
                    .service-icon-box {
                        width: 38px;
                        height: 38px;
                        background: #fff;
                        color: var(--admin-blue);
                        border-radius: 12px;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 1.2rem;
                    }

                    .badge-unit {
                        background: #f8fafc;
                        color: var(--text-muted);
                        padding: 4px 10px;
                        border-radius: 8px;
                        font-size: 0.7rem;
                        font-weight: 700;
                        border: 1px solid #e2e8f0;
                    }

                    .price-stack-aligned {
                        display: inline-flex;
                        flex-direction: column;
                        gap: 4px;
                        min-width: 130px;
                    }

                    .price-row {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        font-size: 0.8rem;
                        font-weight: 700;
                    }

                    .p-label {
                        color: var(--text-muted);
                        font-weight: 600;
                        font-size: 0.65rem;
                        width: 30px;
                        text-align: left;
                    }

                    .p-value {
                        min-width: 80px;
                        text-align: right;
                    }

                    .specs-pill-compact {
                        background: #f0f9ff;
                        color: #0369a1;
                        border: 1px solid #bae6fd;
                        padding: 6px 12px;
                        border-radius: 12px;
                        font-size: 0.8rem;
                        font-weight: 800;
                        display: inline-flex;
                        align-items: center;
                    }

                    .night-badge-modern {
                        background: #fff1f2;
                        border: 1px solid #fecaca;
                        border-radius: 10px;
                        padding: 6px 12px;
                        display: inline-flex;
                        flex-direction: column;
                        min-width: 120px;
                    }

                    .n-fee {
                        color: var(--color-danger);
                        font-weight: 800;
                        font-size: 0.8rem;
                    }

                    .n-time {
                        color: #9f1239;
                        font-size: 0.65rem;
                        font-weight: 600;
                        opacity: 0.7;
                    }

                    /* Validation & Global Spacing */
                    .val-msg-custom {
                        font-size: 0.65rem;
                        font-weight: 700;
                        margin-top: 4px;
                        display: block;
                    }

                    .glass-table td {
                        padding-top: 1.25rem !important;
                        padding-bottom: 1.25rem !important;
                    }
                </style>

@code {
    [Parameter] public int? TypeId { get; set; }

    private List<ServiceVM>? items;
    private ServiceCreateVM _createModel = new ServiceStandardCreateVM();
    private ServiceUpdateVM _updateModel = new ServiceStandardUpdateVM();

    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int totalPages = 0;
    private int totalCount = 0;

    private int? _previousTypeId = null;
    private MasterDetailLayout<ServiceVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    private ServiceStandardCreateVM? StdCr => _createModel as ServiceStandardCreateVM;
    private ServiceStandardUpdateVM? StdUp => _updateModel as ServiceStandardUpdateVM;
    private ServiceAirportCreateVM? AirCr => _createModel as ServiceAirportCreateVM;
    private ServiceAirportUpdateVM? AirUp => _updateModel as ServiceAirportUpdateVM;

    private void SuggestDefaultValues()
    {
        if (_isUpdate) ServiceHelper.ApplyDefaultValues(_updateModel, TypeId ?? 1);
        else ServiceHelper.ApplyDefaultValues(_createModel, TypeId ?? 1);
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandleUnitInput(string? val)
    {
        if (_isUpdate && StdUp != null) StdUp.Unit = val ?? "";
        else if (StdCr != null) StdCr.Unit = val ?? "";
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandlePriceInput(string? val, string field)
    {
        var clean = new string((val ?? "").Where(char.IsDigit).ToArray());
        decimal.TryParse(clean, out var amount);

        if (field == "Price")
        {
            if (_isUpdate) { _updateModel.Price = amount; if (AirUp != null) AirUp.IsOneWayPaid = amount > 0; }
            else { _createModel.Price = amount; if (AirCr != null) AirCr.IsOneWayPaid = amount > 0; }
        }
        else if (field == "RoundTrip")
        {
            if (_isUpdate && AirUp != null) { AirUp.RoundTripPrice = amount; AirUp.IsRoundTripPaid = amount > 0; }
            else if (AirCr != null) { AirCr.RoundTripPrice = amount; AirCr.IsRoundTripPaid = amount > 0; }
        }
        else if (field == "NightFee")
        {
            if (_isUpdate && AirUp != null) AirUp.AdditionalFee = amount;
            else if (AirCr != null) AirCr.AdditionalFee = amount;
        }
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandleOneWayToggle(bool isEnabled)
    {
        decimal val = isEnabled ? 350000 : 0;
        if (_isUpdate && AirUp != null) { AirUp.IsOneWayPaid = isEnabled; AirUp.Price = val; }
        else if (AirCr != null) { AirCr.IsOneWayPaid = isEnabled; AirCr.Price = val; }
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandleRoundTripToggle(bool isEnabled)
    {
        if (_isUpdate && AirUp != null)
        {
            AirUp.HasRoundTrip = isEnabled;
            if (!isEnabled) { AirUp.IsRoundTripPaid = false; AirUp.RoundTripPrice = 0; }
            else { AirUp.IsRoundTripPaid = true; AirUp.RoundTripPrice = 650000; }
        }
        else if (AirCr != null)
        {
            AirCr.HasRoundTrip = isEnabled;
            if (!isEnabled) { AirCr.IsRoundTripPaid = false; AirCr.RoundTripPrice = 0; }
            else { AirCr.IsRoundTripPaid = true; AirCr.RoundTripPrice = 650000; }
        }
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void HandleNightFeeToggle(bool isEnabled)
    {
        decimal suggestedFee = isEnabled ? 100000 : 0;
        if (_isUpdate && AirUp != null)
        {
            AirUp.HasNightFee = isEnabled;
            AirUp.AdditionalFee = suggestedFee;
            if (isEnabled && AirUp.AdditionalFeeStartTime == default)
            {
                AirUp.AdditionalFeeStartTime = new TimeOnly(22, 0);
                AirUp.AdditionalFeeEndTime = new TimeOnly(5, 0);
            }
            else if (!isEnabled) { AirUp.AdditionalFeeStartTime = null; AirUp.AdditionalFeeEndTime = null; }
        }
        else if (AirCr != null)
        {
            AirCr.HasNightFee = isEnabled;
            AirCr.AdditionalFee = suggestedFee;
            if (isEnabled && AirCr.AdditionalFeeStartTime == default)
            {
                AirCr.AdditionalFeeStartTime = new TimeOnly(22, 0);
                AirCr.AdditionalFeeEndTime = new TimeOnly(5, 0);
            }
            else if (!isEnabled) { AirCr.AdditionalFeeStartTime = null; AirCr.AdditionalFeeEndTime = null; }
        }
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private void SetRoundTripPaid(bool isPaid)
    {
        decimal val = isPaid ? 650000 : 0;
        if (_isUpdate && AirUp != null) { AirUp.IsRoundTripPaid = isPaid; AirUp.RoundTripPrice = val; }
        else if (AirCr != null) { AirCr.IsRoundTripPaid = isPaid; AirCr.RoundTripPrice = val; }
        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? _updateModel : _createModel;

    private string GetServiceIcon(string? name) => ServiceIconHelper.GetIcon(name);

    protected override async Task LoadDataAsync()
    {
        if (Disposed) return;
        items = null;
        StateHasChanged();
        try
        {
            var res = await Service.GetServicesByType(TypeId, _paging);
            if (!Disposed && res.StatusCode == StatusCodeResponse.Success && res.Content != null)
            {
                items = res.Content.Items;
                totalPages = res.Content.TotalPages;
                totalCount = res.Content.TotalCount;
            }
            else
            {
                items = new List<ServiceVM>();
                if (res.StatusCode != StatusCodeResponse.Success) SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error loading service data"); items = new List<ServiceVM>(); }
        finally { if (!Disposed) StateHasChanged(); }
    }

    protected override void OnInitialized() => ResetForm();

    protected override async Task OnParametersSetAsync()
    {
        if (TypeId == null) TypeId = 1;
        if (TypeId != _previousTypeId)
        {
            _previousTypeId = TypeId;
            ResetForm();
            if (IsJsReady) { _paging.PageIndex = 1; await LoadDataAsync(); }
        }
    }

    private async Task HandlePageChanged(int newPage) { _paging.PageIndex = newPage; await LoadDataAsync(); }

    private void ResetForm()
    {
        _isUpdate = false;
        _currentEditingId = 0;
        _createModel = ServiceHelper.CreateNewServiceModel(TypeId ?? 1);
        _updateModel = TypeId == 2 ? new ServiceAirportUpdateVM() : (ServiceUpdateVM)new ServiceStandardUpdateVM();
        _layoutRef?.TriggerValidate();
        StateHasChanged();
    }

    private void OnEditItem(ServiceVM item)
    {
        _isUpdate = true;
        _currentEditingId = item.Id;
        var updateVm = ServiceHelper.MapToUpdateVM(item);
        if (updateVm != null) _updateModel = updateVm;
    }

    private async Task HandleDelete(ServiceVM item)
    {
        var res = await Service.DeleteService(item.Id);
        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
        if (res.StatusCode == StatusCodeResponse.Success) await LoadDataAsync();
    }

    private async Task SaveData()
    {
        bool IsModelValid<T>(T model) where T : class
        {
            var context = new ValidationContext(model);
            var results = new List<ValidationResult>();
            if (!Validator.TryValidateObject(model, context, results, true))
            {
                _snackbar.Clear();
                _snackbar.Add(results.First().ErrorMessage ?? MessageResponse.Common.ERROR_IN_SERVER, Severity.Error);
                return false;
            }
            return true;
        }

        if (_isUpdate) { if (!IsModelValid(_updateModel)) return; }
        else { if (!IsModelValid(_createModel)) return; }

        ApiResponse<ServiceVM> res;
        if (_isUpdate) res = await Service.UpdateService(_currentEditingId, _updateModel);
        else res = await Service.CreateService(_createModel);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode, res.Message!); await
            LoadDataAsync(); ResetForm();
        }
        else SnackbarHelper.Show(_snackbar, res.StatusCode ?? StatusCodeResponse.Error, res.Message ??
        MessageResponse.Common.ERROR_IN_SERVER);
    }
}