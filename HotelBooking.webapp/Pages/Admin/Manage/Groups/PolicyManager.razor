@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Helpers
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@using HotelBooking.webapp.Components

@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITION --- *@
@page "/admin/manage/policy"
@page "/admin/manage/policy/{TypeId:int}"

@* --- 2. LAYOUT CONFIGURATION --- *@
@layout AdminLayout
@inject ILogger<PolicyManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI LOADING STATE --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_DATA</span>
    </div>
}
else
{
    <MasterDetailLayout @ref="_layoutRef" TItem="PolicyVM" TModel="BaseCreateOrUpdateAdminVM" Items="_items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="_totalPages" TotalCount="_totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm" OnNameBlur="SuggestDefaultValues">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="Policy" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            <div class="policy-form-wrapper animate__animated animate__fadeIn">
                @RenderPolicyForm()
            </div>

            @* Administrative Note Box - Replaced standard alert with Glass Style *@
            <div class="policy-note-box mt-4 shadow-sm force-gpu">
                <div class="d-flex align-items-center">
                    <div class="note-icon-wrap"><i class="fa-solid fa-lightbulb"></i></div>
                    <div class="ms-3">
                        <div class="fw-bold text-dark small">Administrative Note</div>
                        <div class="extra-small text-muted">Hotel owners can customize these default values for their properties.</div>
                    </div>
                </div>
            </div>
        </FormContent>

        <TableHeader>
            <th class="text-center" style="width: 60px;">ID</th>
            <th class="text-start px-3" style="width: 300px;">Policy Name</th>
            <th class="text-center" style="width: 180px;">Configuration</th>
            <th class="text-start px-3">Detailed Description</th>
        </TableHeader>

        <RowTemplate Context="row">
            <td class="text-center fw-bold text-muted small">#@row.Id</td>
            <td class="text-start align-middle px-3">
                <div class="fw-bold text-dark fs-6">@row.Name</div>
                <div class="text-primary extra-small text-uppercase fw-800 opacity-75">Global Policy</div>
            </td>
            <td class="text-center align-middle">
                <div class="badge-config-wrap mx-auto force-gpu">@RenderRowBadge(row)</div>
            </td>
            <td class="text-start align-middle px-3">
                @if (string.IsNullOrWhiteSpace(row.Description))
                {
                    <span class="text-muted opacity-30 small fst-italic">No additional notes...</span>
                }
                else
                {
                    <div class="text-muted small text-truncate-custom" title="@row.Description">
                        @row.Description
                    </div>
                }
            </td>
        </RowTemplate>
    </MasterDetailLayout>
}

<style>
    /* --- CSS REORGANIZED & LINKED TO site.css VARIABLES --- */
    .glass-loader-container { padding: 5rem; text-align: center; background: var(--glass-bg); border-radius: 20px; }

    /* Policy Note Box */
    .policy-note-box {
        background: rgba(14, 165, 233, 0.08); /* Light info color */
        border: 1px solid rgba(14, 165, 233, 0.2);
        border-radius: 16px;
        padding: 1rem;
    }
    .note-icon-wrap {
        width: 32px; height: 32px; background: #fff; color: var(--admin-blue);
        border-radius: 8px; display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    }

    /* Form UI Enhancements */
    .policy-form-wrapper h6 {
        font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;
        border-left: 4px solid var(--admin-blue); padding-left: 10px; margin-top: 1.5rem;
        color: var(--text-dark);
    }
    
    .policy-form-wrapper h6.text-danger { border-left-color: var(--color-danger); }
    .policy-form-wrapper h6.text-success { border-left-color: var(--color-success); }
    .policy-form-wrapper h6.text-warning { border-left-color: var(--color-warning); }

    /* Table Styles */
    .badge-config-wrap { transform: scale(0.98); }
    
    .text-truncate-custom {
        max-width: 350px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Override standard badges using site.css variables */
    .badge.bg-primary.bg-opacity-10 { background: #e0f2fe !important; color: #0369a1 !important; border: 1px solid #bae6fd !important; }
    .badge.bg-success.bg-opacity-10 { background: #dcfce7 !important; color: #15803d !important; border: 1px solid #bbf7d0 !important; }
    .badge.bg-danger.bg-opacity-10 { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .badge.bg-warning.bg-opacity-10 { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a !important; }

    /* General Utilities */
    .fw-800 { font-weight: 800; }
    .extra-small { font-size: 0.7rem; }
    .uppercase { text-transform: uppercase; }
</style>

@code {
    [Parameter] public int? TypeId { get; set; }

    private List<PolicyVM>? _items;
    private PolicyCreateVM _createModel = new CheckInOutPolicyCreateVM();
    private PolicyUpdateVM _updateModel = new CheckInOutPolicyUpdateVM();
    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int _totalPages = 0;
    private int _totalCount = 0;
    private int? _previousTypeId = null;
    private MasterDetailLayout<PolicyVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    private CheckInOutPolicyUpdateVM? CioUp => _updateModel as CheckInOutPolicyUpdateVM;
    private CheckInOutPolicyCreateVM? CioCr => _createModel as CheckInOutPolicyCreateVM;
    private CancellationPolicyUpdateVM? CancelUp => _updateModel as CancellationPolicyUpdateVM;
    private CancellationPolicyCreateVM? CancelCr => _createModel as CancellationPolicyCreateVM;
    private ChildrenPolicyUpdateVM? ChildUp => _updateModel as ChildrenPolicyUpdateVM;
    private ChildrenPolicyCreateVM? ChildCr => _createModel as ChildrenPolicyCreateVM;
    private PetPolicyUpdateVM? PetUp => _updateModel as PetPolicyUpdateVM;
    private PetPolicyCreateVM? PetCr => _createModel as PetPolicyCreateVM;



    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? _updateModel : _createModel;

    // ======================== RENDER FRAGMENTS ========================
    private RenderFragment RenderPolicyForm() => __builder =>
    {
        var typeId = TypeId ?? 1002;
        switch (typeId)
        {
            case 1002: RenderCheckInOutForm(__builder); break;
            case 1003: RenderCancellationForm(__builder); break;
            case 1004: RenderChildrenForm(__builder); break;
            case 2002: RenderPetForm(__builder); break;
        }
    };

    private void RenderCheckInOutForm(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        TimeOnly? checkInTime = _isUpdate ? CioUp?.CheckInTime : CioCr?.CheckInTime;
        TimeOnly? checkOutTime = _isUpdate ? CioUp?.CheckOutTime : CioCr?.CheckOutTime;
        decimal earlyFee = _isUpdate ? (CioUp?.EarlyCheckInFee ?? 0) : (CioCr?.EarlyCheckInFee ?? 0);
        decimal lateFee = _isUpdate ? (CioUp?.LateCheckOutFee ?? 0) : (CioCr?.LateCheckOutFee ?? 0);

        bool hasFee = earlyFee > 0 || lateFee > 0;

        <h6 class="text-primary fw-bold mb-3"><i class="fa-regular fa-clock me-2"></i>Time Slots & Surcharges</h6>

        <div
            class="form-check form-switch custom-switch p-2 rounded border bg-light d-flex align-items-center justify-content-between mb-3 shadow-sm">
            <label class="small fw-bold text-muted text-uppercase mb-0 ms-1">
                <i class="fa-solid fa-hand-holding-dollar me-2 @(hasFee ? "text-success" : "text-secondary")"></i>
                @(hasFee ? "Chargeable Surcharge" : "Complimentary")
            </label>
            <input class="form-check-input" type="checkbox" role="switch" checked="@hasFee"
                   @onchange="@(e => ToggleCheckInOutFee((bool)e.Value!))"
                   style="width: 2.5rem; height: 1.25rem; cursor: pointer;">
            </div>

            @if (hasFee)
            {
                <div class="d-flex flex-column gap-2 mb-3 animate__animated animate__fadeInDown animate__faster">
                    <div>
                        <label class="form-label fw-bold extra-small text-muted">Early Check-in Fee</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-success"><i class="fa-solid fa-sun"></i></span>
                            <input type="text" class="form-control text-end fw-bold text-success" inputmode="numeric"
                                   value="@earlyFee.ToString("N0")" @oninput="@(e => SetCheckInOutFee("early", e.Value?.ToString()))" />
                            <span class="input-group-text bg-light fw-bold">VND</span>
                        </div>
                        <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => CioUp!.EarlyCheckInFee" CreateExpression="() => CioCr!.EarlyCheckInFee" CssClass="val-msg text-danger fw-bold small mt-1" />
                    </div>
                    <div>
                        <label class="form-label fw-bold extra-small text-muted">Late Check-out Fee</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-warning"><i class="fa-solid fa-moon"></i></span>
                            <input type="text" class="form-control text-end fw-bold text-warning" inputmode="numeric"
                                   value="@lateFee.ToString("N0")" @oninput="@(e => SetCheckInOutFee("late", e.Value?.ToString()))" />
                            <span class="input-group-text bg-light fw-bold">VND</span>
                        </div>
                        <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => CioUp!.LateCheckOutFee" CreateExpression="() => CioCr!.LateCheckOutFee" CssClass="val-msg text-danger fw-bold small mt-1" />
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-success border-0 py-2 px-3 d-flex align-items-center shadow-sm mb-3">
                    <i class="fa-solid fa-circle-check me-2 fs-5"></i>
                    <div class="extra-small fst-italic"><b>Free:</b> No additional fees applied.</div>
                </div>
            }

            <h6 class="text-primary fw-bold mb-3"><i class="fa-regular fa-clock me-2"></i>Standard Hours</h6>
            <div class="row g-3">
                <div class="col-6">
                    <label class="small text-muted fw-bold">Check-in</label>
                    <input type="time" class="form-control shadow-sm" value="@checkInTime?.ToString("HH:mm")"
                           @onchange="@(e => SetCheckInOutTime("in", e.Value?.ToString()))" />
                </div>
                <div class="col-6">
                    <label class="small text-muted fw-bold">Check-out</label>
                    <input type="time" class="form-control shadow-sm" value="@checkOutTime?.ToString("HH:mm")"
                           @onchange="@(e => SetCheckInOutTime("out", e.Value?.ToString()))" />
                </div>
            </div>
        }

    private void RenderCancellationForm(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        bool isRefundable = _isUpdate ? (CancelUp?.IsRefundable ?? false) : (CancelCr?.IsRefundable ?? false);
        int? days = _isUpdate ? (CancelUp?.DaysBeforeCheckIn ?? 0) : (CancelCr?.DaysBeforeCheckIn ?? 0);
        double? refundPct = _isUpdate ? (CancelUp?.RefundPercent ?? 0) : (CancelCr?.RefundPercent ?? 0);

        <h6 class="text-danger fw-bold mb-3"><i class="fa-solid fa-ban me-2"></i>Cancellation Policy</h6>

        <div
            class="form-check form-switch custom-switch p-2 rounded border bg-light d-flex align-items-center justify-content-between mb-3 shadow-sm">
            <label class="small fw-bold text-muted text-uppercase mb-0 ms-1">
                <i class="fa-solid fa-hand-holding-dollar me-2 @(isRefundable ? "text-success" : "text-danger")"></i>
                @(isRefundable ? "Refundable" : "Non-Refundable")
            </label>
            <input class="form-check-input" type="checkbox" role="switch" checked="@isRefundable"
                   @onchange="@(e => SetCancellationRefundable((bool)e.Value!))"
                   style="width: 2.5rem; height: 1.25rem; cursor: pointer;">
            </div>

            @if (isRefundable)
            {
                <div class="row g-3 animate__animated animate__fadeIn">
                    <div class="col-6">
                        <label class="extra-small text-muted fw-bold text-nowrap">Cancel Before</label>
                        <div class="input-group shadow-sm">
                            <input type="number" class="form-control text-center fw-bold" value="@days"
                                   @oninput="@(e => SetCancellationDays(e.Value?.ToString()))" />
                            <span class="input-group-text bg-primary text-white fw-bold">days</span>
                        </div>
                        <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => CancelUp!.DaysBeforeCheckIn" CreateExpression="() => CancelCr!.DaysBeforeCheckIn" CssClass="val-msg text-danger fw-bold small mt-1" />
                    </div>
                    <div class="col-6">
                        <label class="extra-small text-muted fw-bold text-nowrap">Refund Amount</label>
                        <div class="input-group shadow-sm">
                            <input type="number" class="form-control text-center fw-bold text-success" value="@refundPct"
                                   @oninput="@(e => SetCancellationPercent(e.Value?.ToString()))" />
                            <span class="input-group-text bg-success text-white fw-bold">%</span>
                        </div>
                        <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => CancelUp!.RefundPercent" CreateExpression="() => CancelCr!.RefundPercent" CssClass="val-msg text-danger fw-bold small mt-1" />
                    </div>
                </div>
                <div class="p-3 rounded bg-light border-start border-4 border-success shadow-sm mt-3">
                    <div class="small fw-bold text-uppercase mb-1 text-muted">Summary:</div>
                    <div class="small fst-italic">Cancellations made <b>@days days</b> prior: <b class="text-success">@refundPct%
                        refund</b>.</div>
                    </div>
                }
        else
                {
                    <div class="alert alert-danger border-0 py-2 px-3 d-flex align-items-center shadow-sm">
                        <i class="fa-solid fa-ban me-2 fs-5"></i>
                        <div class="extra-small fst-italic"><b>Non-Refundable:</b> No refund issued upon cancellation.</div>
                    </div>
                }
            }

    private void RenderChildrenForm(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        int minAge = _isUpdate ? (ChildUp?.MinAge ?? 0) : (ChildCr?.MinAge ?? 0);
        int maxAge = _isUpdate ? (ChildUp?.MaxAge ?? 17) : (ChildCr?.MaxAge ?? 17);
        decimal extraBedFee = _isUpdate ? (ChildUp?.ExtraBedFee ?? 0) : (ChildCr?.ExtraBedFee ?? 0);

        bool hasFee = extraBedFee > 0;
        bool isInvalidRange = minAge > maxAge;

        <h6 class="text-success fw-bold mb-3"><i class="fa-solid fa-child-reaching me-2"></i>Children & Extra Beds</h6>

        <div class="row g-3">
            <div class="col-6">
                <label class="small text-muted fw-bold">Min Age</label>
                <input type="number" class="form-control fw-bold shadow-sm @(isInvalidRange ? "border-danger" : "")"
                       value="@minAge" @oninput="@(e => SetChildrenAge("min", e.Value?.ToString()))" />
                <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => ChildUp!.MinAge" CreateExpression="() => ChildCr!.MinAge" CssClass="val-msg text-danger fw-bold small mt-1" />
            </div>
            <div class="col-6">
                <label class="small text-muted fw-bold">Max Age</label>
                <input type="number" class="form-control fw-bold shadow-sm @(isInvalidRange ? "border-danger" : "")"
                       value="@maxAge" @oninput="@(e => SetChildrenAge("max", e.Value?.ToString()))" />
                <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => ChildUp!.MaxAge" CreateExpression="() => ChildCr!.MaxAge" CssClass="val-msg text-danger fw-bold small mt-1" />
            </div>

            @if (isInvalidRange)
            {
                <div class="col-12 animate__animated animate__shakeX">
                    <div class="alert alert-danger py-2 px-3 small fw-bold mb-0 shadow-sm"
                         style="border:none; border-left: 4px solid darkred;">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>Min age must be less than max age.
                    </div>
                </div>
            }

            <div class="col-12 mt-3">
                <div
                    class="form-check form-switch custom-switch p-2 rounded border bg-light d-flex align-items-center justify-content-between shadow-sm">
                    <label class="small fw-bold text-muted text-uppercase mb-0 ms-1">
                        <i class="fa-solid fa-bed me-2 @(hasFee ? "text-success" : "text-secondary")"></i>Apply Extra Bed Fee?
                    </label>
                    <input class="form-check-input" type="checkbox" role="switch" checked="@hasFee"
                           @onchange="@(e => ToggleChildrenFee((bool)e.Value!))"
                           style="width: 2.5rem; height: 1.25rem; cursor: pointer;">
                    </div>
                </div>

                @if (hasFee)
                {
                    <div class="col-12 animate__animated animate__fadeInDown animate__faster">
                        <label class="form-label fw-bold small text-muted text-uppercase">Extra Bed Surcharge</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white text-success"><i class="fa-solid fa-money-bill-wave"></i></span>
                            <input type="text" class="form-control text-end fw-bold text-success" inputmode="numeric"
                                   value="@extraBedFee.ToString("N0")" @oninput="@(e => SetChildrenFee(e.Value?.ToString()))" />
                            <span class="input-group-text bg-light fw-bold">VND</span>
                        </div>
                        <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => ChildUp!.ExtraBedFee" CreateExpression="() => ChildCr!.ExtraBedFee" CssClass="val-msg text-danger fw-bold small mt-1" />
                    </div>
                }
                else
                {
                    <div class="col-12 animate__animated animate__fadeIn">
                        <div class="alert alert-success border-0 py-2 px-3 d-flex align-items-center shadow-sm mb-0">
                            <i class="fa-solid fa-face-laugh-beam me-2 fs-5"></i>
                            <div class="extra-small"><b>Free:</b> No extra charge for beds.</div>
                        </div>
                    </div>
                }
            </div>
        }

    private void RenderPetForm(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        bool isAllowed = _isUpdate ? (PetUp?.IsPetAllowed ?? false) : (PetCr?.IsPetAllowed ?? false);
        decimal petFee = _isUpdate ? (PetUp?.PetFee ?? 0) : (PetCr?.PetFee ?? 0);

        bool hasFee = petFee > 0;

        <h6 class="text-warning fw-bold mb-3"><i class="fa-solid fa-paw me-2"></i>Pet Policy</h6>

        <div
            class="form-check form-switch custom-switch p-2 rounded border bg-light d-flex align-items-center justify-content-between mb-3 shadow-sm">
            <label class="small fw-bold text-muted text-uppercase mb-0 ms-1">
                <i class="fa-solid fa-dog me-2 @(isAllowed ? "text-warning" : "text-secondary")"></i>
                @(isAllowed ? "PETS ALLOWED" : "NO PETS")
            </label>
            <input class="form-check-input" type="checkbox" role="switch" checked="@isAllowed"
                   @onchange="@(e => SetPetAllowed((bool)e.Value!))" style="width: 2.5rem; height: 1.25rem; cursor: pointer;">
            </div>

            @if (isAllowed)
            {
                <div class="animate__animated animate__fadeIn">
                    <div class="form-check form-switch custom-switch p-2 rounded border bg-white d-flex align-items-center justify-content-between mb-3 shadow-sm"
                         style="border-style: dashed !important;">
                        <label class="small fw-bold text-muted text-uppercase mb-0 ms-1">
                            <i class="fa-solid fa-hand-holding-dollar me-2 @(hasFee ? "text-success" : "text-secondary")"></i>
                            @(hasFee ? "CHARGEABLE" : "COMPLIMENTARY")
                        </label>
                        <input class="form-check-input" type="checkbox" role="switch" checked="@hasFee"
                               @onchange="@(e => TogglePetFee((bool)e.Value!))" style="width: 2.5rem; height: 1.25rem; cursor: pointer;">
                        </div>

                        @if (hasFee)
                        {
                            <div class="mb-3 animate__animated animate__fadeInDown animate__faster">
                                <label class="form-label fw-bold extra-small text-muted text-uppercase">Cleaning / Pet Fee</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-white text-success"><i class="fa-solid fa-money-bill-wave"></i></span>
                                    <input type="text" class="form-control text-end fw-bold text-success" inputmode="numeric"
                                           value="@petFee.ToString("N0")" @oninput="@(e => SetPetFee(e.Value?.ToString()))" />
                                    <span class="input-group-text bg-light fw-bold">VND</span>
                                </div>
                                <DualValidation IsUpdate="_isUpdate" UpdateExpression="() => PetUp!.PetFee" CreateExpression="() => PetCr!.PetFee" CssClass="val-msg text-danger fw-bold small mt-1" />
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success border-0 py-2 px-3 d-flex align-items-center shadow-sm mb-0">
                                <i class="fa-solid fa-face-smile-beam me-2 fs-5"></i>
                                <div class="extra-small fst-italic"><b>Free:</b> Pets stay for free.</div>
                            </div>
                        }
                    </div>
                }
        else
                {
                    <div class="alert alert-secondary border-0 py-2 px-3 d-flex align-items-center shadow-sm mb-0">
                        <i class="fa-solid fa-ban me-2 fs-5"></i>
                        <div class="extra-small fst-italic">Pets are not accommodated.</div>
                    </div>
                }
            }

    private RenderFragment RenderRowBadge(PolicyVM row) => __builder =>
    {
    switch (row)
    {
        case CheckInOutPolicyVM cio:
            var totalFee = (cio.EarlyCheckInFee ?? 0) + (cio.LateCheckOutFee ?? 0);
            <div class="badge bg-primary bg-opacity-10 text-primary border border-primary d-flex flex-column justify-content-center py-1"
                 style="min-width: 160px; height: 42px;">
                <div class="small" style="font-size: 0.75rem;">
                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2"
                          style="font-size: 0.65rem;">
                        <i class="fa-regular fa-clock me-1"></i>@cio.CheckInTime?.ToString("HH:mm") -
                        @cio.CheckOutTime?.ToString("HH:mm")
                    </span>
                </div>
                <div class="fw-bold" style="font-size: 0.8rem;">
                    @(totalFee > 0 ? "+" + totalFee.ToString("N0") + "đ" : "Free")
                </div>
            </div>
            break;

        case CancellationPolicyVM cancel:
            <div class="badge bg-danger bg-opacity-10 text-danger border border-danger d-flex flex-column justify-content-center py-1"
                 style="min-width: 160px; height: 42px;">
                <div class="mb-1">
                    @if (!cancel.IsRefundable)
                    {
                        <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-2" style="font-size: 0.65rem;">
                            <i class="fa-solid fa-ban me-1"></i>Non-Refundable
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-2" style="font-size: 0.65rem;">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>Before @cancel.DaysBeforeCheckIn days
                        </span>
                    }
                </div>
                <div class="fw-bold text-uppercase" style="font-size: 0.8rem;">
                    @(cancel.IsRefundable ? $"{cancel.RefundPercent}% Refund" : "No Refund")
                </div>
            </div>
            break;

        case ChildrenPolicyVM child:
            <div class="badge bg-success bg-opacity-10 text-success border border-success d-flex flex-column justify-content-center py-1"
                 style="min-width: 160px; height: 42px;">
                <div class="small" style="font-size: 0.75rem;">
                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info border-opacity-25 px-2"
                          style="font-size: 0.7rem;">
                        <i class="fa-solid fa-child-reaching me-1"></i>@(child.MaxAge >= 99 ? $"{child.MinAge} yrs +" :
                                                                                                                                                            $"{child.MinAge} - {child.MaxAge} yrs")
                    </span>
                </div>
                <div class="fw-bold" style="font-size: 0.8rem;">@(child.ExtraBedFee > 0 ? "+" + child.ExtraBedFee?.ToString("N0") +
                                                                                                                                "đ" : "Free")</div>
                </div>
                break;

            case PetPolicyVM pet:
                    <div class="badge @(pet.IsPetAllowed ? "bg-warning text-warning border-warning" : "bg-secondary text-secondary border-secondary") bg-opacity-10 border d-flex flex-column justify-content-center py-1"
                         style="min-width: 160px; height: 42px;">
                        <div class="small" style="font-size: 0.7rem;">
                            <span class="badge rounded-pill bg-info bg-opacity-10 text-info px-2" style="font-size: 0.65rem;">
                                <i class="fa-solid fa-paw me-1"></i>@(pet.IsPetAllowed ? "Allowed" : "Not Allowed")
                            </span>
                        </div>
                        @if (pet.IsPetAllowed)
                        {
                            <div class="fw-bold mt-1" style="font-size: 0.85rem;">@(pet.PetFee > 0 ? "+" + pet.PetFee?.ToString("N0") + "đ" :
                                                                                                                                                                                                        "Free")</div>
                            }
                        </div>
                        break;

                        default:
<span class="text-muted opacity-50 fw-bold">---</span>
                break;
                    }
                }
;

    // ======================== FORM HANDLERS ========================
    private void ToggleCheckInOutFee(bool hasFee)
    {
        var fee = hasFee ? 50000 : 0;
        if (GetModel() is CheckInOutPolicyCreateVM cr) { cr.EarlyCheckInFee = fee; cr.LateCheckOutFee = fee; }
        else if (GetModel() is CheckInOutPolicyUpdateVM up) { up.EarlyCheckInFee = fee; up.LateCheckOutFee = fee; }
        StateHasChanged();
    }

    private void SetCheckInOutFee(string type, string? val)
    {
        decimal.TryParse(val?.Replace(",", "").Replace(".", ""), out var fee);
        if (GetModel() is CheckInOutPolicyCreateVM cr) { if (type == "early") cr.EarlyCheckInFee = fee; else cr.LateCheckOutFee = fee; }
        else if (GetModel() is CheckInOutPolicyUpdateVM up) { if (type == "early") up.EarlyCheckInFee = fee; else up.LateCheckOutFee = fee; }
        StateHasChanged();
    }

    private void SetCheckInOutTime(string type, string? val)
    {
        if (!TimeOnly.TryParse(val, out var time)) return;
        if (GetModel() is CheckInOutPolicyCreateVM cr) { if (type == "in") cr.CheckInTime = time; else cr.CheckOutTime = time; }
        else if (GetModel() is CheckInOutPolicyUpdateVM up) { if (type == "in") up.CheckInTime = time; else up.CheckOutTime = time; }
        StateHasChanged();
    }

    private void SetCancellationRefundable(bool isRefundable)
    {
        if (GetModel() is CancellationPolicyCreateVM cr)
        {
            cr.IsRefundable = isRefundable; 
            if (!isRefundable) { cr.DaysBeforeCheckIn = 0; cr.RefundPercent = 0; }
            else { cr.DaysBeforeCheckIn = 3; cr.RefundPercent = 100; }
        }
        else if (GetModel() is CancellationPolicyUpdateVM up)
        {
            up.IsRefundable = isRefundable; 
            if (!isRefundable) { up.DaysBeforeCheckIn = 0; up.RefundPercent = 0; }
            else { up.DaysBeforeCheckIn = 3; up.RefundPercent = 100; }
        }
        StateHasChanged();
    }

    private void SetCancellationDays(string? val)
    {
        int.TryParse(val, out var days);
        if (GetModel() is CancellationPolicyCreateVM cr) cr.DaysBeforeCheckIn = days;
        else if (GetModel() is CancellationPolicyUpdateVM up) up.DaysBeforeCheckIn = days;
        StateHasChanged();
    }

    private void SetCancellationPercent(string? val)
    {
        double.TryParse(val, out var pct);
        if (GetModel() is CancellationPolicyCreateVM cr) cr.RefundPercent = pct;
        else if (GetModel() is CancellationPolicyUpdateVM up) up.RefundPercent = pct;
        StateHasChanged();
    }

    private void SetChildrenAge(string type, string? val)
    {
        int.TryParse(val, out var age);
        if (GetModel() is ChildrenPolicyCreateVM cr) { if (type == "min") cr.MinAge = age; else cr.MaxAge = age; }
        else if (GetModel() is ChildrenPolicyUpdateVM up) { if (type == "min") up.MinAge = age; else up.MaxAge = age; }
