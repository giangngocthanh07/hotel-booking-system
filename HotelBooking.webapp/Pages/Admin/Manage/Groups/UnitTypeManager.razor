@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITION --- *@
@page "/admin/manage/unittype"

@* --- 2. SHARED ADMIN LAYOUT --- *@
@layout AdminLayout
@inject ILogger<UnitTypeManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI LOADING STATE --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_DATA</span>
    </div>
}
else
{
    <MasterDetailLayout @ref="_layoutRef" TItem="UnitTypeVM" TModel="BaseCreateOrUpdateAdminVM" Items="_items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="_totalPages" TotalCount="_totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="UnitType" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            @{
                bool isEntire = _isUpdate
                    ? (_updateModel.IsEntirePlace ?? false)
                    : (_createModel.IsEntirePlace ?? false);
            }

            @* 1. CONFIGURATION CARD (Linked to site.css variables) *@
            <div class="glass-config-card mb-4 animate__animated animate__fadeIn force-gpu">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <label class="glass-label-bold text-primary mb-0">
                        <i class="fa-solid fa-sliders me-2"></i>Rental Configuration
                    </label>
                    <div class="form-check form-switch custom-switch-lg">
                        <input class="form-check-input glass-switch" type="checkbox" role="switch" checked="@isEntire"
                               @onchange="@(e => HandleToggleEntire((bool)(e.Value ?? false)))">
                        </div>
                    </div>

                    @* 2. VISUAL EXPLANATION (Glass-style box that changes color based on state) *@
                    <div class="rental-info-box force-gpu @(isEntire ? "entire" : "private") shadow-sm">
                        <div class="d-flex align-items-start">
                            <div class="info-icon-circle shadow-sm">
                                <i class="fa-solid @(isEntire ? "fa-house-lock" : "fa-door-closed")"></i>
                            </div>
                            <div class="ms-3">
                                <div class="info-tag">@(isEntire ? "ENTIRE PLACE" : "PRIVATE ROOM")</div>
                                <div class="info-text">
                                    @if (isEntire)
                                    {
                                        <span>Guests have the whole property to themselves. Ideal for Apartments, Villas.</span>
                                    }
                                    else
                                    {
                                        <span>Guests rent a bedroom within the property. Ideal for Hotels, Guesthouses.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </FormContent>

            <TableHeader>
                <th class="text-center" style="width: 60px;">ID</th>
                <th class="text-start px-3" style="width: 250px;">Accommodation Type</th>
                <th class="text-start px-3">Description</th>
                <th class="text-center" style="width: 200px;">Rental Model</th>
            </TableHeader>

            <RowTemplate Context="row">
                <td class="text-center fw-bold text-muted small">#@row.Id</td>

                <td class="text-start align-middle px-3">
                    <div class="fw-bold text-dark fs-6">@row.Name</div>
                    <div class="text-muted extra-small">Ref: UT-0@row.Id</div>
                </td>

                <td class="text-start align-middle px-3">
                    @if (string.IsNullOrWhiteSpace(row.Description))
                    {
                        <span class="text-muted opacity-30 small italic">---</span>
                    }
                    else
                    {
                        <div class="text-muted small text-truncate-custom" title="@row.Description">
                            @row.Description
                        </div>
                    }
                </td>

                <td class="text-center align-middle">
                    @if (row.IsEntirePlace == true)
                    {
                        <span class="glass-pill-solid success force-gpu">
                            <i class="fa-solid fa-key me-2"></i>Entire Place
                        </span>
                    }
                    else
                    {
                        <span class="glass-pill-solid slate force-gpu">
                            <i class="fa-solid fa-bed me-2"></i>Private Room
                        </span>
                    }
                </td>
            </RowTemplate>
        </MasterDetailLayout>
    }

    <style>
        /* --- CSS REORGANIZED & LINKED TO site.css VARIABLES --- */
        .glass-loader-container {
            padding: 5rem;
            text-align: center;
            background: var(--glass-bg);
            border-radius: 24px;
        }

        .glass-config-card {
            background: var(--glass-bg-deep);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 1.5rem;
        }

        .glass-label-bold {
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
            color: var(--text-dark);
        }

        /* Toggle Style Customization */
        .custom-switch-lg .glass-switch {
            width: 3.2rem !important;
            height: 1.6rem !important;
            cursor: pointer;
        }

        /* Interactive Info Box */
        .rental-info-box {
            padding: 1.25rem;
            border-radius: 16px;
            border: 1px solid transparent;
            transition: all 0.3s ease;
        }

        .rental-info-box.entire {
            background: rgba(16, 185, 129, 0.08);
            border-color: rgba(16, 185, 129, 0.2);
        }

        .rental-info-box.private {
            background: rgba(100, 116, 139, 0.08);
            border-color: rgba(100, 116, 139, 0.2);
        }

        .info-icon-circle {
            width: 42px;
            height: 42px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .entire .info-icon-circle {
            color: var(--color-success);
        }

        .private .info-icon-circle {
            color: var(--text-muted);
        }

        .info-tag {
            font-size: 0.65rem;
            font-weight: 900;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .entire .info-tag {
            color: #059669;
        }

        .private .info-tag {
            color: var(--text-dark);
        }

        .info-text {
            font-size: 0.75rem;
            color: var(--text-muted);
            line-height: 1.4;
            font-style: italic;
        }

        /* Table Visual Elements */
        .glass-pill-solid {
            display: inline-flex;
            align-items: center;
            padding: 6px 14px;
            border-radius: 20px;
            font-weight: 800;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .glass-pill-solid.success {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .glass-pill-solid.slate {
            background: #f1f5f9;
            color: var(--text-muted);
            border: 1px solid #e2e8f0;
        }

        .text-truncate-custom {
            max-width: 350px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .glass-table td {
            padding-top: 1.25rem !important;
            padding-bottom: 1.25rem !important;
        }
    </style>

@code {
    // --- URL PARAMETERS ---
    [Parameter] public int? TypeId { get; set; }

    // --- STATE MANAGEMENT ---
    private List<UnitTypeVM>? _items;
    private UnitTypeCreateVM _createModel = new UnitTypeCreateVM();
    private UnitTypeUpdateVM _updateModel = new UnitTypeUpdateVM();

    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    // --- PAGINATION ---
    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int _totalPages = 0;
    private int _totalCount = 0;

    private bool _isFirstLoad = true;

    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? (BaseCreateOrUpdateAdminVM)_updateModel :
    (BaseCreateOrUpdateAdminVM)_createModel;

    private MasterDetailLayout<UnitTypeVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    // --- REACTIVE SWITCH HANDLER ---
    private void HandleToggleEntire(bool val)
    {
        if (_isUpdate) _updateModel.IsEntirePlace = val;
        else _createModel.IsEntirePlace = val;

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    // --- 1. LOAD DATA ---
    protected override async Task LoadDataAsync()
    {
        _items = null;
        StateHasChanged();

        try
        {
            var res = await Service.GetUnitTypes(_paging);

            if (!Disposed)
            {
                if (res.StatusCode == StatusCodeResponse.Success && res.Content != null)
                {
                    _items = res.Content.Items;
                    _totalPages = res.Content.TotalPages;
                    _totalCount = res.Content.TotalCount;
                }
                else
                {
                    _items = new List<UnitTypeVM>();
                    if (res.StatusCode != StatusCodeResponse.Success)
                    {
                        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading unit type data");
            _items = new List<UnitTypeVM>();
        }
    }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    // --- 2. PARAMETERS HANDLING ---
    protected override async Task OnParametersSetAsync()
    {
        if (_isFirstLoad && IsJsReady)
        {
            _isFirstLoad = false;
            ResetForm();
            await LoadDataAsync();
        }
    }

    // --- PAGINATION HANDLING ---
    private async Task HandlePageChanged(int newPage)
    {
        _paging.PageIndex = newPage;
        await LoadDataAsync();
    }

    // --- CRUD METHODS ---
    private void OnEditItem(UnitTypeVM item)
    {
        _isUpdate = true;
        _currentEditingId = item.Id;

        _updateModel = new UnitTypeUpdateVM
        {
            Name = item.Name,
            Description = item.Description,
            IsEntirePlace = item.IsEntirePlace
        };

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task HandleDelete(UnitTypeVM item)
    {
        var res = await Service.DeleteUnitType(item.Id);
        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            await LoadDataAsync();
        }
    }

    private void ResetForm()
    {
        _isUpdate = false;
        _currentEditingId = 0;

        _createModel = new UnitTypeCreateVM { IsEntirePlace = false };
        _updateModel = new UnitTypeUpdateVM();

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task SaveData()
    {
        ApiResponse<UnitTypeVM> res;

        if (_isUpdate)
        {
            res = await Service.UpdateUnitType(_currentEditingId, _updateModel);
        }
        else
        {
            res = await Service.CreateUnitType(_createModel);
        }

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
            await LoadDataAsync();
            ResetForm();
        }
        else
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
        }
    }
}