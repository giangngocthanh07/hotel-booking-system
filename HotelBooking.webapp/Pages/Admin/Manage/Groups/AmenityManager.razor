@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Helpers.Manage.Icon
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Helpers
@using HotelBooking.webapp.ViewModels.Admin
@using HotelBooking.webapp.ViewModels.Admin.Base
@inherits AdminPageBase
@attribute [Authorize(Roles = "Admin")]

@* --- 1. ROUTING DEFINITION --- *@
@page "/admin/manage/amenity"
@page "/admin/manage/amenity/{TypeId:int}"

@* --- 2. LAYOUT CONFIGURATION --- *@
@layout AdminLayout
@inject ILogger<AmenityManager> Logger
@inject ISnackbar _snackbar

@* --- 3. UI LOADING STATE (Check flag from Base Class) --- *@
@if (!ShouldRenderUI())
{
    <div class="glass-loader-container force-gpu">
        <div class="spinner-border text-primary me-3"></div>
        <span class="fw-bold text-primary">@MessageResponse.Common.LOADING_DATA</span>
    </div>
}
else
{
    <MasterDetailLayout @ref="_layoutRef" TItem="HotelBooking.webapp.ViewModels.Admin.AmenityVM" TModel="BaseCreateOrUpdateAdminVM" Items="_items"
                        Model="@GetModel()" PageIndex="_paging.PageIndex ?? 1" TotalPages="_totalPages" TotalCount="_totalCount"
                        OnPageChanged="HandlePageChanged" OnSubmit="SaveData" IsEditMode="_isUpdate" OnEdit="OnEditItem"
                        OnDelete="HandleDelete" OnCancel="ResetForm">

        <SidebarTopContent>
            <GlobalNavMenu CurrentModule="Amenity" CurrentTypeId="TypeId" />
        </SidebarTopContent>

        <FormContent Context="m">
            @* --- 1. ICON PREVIEW (Linked to variables) --- *@
            <div class="glass-preview-card animate__animated animate__fadeIn force-gpu">
                <div class="icon-circle-wrap shadow-sm">
                    <i class="@GetAmenityIcon(m.Name) amenity-preview-icon"></i>
                </div>
                <div class="preview-info">
                    <label class="extra-small-label">Visual Asset</label>
                    <div class="preview-name">@(string.IsNullOrEmpty(m.Name) ? "Awaiting Name..." : m.Name)</div>
                </div>
            </div>

            @* --- 2. FREE SERVICE NOTIFICATION (Mint Style) --- *@
            <div class="free-badge-alert shadow-sm force-gpu">
                <div class="d-flex align-items-center">
                    <div class="gift-box-icon"><i class="fa-solid fa-gift pulse-icon"></i></div>
                    <span class="ms-2">All amenities are <strong>FREE</strong> for guests.</span>
                </div>
            </div>
        </FormContent>

        <TableHeader>
            <th class="text-center" style="width: 70px;">ID</th>
            <th class="text-center" style="width: 80px;">Icon</th>
            <th class="text-start px-3" style="width: 250px;">Amenity Name</th>
            <th class="text-start px-3">Description / Details</th>
            <th class="text-center" style="width: 140px;">Group Type</th>
            <th class="text-center" style="width: 100px;">Status</th>
        </TableHeader>

        <RowTemplate Context="row">
            <td class="text-center fw-bold text-muted small">#@row.Id</td>

            <td class="text-center">
                <div class="icon-table-box shadow-sm force-gpu">
                    <i class="@GetAmenityIcon(row.Name)"></i>
                </div>
            </td>

            <td class="text-start align-middle px-3">
                <span class="fw-bold text-dark fs-6">@row.Name</span>
            </td>

            <td class="text-start align-middle px-3">
                @if (string.IsNullOrWhiteSpace(row.Description))
                {
                    <span class="text-muted opacity-30 small italic">---</span>
                }
                else
                {
                    <div class="text-muted small text-truncate-custom" title="@row.Description">
                        @row.Description
                    </div>
                }
            </td>

            <td class="text-center">
                <span class="badge-group-type force-gpu">
                    <i class="fa-solid fa-folder-open me-1 opacity-50"></i>Type @row.TypeId
                </span>
            </td>

            <td class="text-center">
                <span class="status-pill-free">FREE</span>
            </td>
        </RowTemplate>
    </MasterDetailLayout>
}

<style>
    /* --- REORGANIZED CSS WITH VARIABLES --- */
    .glass-loader-container {
        padding: 5rem;
        text-align: center;
        background: var(--glass-bg);
        border-radius: 24px;
    }

    /* Form UI Components */
    .glass-preview-card {
        background: var(--glass-bg-deep);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 1.5rem;
    }

    .icon-circle-wrap {
        width: 50px;
        height: 50px;
        background: #f0fdf4;
        /* Light Emerald */
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-success);
        font-size: 1.5rem;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .extra-small-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        margin: 0;
    }

    .preview-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-dark);
    }

    .free-badge-alert {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 12px 16px;
        border-radius: 14px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    /* Table Data Alignment & Styles */
    .icon-table-box {
        width: 38px;
        height: 38px;
        background: #fff;
        color: var(--color-success);
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        border: 1px solid rgba(0, 0, 0, 0.03);
    }

    .badge-group-type {
        background: #f8fafc;
        color: var(--text-muted);
        border: 1px solid #e2e8f0;
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-block;
    }

    .status-pill-free {
        background: rgba(16, 185, 129, 0.1);
        color: #059669;
        font-weight: 800;
        font-size: 0.7rem;
        padding: 4px 14px;
        border-radius: 20px;
        border: 1px solid rgba(16, 185, 129, 0.2);
        letter-spacing: 0.5px;
    }

    /* Utilities */
    .text-truncate-custom {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pulse-icon {
        animation: pulseGreen 2s infinite;
    }

    @@keyframes pulseGreen {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
            opacity: 0.9;
        }

        100% {
            transform: scale(1);
        }
    }

    .glass-table td {
        padding-top: 1.25rem !important;
        padding-bottom: 1.25rem !important;
    }
</style>

@code {
    // --- URL PARAMETERS ---
    [Parameter] public int? TypeId { get; set; }

    // --- STATE MANAGEMENT ---
    private List<HotelBooking.webapp.ViewModels.Admin.AmenityVM>? _items;
    private AmenityCreateVM _createModel = new AmenityCreateVM();
    private AmenityUpdateVM _updateModel = new AmenityUpdateVM();
    private int _currentEditingId = 0;
    private bool _isUpdate = false;

    // --- PAGINATION MANAGEMENT ---
    private PagingRequest _paging = new() { PageIndex = 1, PageSize = 10 };
    private int _totalPages = 0;
    private int _totalCount = 0;

    private int? _previousTypeId = null;

    // --- HELPER: Resolve icon based on name ---
    private string GetAmenityIcon(string? name) => AmenityIconHelper.GetIcon(name);

    private BaseCreateOrUpdateAdminVM GetModel() => _isUpdate ? (BaseCreateOrUpdateAdminVM)_updateModel :
    (BaseCreateOrUpdateAdminVM)_createModel;

    private MasterDetailLayout<HotelBooking.webapp.ViewModels.Admin.AmenityVM, BaseCreateOrUpdateAdminVM>? _layoutRef;

    // --- LIFECYCLE ---
    // Override LoadDataAsync from AdminPageBase
    protected override async Task LoadDataAsync()
    {
        _items = null;
        StateHasChanged();

        try
        {
            var res = await Service.GetAmenitiesByType(TypeId, _paging);

            if (!Disposed) // Check base disposal flag
            {
                if (res.StatusCode == StatusCodeResponse.Success && res.Content != null)
                {
                    _items = res.Content.Items;
                    _totalPages = res.Content.TotalPages;
                    _totalCount = res.Content.TotalCount;
                }
                else
                {
                    _items = new List<HotelBooking.webapp.ViewModels.Admin.AmenityVM>();
                    if (res.StatusCode != StatusCodeResponse.Success)
                        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading amenity data");
            _items = new List<HotelBooking.webapp.ViewModels.Admin.AmenityVM>();
        }
    }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    // --- TAB SWITCHING LOGIC ---
    protected override async Task OnParametersSetAsync()
    {
        if (TypeId == null) TypeId = 1;

        if (TypeId != _previousTypeId)
        {
            _previousTypeId = TypeId;
            ResetForm();

            if (IsJsReady)
            {
                _paging.PageIndex = 1;
                await LoadDataAsync();
            }
        }
    }

    // --- PAGINATION HANDLING ---
    private async Task HandlePageChanged(int newPage)
    {
        _paging.PageIndex = newPage;
        await LoadDataAsync();
    }

    // --- CRUD OPERATIONS ---
    private void OnEditItem(HotelBooking.webapp.ViewModels.Admin.AmenityVM item)
    {
        _isUpdate = true;
        _currentEditingId = item.Id;

        _updateModel = new AmenityUpdateVM
        {
            Name = item.Name,
            Description = item.Description
        };

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task HandleDelete(HotelBooking.webapp.ViewModels.Admin.AmenityVM item)
    {
        var res = await Service.DeleteAmenity(item.Id);
        SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            await LoadDataAsync();
        }
    }

    private void ResetForm()
    {
        _isUpdate = false;
        _currentEditingId = 0;

        _createModel = new AmenityCreateVM
        {
            TypeId = TypeId ?? 0
        };
        _updateModel = new AmenityUpdateVM();

        StateHasChanged();
        _layoutRef?.TriggerValidate();
    }

    private async Task SaveData()
    {
        ApiResponse<HotelBooking.webapp.ViewModels.Admin.AmenityVM> res;

        if (_isUpdate)
            res = await Service.UpdateAmenity(_currentEditingId, _updateModel);
        else
        {
            _createModel.TypeId = TypeId ?? 0;
            res = await Service.CreateAmenity(_createModel);
        }

        if (res.StatusCode == StatusCodeResponse.Success)
        {
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
            await LoadDataAsync();
            ResetForm();
        }
        else
        {
            // Do NOT reset form on server-side validation error (e.g., duplicate name)
            SnackbarHelper.Show(_snackbar, res.StatusCode!, res.Message!);
        }
    }
}