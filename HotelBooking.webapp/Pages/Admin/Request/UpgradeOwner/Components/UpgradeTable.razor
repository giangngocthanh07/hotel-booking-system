@* filepath: HotelBooking.webapp\Pages\Admin\Requests\UpgradeOwner\Components\UpgradeTable.razor *@

@using HotelBooking.webapp.ViewModels.Request
@using HotelBooking.webapp.Helpers

<div class="glass-table-card animate__animated animate__fadeInUp force-gpu shadow-sm">
    <div class="glass-header-inner d-flex justify-content-between align-items-center p-3">
        <h5 class="m-0 fw-bold text-dark"><i class="fas fa-list-check me-2 text-primary"></i>Request Pipeline</h5>
        <div class="table-info-pill force-gpu">Showing <strong>@DisplayCount</strong> of @TotalCount entries</div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 glass-table-modern">
            <thead>
                <tr>
                    <th class="text-center" style="width: 80px;">ID</th>
                    <th class="text-start px-4" style="width: 250px;">Partner Information</th>
                    <th class="text-start px-4">Business Details</th>
                    <th class="text-center" style="width: 140px;">Status</th>
                    <th class="text-center" style="width: 160px;">Submission</th>
                    <th class="text-center" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Requests)
                {
                    <tr class="glass-row">
                        <td class="text-center fw-bold text-muted small">#@request.RequestId</td>
                        <td class="text-start px-4">
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark fs-6">@request.FullName</span>
                                <small class="text-primary fw-600">@@@request.UserName</small>
                            </div>
                        </td>
                        <td class="text-start px-4">
                            <div class="text-dark small fw-600"><i class="fas fa-phone-alt me-2 text-muted opacity-50"></i>@request.PhoneNumber</div>
                            <div class="text-muted extra-small mt-1"><i class="fas fa-id-card me-2"></i><code class="tax-code-inline">@request.TaxCode</code></div>
                        </td>
                        <td class="text-center">
                            <span class="status-pill-soft @GetStatusBadgeClass(request.Status) force-gpu">
                                <i class="@GetStatusIcon(request.Status) me-1"></i> @request.Status.ToUpper()
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="text-dark small fw-bold">@request.RequestedAt.ToString("dd MMM yyyy")</div>
                            <div class="text-muted extra-small">@request.RequestedAt.ToString("HH:mm")</div>
                        </td>
                        <td class="text-center">
                            <div class="action-btn-group">
                                <button class="btn-circle-action view force-gpu" title="View Details" @onclick="() => OnView.InvokeAsync(request)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                @if (request.Status == "Pending")
                                {
                                    <button class="btn-circle-action approve force-gpu" title="Approve Request" @onclick="() => OnApprove.InvokeAsync(request)">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn-circle-action reject force-gpu" title="Reject Request" @onclick="() => OnReject.InvokeAsync(request)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* --- TABLE CARD STYLING (site.css variables) --- */
    .glass-table-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border-radius: 24px;
        border: 1px solid var(--glass-border);
        overflow: hidden;
    }

    .glass-header-inner {
        background: rgba(255, 255, 255, 0.2);
        border-bottom: 1px solid var(--glass-border);
    }

    .table-info-pill {
        background: #f1f5f9; color: var(--text-muted);
        padding: 4px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    }

    /* Modern Table Header */
    .glass-table-modern thead th {
        background: rgba(0, 0, 0, 0.02);
        color: var(--text-muted) !important;
        font-size: 0.7rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: 1px;
        padding: 1.25rem 1rem; border: none;
    }

    /* Table Body & Rows */
    .glass-row { transition: all 0.2s ease; border-bottom: 1px solid rgba(0,0,0,0.03); }
    .glass-row:hover { background: rgba(255, 255, 255, 0.5); }
    .glass-row td { padding: 1.25rem 0.75rem; }

    /* Soft-Solid Badges Sync with site.css */
    .status-pill-soft {
        display: inline-flex; align-items: center; padding: 6px 14px; border-radius: 50px;
        font-weight: 800; font-size: 0.7rem; letter-spacing: 0.5px; border: 1px solid transparent;
    }
    .status-pending { background: #e0f2fe; color: #0369a1; border-color: #bae6fd; }
    .status-approved { background: #dcfce7; color: var(--color-success); border-color: #bbf7d0; }
    .status-rejected { background: #fee2e2; color: var(--color-danger); border-color: #fecaca; }
    .status-cancelled { background: #f1f5f9; color: var(--text-muted); border-color: #e2e8f0; }

    /* Action Buttons */
    .action-btn-group { display: flex; gap: 8px; justify-content: center; }
    .btn-circle-action {
        width: 34px; height: 34px; border-radius: 10px; border: none; color: #fff;
        display: flex; align-items: center; justify-content: center; transition: 0.2s;
    }
    .btn-circle-action.view { background: var(--color-info); }
    .btn-circle-action.approve { background: var(--color-success); }
    .btn-circle-action.reject { background: var(--color-danger); }
    
    .btn-circle-action:hover { transform: scale(1.1); filter: brightness(1.1); box-shadow: 0 4px 10px rgba(0,0,0,0.1); }

    /* Utilities */
    .tax-code-inline { color: var(--admin-blue); background: rgba(58, 123, 213, 0.05); padding: 2px 6px; border-radius: 4px; font-weight: 600; }
    .fw-600 { font-weight: 600; }
    .extra-small { font-size: 0.65rem; }
</style>

@code {
    [Parameter] public IEnumerable<UpgradeRequestVM> Requests { get; set; } = new List<UpgradeRequestVM>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int DisplayCount { get; set; }
    [Parameter] public string? SelectedStatus { get; set; }
    [Parameter] public string? SearchTerm { get; set; }

    [Parameter] public EventCallback<UpgradeRequestVM> OnView { get; set; }
    [Parameter] public EventCallback<UpgradeRequestVM> OnApprove { get; set; }
    [Parameter] public EventCallback<UpgradeRequestVM> OnReject { get; set; }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "status-pending",
        "Approved" => "status-approved",
        "Rejected" => "status-rejected",
        "Cancelled" => "status-cancelled",
        _ => "status-cancelled"
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Pending" => "fas fa-hourglass-half",
        "Approved" => "fas fa-check",
        "Rejected" => "fas fa-times",
        "Cancelled" => "fas fa-ban",
        _ => "fas fa-question"
    };
}