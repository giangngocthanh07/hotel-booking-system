@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Requests\UpgradeOwner\Components\UpgradeTable.razor *@

@using HotelBooking.webapp.ViewModels.Request
@using HotelBooking.webapp.Helpers

<div class="glass-container-table animate__animated animate__fadeInUp">
    <div class="glass-header d-flex justify-content-between align-items-center p-3">
        <h5 class="m-0 fw-bold text-dark"><i class="fas fa-table me-2 text-primary"></i>Request List</h5>
        <div class="table-info-badge">Showing @DisplayCount / @TotalCount</div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>User Information</th>
                    <th>Phone / Tax Code</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Requested At</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Requests)
                {
                    <tr class="glass-tr">
                        <td class="text-center text-muted fw-bold">#@request.RequestId</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-bold text-dark">@request.FullName</span>
                                <small class="text-primary">@@@request.UserName</small>
                            </div>
                        </td>
                        <td>
                            <div class="text-dark small"><i
                                class="fas fa-phone-alt me-2 text-muted"></i>@request.PhoneNumber</div>
                                <div class="text-muted small mt-1"><i
                                    class="fas fa-id-card me-2"></i><code>@request.TaxCode</code></div>
                                </td>
                                <td class="text-center">
                                    <span class="badge-solid @GetStatusBadgeClass(request.Status)">@request.Status</span>
                                </td>
                                <td class="text-center text-muted small">
                                    <span class="d-block fw-bold text-dark">@request.RequestedAt.ToString("MM/dd/yyyy")</span>
                                    @request.RequestedAt.ToString("HH:mm")
                                </td>
                                <td class="text-center">
                                    <div class="action-btns">
                                        <button class="btn-action-view" @onclick="() => OnView.InvokeAsync(request)"><i
                                            class="fas fa-eye"></i></button>
                                            @if (request.Status == "Pending")
                                            {
                                                <button class="btn-action-approve" @onclick="() => OnApprove.InvokeAsync(request)"><i
                                                    class="fas fa-check"></i></button>
                                                    <button class="btn-action-reject" @onclick="() => OnReject.InvokeAsync(request)"><i
                                                        class="fas fa-times"></i></button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <style>
                        .glass-container-table {
                            background: rgba(255, 255, 255, 0.55);
                            backdrop-filter: blur(15px);
                            border-radius: 24px;
                            border: 1px solid rgba(255, 255, 255, 0.7);
                            overflow: hidden;
                        }

                        .glass-header {
                            background: rgba(255, 255, 255, 0.3);
                            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
                        }

                        .table thead th {
                            background: rgba(0, 0, 0, 0.03);
                            color: #334155 !important;
                            font-size: 0.75rem;
                            font-weight: 800;
                            text-transform: uppercase;
                            padding: 1.2rem;
                            text-align: center;
                        }

                        .table thead th:nth-child(2),
                        .table thead th:nth-child(3) {
                            text-align: left;
                        }

                        .glass-tr:hover {
                            background: rgba(255, 255, 255, 0.7) !important;
                        }

                        .badge-solid {
                            padding: 6px 12px;
                            border-radius: 8px;
                            font-weight: 700;
                            font-size: 0.75rem;
                            color: #fff;
                            text-transform: uppercase;
                        }

                        .bg-warning.text-dark {
                            background: #0284c7 !important;
                            color: #fff !important;
                        }

                        .action-btns {
                            display: flex;
                            gap: 6px;
                            justify-content: center;
                        }

                        .btn-action-view,
                        .btn-action-approve,
                        .btn-action-reject {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            border: none;
                            transition: 0.2s;
                            color: #fff;
                        }

                        .btn-action-view {
                            background: #0ea5e9;
                        }

                        .btn-action-approve {
                            background: #10b981;
                        }

                        .btn-action-reject {
                            background: #f43f5e;
                        }

                        .btn-action-view:hover,
                        .btn-action-approve:hover,
                        .btn-action-reject:hover {
                            transform: scale(1.1);
                            filter: brightness(1.2);
                        }
                    </style>

@code {
    [Parameter] public IEnumerable<UpgradeRequestVM> Requests { get; set; } = new List<UpgradeRequestVM>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int DisplayCount { get; set; }
    [Parameter] public string? SelectedStatus { get; set; }
    [Parameter] public string? SearchTerm { get; set; }

    [Parameter] public EventCallback<UpgradeRequestVM> OnView { get; set; }
    [Parameter] public EventCallback<UpgradeRequestVM> OnApprove { get; set; }
    [Parameter] public EventCallback<UpgradeRequestVM> OnReject { get; set; }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Pending" => "fas fa-hourglass-half",
        "Approved" => "fas fa-check",
        "Rejected" => "fas fa-times",
        "Cancelled" => "fas fa-ban",
        _ => "fas fa-question"
    };
}