@using HotelBooking.webapp.ViewModels.Request

<div class="row g-4 mb-4 animate__animated animate__fadeIn force-gpu">
    @foreach (var item in new[] {
    new { Label = "Pending", Val = Stats.Pending, Icon = "fa-hourglass-half", ColorClass = "warning", Status = "Pending" },
    new { Label = "Approved", Val = Stats.Approved, Icon = "fa-check-circle", ColorClass = "success", Status =
    "Approved" },
    new { Label = "Rejected", Val = Stats.Rejected, Icon = "fa-times-circle", ColorClass = "danger", Status = "Rejected" },
    new { Label = "Total", Val = Stats.Total, Icon = "fa-list", ColorClass = "primary", Status = (string?)null }
    })
    {
        <div class="col-md-3">
            <div class="stat-glass-card @(SelectedStatus == item.Status ? "active" : "") force-gpu"
                 @onclick="@(() => HandleStatusClick(item.Status))">

                <div class="stat-icon-wrap @item.ColorClass force-gpu">
                    <i class="fas @item.Icon"></i>
                </div>

                <div class="stat-data-content text-end">
                    <h3 class="stat-number @item.ColorClass">@item.Val</h3>
                    <small class="stat-label-text">@item.Label</small>
                </div>

                <div class="stat-indicator-bar @item.ColorClass"></div>
            </div>
        </div>
    }
</div>

<style>
    /* --- STAT CARD BASE (Linked to site.css) --- */
    .stat-glass-card {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .stat-glass-card:hover {
        transform: translateY(-5px);
        background: var(--glass-bg-deep);
        box-shadow: var(--glass-shadow) !important;
    }

    /* (Selected/Active) */
    .stat-glass-card.active {
        background: #fff !important;
        border-color: var(--admin-blue) !important;
        box-shadow: 0 10px 25px rgba(58, 123, 213, 0.15) !important;
        transform: translateY(-5px) scale(1.02);
    }

    /* Icon Styling */
    .stat-icon-wrap {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        transition: 0.3s;
    }

    .stat-icon-wrap.warning {
        background: rgba(245, 158, 11, 0.1);
        color: var(--color-warning);
    }

    .stat-icon-wrap.success {
        background: rgba(16, 185, 129, 0.1);
        color: var(--color-success);
    }

    .stat-icon-wrap.danger {
        background: rgba(244, 63, 94, 0.1);
        color: var(--color-danger);
    }

    .stat-icon-wrap.primary {
        background: rgba(58, 123, 213, 0.1);
        color: var(--admin-blue);
    }

    /* Typography */
    .stat-number {
        font-weight: 900;
        margin: 0;
        font-size: 2rem;
        line-height: 1;
    }

    .stat-number.warning {
        color: var(--color-warning);
    }

    .stat-number.success {
        color: var(--color-success);
    }

    .stat-number.danger {
        color: var(--color-danger);
    }

    .stat-number.primary {
        color: var(--admin-blue);
    }

    .stat-label-text {
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.5px;
        margin-top: 4px;
        display: block;
    }

    /* Bottom Decorative Indicator Bar */
    .stat-indicator-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 5px;
        width: 100%;
        opacity: 0.4;
    }

    .stat-indicator-bar.warning {
        background: var(--color-warning);
    }

    .stat-indicator-bar.success {
        background: var(--color-success);
    }

    .stat-indicator-bar.danger {
        background: var(--color-danger);
    }

    .stat-indicator-bar.primary {
        background: var(--admin-blue);
    }

    .active .stat-indicator-bar {
        opacity: 1;
        height: 6px;
    }
</style>

@code {
    [Parameter] public RequestTypeStatsVM Stats { get; set; } = new();
    [Parameter] public string? SelectedStatus { get; set; }

    [Parameter] public EventCallback<string?> OnStatusClick { get; set; }
    [Parameter] public EventCallback<string?> OnFilterByStatus { get; set; }

    private async Task HandleStatusClick(string? status)
    {
        if (OnFilterByStatus.HasDelegate)
            await OnFilterByStatus.InvokeAsync(status);
        else if (OnStatusClick.HasDelegate)
            await OnStatusClick.InvokeAsync(status);
    }
}
