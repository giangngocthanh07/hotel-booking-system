@page "/admin/requests/upgrade-owner/{RequestId:int}"
@using HotelBooking.webapp.ViewModels
@using HotelBooking.webapp.ViewModels.Request
@using System.Net.Http.Headers

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IJSRuntime JSRuntime

<PageTitle>Request Details #@RequestId</PageTitle>

<div class="container-fluid py-4 details-page-animate">
    @* --- Navigation & Header --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <button class="btn-glass-back me-3" @onclick="GoBack">
                <i class="fas fa-arrow-left"></i>
            </button>
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/requests/upgrade-owner" class="text-primary text-decoration-none">Requests</a></li>
                        <li class="breadcrumb-item active">Details</li>
                    </ol>
                </nav>
                <h4 class="mb-0 fw-bold text-dark">Upgrade Request #@RequestId</h4>
            </div>
        </div>
        
        @if (request != null && request.Status == "Pending")
        {
            <div class="action-header-btns">
                <button class="btn-glass-success me-2" @onclick="ShowApproveModal">
                    <i class="fas fa-check me-2"></i>Approve
                </button>
                <button class="btn-glass-danger" @onclick="ShowRejectModal">
                    <i class="fas fa-times me-2"></i>Reject
                </button>
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="glass-loader-wrapper">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 fw-bold text-primary">Fetching request data...</p>
        </div>
    }
    else if (request == null)
    {
        <div class="glass-alert warning">
            <i class="fas fa-exclamation-triangle me-3"></i>
            <span>Request not found or has been removed.</span>
        </div>
    }
    else
    {
        <div class="row">
            @* --- Left Column: User Information --- *@
            <div class="col-lg-6 mb-4">
                <div class="glass-card h-100">
                    <div class="glass-card-header blue">
                        <i class="fas fa-user-circle me-2"></i>User Information
                    </div>
                    <div class="glass-card-body">
                        <div class="info-item">
                            <label>Username</label>
                            <div class="info-value">@request.UserName</div>
                        </div>
                        <div class="info-item">
                            <label>Full Name</label>
                            <div class="info-value fw-bold">@request.FullName</div>
                        </div>
                        <div class="info-item">
                            <label>Email Address</label>
                            <div class="info-value">
                                <a href="mailto:@request.Email" class="text-primary">@request.Email</a>
                            </div>
                        </div>
                        <div class="info-item">
                            <label>Phone Number</label>
                            <div class="info-value">@request.PhoneNumber</div>
                        </div>
                    </div>
                </div>
            </div>

            @* --- Right Column: Request Information --- *@
            <div class="col-lg-6 mb-4">
                <div class="glass-card h-100">
                    <div class="glass-card-header cyan">
                        <i class="fas fa-file-invoice me-2"></i>Request Details
                    </div>
                    <div class="glass-card-body">
                        <div class="info-item">
                            <label>Current Status</label>
                            <div class="mt-1">
                                <span class="badge-custom @GetStatusBadgeClass(request.Status)">
                                    <i class="@GetStatusIcon(request.Status) me-2"></i>@request.Status
                                </span>
                            </div>
                        </div>
                        <div class="info-item">
                            <label>Tax Code</label>
                            <div class="info-value code-font">@request.TaxCode</div>
                        </div>
                        <div class="info-item">
                            <label>Business Address</label>
                            <div class="info-value address-text">@request.Address</div>
                        </div>
                        <div class="info-item">
                            <label>Submission Date</label>
                            <div class="info-value text-muted small">@request.RequestedAt.ToString("MMMM dd, yyyy - HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* --- History Section --- *@
        @if (request.Status != "Pending")
        {
            <div class="glass-card mb-4 border-top-thick @GetStatusBgClass(request.Status)">
                <div class="glass-card-body d-flex align-items-center p-4">
                    <div class="history-icon-box @GetStatusTextClass(request.Status)">
                        <i class="@GetStatusIcon(request.Status) fa-2x"></i>
                    </div>
                    <div class="ms-4">
                        <h5 class="fw-bold mb-1 @GetStatusTextClass(request.Status)">
                            This request was @request.Status.ToUpper()
                        </h5>
                        <div class="text-muted small">
                            <span class="me-3"><i class="fas fa-calendar-alt me-1"></i> @request.ProcessedAt?.ToString("g")</span>
                            <span><i class="fas fa-user-shield me-1"></i> Auditor: <strong>@request.ProcessedByName</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* --- Modal & Toast Style Custom --- *@
<style>
    .details-page-animate { animation: fadeIn 0.5s ease; }

    /* Glass Cards */
    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(15px);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .glass-card-header {
        padding: 1.25rem 1.5rem;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: white;
    }

    .glass-card-header.blue { background: linear-gradient(135deg, #0060e6, #00b4d8); }
    .glass-card-header.cyan { background: linear-gradient(135deg, #0891b2, #06b6d4); }

    .glass-card-body { padding: 1.5rem; }

    /* Info Items */
    .info-item { margin-bottom: 1.25rem; border-bottom: 1px solid rgba(0,0,0,0.03); padding-bottom: 0.75rem; }
    .info-item:last-child { border-bottom: none; }
    .info-item label { display: block; font-size: 0.75rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin-bottom: 4px; }
    .info-value { color: #1e293b; font-size: 1rem; }
    .code-font { font-family: 'JetBrains Mono', monospace; color: #0060e6; background: rgba(0,96,230,0.05); padding: 4px 8px; border-radius: 6px; display: inline-block; }

    /* Buttons */
    .btn-glass-back {
        width: 40px; height: 40px; border-radius: 12px; border: 1.5px solid #cbd5e1; background: white; color: #64748b; transition: 0.3s;
    }
    .btn-glass-back:hover { background: #f1f5f9; color: #1e293b; transform: translateX(-3px); }

    .btn-glass-success { background: #10b981; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 700; transition: 0.3s; }
    .btn-glass-danger { background: #f43f5e; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 700; transition: 0.3s; }
    
    .btn-glass-success:hover, .btn-glass-danger:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }

    /* Badge & History */
    .badge-custom { padding: 8px 16px; border-radius: 10px; font-weight: 800; font-size: 0.8rem; }
    .border-top-thick { border-top: 5px solid !important; }
    .border-top-thick.bg-success { border-color: #059669 !important; background: rgba(16, 185, 129, 0.1) !important; color: #1e293b !important; }
    .border-top-thick.bg-danger { border-color: #dc2626 !important; background: rgba(239, 68, 68, 0.1) !important; color: #1e293b !important; }

    .history-icon-box { width: 60px; height: 60px; border-radius: 16px; background: white; display: flex; align-items: center; justify-content: center; }

    .glass-loader-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 5rem 0; }

    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .toast {
    background: rgba(255, 255, 255, 0.8) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 16px !important;
    border: 1px solid rgba(255, 255, 255, 0.5) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
    overflow: hidden;
    }

    .toast-body {
        padding: 1rem 1.25rem !important;
        font-weight: 600;
    }

    .bg-success .toast-body { color: #059669 !important; } /* Xanh lá đậm */
    .bg-danger .toast-body { color: #dc2626 !important; }  /* Đỏ đậm */

    .btn-close-white {
        filter: invert(0) grayscale(100%) brightness(0.5);
    }

</style>

@* Toast Notification *@
@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show align-items-center text-white @toastClass border-0">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="@toastIcon me-2"></i>@toastMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                @onclick="() => toastMessage = null"></button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int RequestId { get; set; }

    private HttpClient _httpClient = null!;
    private UpgradeRequestVM? request;

    // State
    private bool isLoading = true;
    private bool isProcessing = false;

    // Toast
    private string? toastMessage;
    private string toastClass = "bg-success";
    private string toastIcon = "fas fa-check-circle";

    // Modal
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalHeaderClass = "bg-primary";
    private string modalBtnClass = "btn-primary";
    private string modalIcon = "fas fa-question-circle";
    private string actionType = "";

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");

        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
        {
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        await LoadRequestAsync();
    }

    private async Task LoadRequestAsync()
    {
        isLoading = true;
        try
        {
            var response = await _httpClient.GetAsync($"v1/admin/upgrade-requests/{RequestId}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();
                request = apiResponse?.Content;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/admin/requests/upgrade-owner");
    }

    // ==================== ACTIONS ====================

    private async Task ShowApproveModal()
    {
        modalTitle = "Confirm Approval";
        modalMessage = "Are you sure you want to APPROVE this request? The user will be upgraded to Owner.";
        modalHeaderClass = "bg-success";
        modalBtnClass = "btn-success";
        modalIcon = "fas fa-check-circle";
        actionType = "approve";

        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ShowRejectModal()
    {
        modalTitle = "Confirm Rejection";
        modalMessage = "Are you sure you want to REJECT this request?";
        modalHeaderClass = "bg-danger";
        modalBtnClass = "btn-danger";
        modalIcon = "fas fa-times-circle";
        actionType = "reject";

        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ConfirmAction()
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            var url = actionType == "approve"
            ? $"v1/admin/upgrade-requests/{RequestId}/approve"
            : $"v1/admin/upgrade-requests/{RequestId}/reject";

            var response = await _httpClient.PostAsync(url, null);

            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide()");

            if (response.IsSuccessStatusCode)
            {
                var message = actionType == "approve"
                ? "Request approved successfully! User has been upgraded to Owner."
                : "Request rejected successfully!";
                ShowToast(message, true);
                await LoadRequestAsync(); // Reload to update status
            }
            else
            {
                var message = actionType == "approve" ? "Failed to approve request!" : "Failed to reject request!";
                ShowToast(message, false);
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // ==================== HELPERS ====================

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusBgClass(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        "Cancelled" => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusTextClass(string status) => status switch
    {
        "Approved" => "text-success",
        "Rejected" => "text-danger",
        "Cancelled" => "text-secondary",
        _ => "text-secondary"
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Pending" => "fas fa-hourglass-half",
        "Approved" => "fas fa-check-circle",
        "Rejected" => "fas fa-times-circle",
        "Cancelled" => "fas fa-ban",
        _ => "fas fa-question-circle"
    };

    private void ShowToast(string message, bool isSuccess)
    {
        toastMessage = message;
        toastClass = isSuccess ? "bg-success" : "bg-danger";
        toastIcon = isSuccess ? "fas fa-check-circle" : "fas fa-exclamation-circle";
        StateHasChanged();

        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            toastMessage = null;
            InvokeAsync(StateHasChanged);
        });
    }
}