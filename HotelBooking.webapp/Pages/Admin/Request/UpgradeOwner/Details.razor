@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Request\UpgradeOwner\Details.razor *@
@page "/admin/requests/upgrade-owner/{RequestId:int}"
@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.ViewModels
@using HotelBooking.webapp.ViewModels.Request
@using HotelBooking.webapp.Pages.Admin.Request.Components
@using System.Net.Http.Headers

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject ISnackbar Snackbar

<PageTitle>Upgrade Request #@RequestId</PageTitle>

<div class="container-fluid py-4 details-page-animate force-gpu">

    @* --- Shared Page Header --- *@
    <RequestPageHeader RequestId="RequestId"
                       Title="Upgrade Request"
                       BackUrl="/admin/requests/upgrade-owner"
                       BackLabel="Requests"
                       ActiveLabel="Details"
                       ShowActions="@(request != null && request.Status == RequestStatusConst.Pending)"
                       OnBack="GoBack"
                       OnApprove="ShowApproveModal"
                       OnReject="ShowRejectModal" />

    @* --- Loading State --- *@
    @if (isLoading)
    {
        <div class="glass-loader-wrapper text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <p class="mt-3 fw-bold text-primary">Fetching partner data...</p>
        </div>
    }
    else if (request == null)
    {
        <div class="glass-alert-warning force-gpu shadow-sm p-4 text-center">
            <i class="fas fa-exclamation-triangle fa-2x mb-2 text-warning"></i>
            <h5 class="fw-bold">Request Not Found</h5>
            <span class="text-muted">This request does not exist or has been removed from the system.</span>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* --- Left Column: User Information --- *@
            <div class="col-lg-6">
                <div class="glass-card-info h-100 shadow-sm force-gpu">
                    <div class="glass-card-header-inner blue">
                        <i class="fas fa-user-circle me-2"></i>User Profile
                    </div>
                    <div class="glass-card-body-inner">
                        <div class="info-group">
                            <label class="info-label">Username</label>
                            <div class="info-value-box text-muted">@@@request.UserName</div>
                        </div>
                        <div class="info-group">
                            <label class="info-label">Full Name</label>
                            <div class="info-value-box fw-bold text-dark">@request.FullName</div>
                        </div>
                        <div class="info-group">
                            <label class="info-label">Email Address</label>
                            <div class="info-value-box">
                                <a href="mailto:@request.Email"
                                   class="text-primary fw-bold text-decoration-none">@request.Email</a>
                            </div>
                        </div>
                        <div class="info-group">
                            <label class="info-label">Phone Number</label>
                            <div class="info-value-box fw-bold">@request.PhoneNumber</div>
                        </div>
                    </div>
                </div>
            </div>

            @* --- Right Column: Request / Business Information --- *@
            <div class="col-lg-6">
                <div class="glass-card-info h-100 shadow-sm force-gpu">
                    <div class="glass-card-header-inner cyan d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-file-invoice me-2"></i>Business Details</span>
                        <RequestStatusBadge Status="@request.Status" ExtraStyle="min-height:28px;" />
                    </div>
                    <div class="glass-card-body-inner">
                        <div class="info-group">
                            <label class="info-label">Tax Identification Number</label>
                            <div class="info-value-box tax-code-style">@request.TaxCode</div>
                        </div>
                        <div class="info-group">
                            <label class="info-label">Registered Business Address</label>
                            <div class="info-value-box address-area">@request.Address</div>
                        </div>
                        <div class="info-group">
                            <label class="info-label">Submission Timestamp</label>
                            <div class="info-value-box text-muted small">
                                @request.RequestedAt.ToString("MMMM dd, yyyy - HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* --- History Section (only when processed) --- *@
            @if (request.Status != RequestStatusConst.Pending)
            {
                <div class="col-12 mt-2">
                    <RequestHistoryCard Status="@request.Status"
                                        ProcessedAt="@request.ProcessedAt"
                                        ProcessedByName="@request.ProcessedByName"
                                        ActionVerb="This request" />
                </div>
            }
        </div>
    }
</div>

@* --- SHARED CONFIRMATION MODAL --- *@
<ConfirmModal @ref="_confirmModal"
              Title="@modalTitle"
              Message="@modalMessage"
              ConfirmText="@(actionType == "approve" ? "Confirm Approve" : "Confirm Reject")"
              ConfirmIcon="@(actionType == "approve" ? "fa-check" : "fa-trash-can")"
              ConfirmButtonClass="@(actionType == "approve" ? "btn-success glass-btn-confirm text-white" : "btn-glass-confirm-danger")"
              IsProcessing="@isProcessing"
              OnConfirm="ConfirmAction">
    <div class="mt-3 p-2 rounded" style="background: rgba(0,0,0,0.03);">
        <p class="text-muted small mb-0 text-center">
            Target Request: <strong class="text-primary fs-6">#@RequestId</strong>
        </p>
    </div>
</ConfirmModal>

<style>
    /* --- LAYOUT --- */
    .details-page-animate { animation: fadeIn 0.5s ease-out; }
    .header-glass { background: var(--glass-bg); backdrop-filter: var(--glass-blur); border: 1px solid var(--glass-border); border-radius: 20px; }
    .glass-card-info { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 24px; overflow: hidden; }

    /* --- INFO ELEMENTS --- */
    .glass-card-header-inner { padding: 1.25rem 1.5rem; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: white; }
    .glass-card-header-inner.blue  { background: linear-gradient(135deg, #3a7bd5, #00d2ff); }
    .glass-card-header-inner.cyan  { background: linear-gradient(135deg, #0891b2, #06b6d4); }
    .glass-card-body-inner { padding: 2rem; }
    .info-group { margin-bottom: 1.5rem; }
    .info-label { font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block; }
    .info-value-box { color: var(--text-dark); font-size: 1rem; font-weight: 600; padding: 12px 16px; background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; }
    .tax-code-style { font-family: 'JetBrains Mono', monospace; color: var(--admin-blue); background: rgba(58, 123, 213, 0.05); }

    /* --- STATUS BADGE (shared styles referenced by RequestStatusBadge component) --- */
    .badge-fixed-layout { display: inline-flex !important; align-items: center !important; justify-content: center !important; line-height: 1 !important; min-height: 32px; padding: 0 16px !important; white-space: nowrap; border-radius: 50px; font-weight: 800; font-size: 0.7rem; letter-spacing: 0.5px; text-transform: uppercase; border: 1px solid transparent; }
    .status-pill-modern.bg-warning { background: #fffbeb !important; color: #92400e !important; border-color: #fde68a !important; }
    .status-pill-modern.bg-success { background: #f0fdf4 !important; color: #15803d !important; border-color: #bbf7d0 !important; }
    .status-pill-modern.bg-danger  { background: #fef2f2 !important; color: #991b1b !important; border-color: #fecaca !important; }

    /* --- BUTTONS --- */
    .btn-glass-back { width: 42px; height: 42px; border-radius: 12px; border: 1.5px solid #e2e8f0; background: #fff; color: var(--text-muted); transition: 0.3s; }
    .btn-glass-back:hover { background: #f8fafc; color: var(--text-dark); transform: translateX(-3px); }
    .btn-glass-success { background: var(--color-success); color: #fff; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 700; transition: 0.3s; }
    .btn-glass-danger  { background: var(--color-danger);  color: #fff; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 700; transition: 0.3s; }

    /* --- HISTORY --- */
    .glass-card-history { background: var(--glass-bg); border-radius: 20px; border-left: 6px solid #cbd5e1; }
    .border-success-thick { border-left-color: var(--color-success) !important; background: rgba(16, 185, 129, 0.05); }
    .border-danger-thick  { border-left-color: var(--color-danger)  !important; background: rgba(244, 63, 94, 0.05); }
    .history-icon-circle { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.05); }

    @@keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    [Parameter] public int RequestId { get; set; }

    private ConfirmModal _confirmModal = default!;
    private HttpClient _httpClient = null!;
    private UpgradeRequestVM? request;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string modalTitle = "";
    private string modalMessage = "";
    private string actionType = "";

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await LoadRequestAsync();
    }

    private async Task LoadRequestAsync()
    {
        isLoading = true;
        try
        {
            var response = await _httpClient.GetAsync($"v1/admin/upgrade-requests/{RequestId}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();
                request = apiResponse?.Content;
            }
        }
        catch (Exception) { SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER); }
        finally { isLoading = false; }
    }

    private void GoBack() => NavigationManager.NavigateTo("/admin/requests/upgrade-owner");

    private void ShowApproveModal()
    {
        modalTitle   = "Approve Upgrade";
        modalMessage = "Are you sure you want to approve this request? The user will be immediately granted the Owner role.";
        actionType   = "approve";
        _confirmModal.Show();
    }

    private void ShowRejectModal()
    {
        modalTitle   = "Reject Upgrade";
        modalMessage = "Are you sure you want to reject this request? This action cannot be undone.";
        actionType   = "reject";
        _confirmModal.Show();
    }

    private async Task ConfirmAction()
    {
        if (isProcessing) return;
        isProcessing = true;
        StateHasChanged();
        try
        {
            var url = actionType == "approve"
                ? $"v1/admin/upgrade-requests/{RequestId}/approve"
                : $"v1/admin/upgrade-requests/{RequestId}/reject";

            var response = await _httpClient.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                _confirmModal.Hide();
                string successMsg = actionType == "approve"
                    ? MessageResponse.RequestManagement.UpgradeRequest.APPROVE_SUCCESS
                    : MessageResponse.RequestManagement.UpgradeRequest.REJECT_SUCCESS;
                Snackbar.Add(successMsg, Severity.Success);
                await LoadRequestAsync();
            }
            else
            {
                Snackbar.Add(MessageResponse.Common.ERROR_IN_SERVER, Severity.Error);
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}