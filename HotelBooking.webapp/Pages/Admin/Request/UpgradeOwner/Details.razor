@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Request\UpgradeOwner\Details.razor *@
@page "/admin/requests/upgrade-owner/{RequestId:int}"
@using HotelBooking.webapp.ViewModels
@using HotelBooking.webapp.ViewModels.Request
@using System.Net.Http.Headers

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Request Details #@RequestId</PageTitle>

<div class="container-fluid py-4 details-page-animate force-gpu">
    @* --- Navigation & Header --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 header-glass p-3 shadow-sm">
        <div class="d-flex align-items-center">
            <button class="btn-glass-back me-3 force-gpu" @onclick="GoBack">
                <i class="fas fa-arrow-left"></i>
            </button>
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/admin/requests/upgrade-owner"
                                                           class="text-primary text-decoration-none fw-bold">Requests</a></li>
                            <li class="breadcrumb-item active">Details</li>
                        </ol>
                    </nav>
                    <h4 class="mb-0 fw-bold text-dark">Upgrade Request <span class="text-primary">#@RequestId</span></h4>
                </div>
            </div>

            @if (request != null && request.Status == "Pending")
            {
                <div class="action-header-btns animate__animated animate__fadeInRight">
                    <button class="btn-glass-success me-2 shadow-sm force-gpu" @onclick="ShowApproveModal">
                        <i class="fas fa-check me-2"></i>Approve
                    </button>
                    <button class="btn-glass-danger shadow-sm force-gpu" @onclick="ShowRejectModal">
                        <i class="fas fa-times me-2"></i>Reject
                    </button>
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="glass-loader-wrapper">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                <p class="mt-3 fw-bold text-primary">Fetching partner data...</p>
            </div>
        }
        else if (request == null)
        {
            <div class="glass-alert-warning force-gpu shadow-sm">
                <i class="fas fa-exclamation-triangle me-3"></i>
                <span>Request not found or has been removed from the system.</span>
            </div>
        }
        else
        {
            <div class="row g-4">
                @* --- Left Column: User Information --- *@
                <div class="col-lg-6">
                    <div class="glass-card-info h-100 shadow-sm force-gpu">
                        <div class="glass-card-header-inner blue">
                            <i class="fas fa-user-circle me-2"></i>User Profile
                        </div>
                        <div class="glass-card-body-inner">
                            <div class="info-group">
                                <label class="info-label">Username</label>
                                <div class="info-value-box text-muted">@@@request.UserName</div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Full Name</label>
                                <div class="info-value-box fw-bold text-dark">@request.FullName</div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Email Address</label>
                                <div class="info-value-box">
                                    <a href="mailto:@request.Email"
                                       class="text-primary fw-bold text-decoration-none">@request.Email</a>
                                </div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Phone Number</label>
                                <div class="info-value-box fw-bold">@request.PhoneNumber</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- Right Column: Request Information --- *@
                <div class="col-lg-6">
                    <div class="glass-card-info h-100 shadow-sm force-gpu">
                        <div class="glass-card-header-inner cyan">
                            <i class="fas fa-file-invoice me-2"></i>Business Details
                        </div>
                        <div class="glass-card-body-inner">
                            <div class="info-group">
                                <label class="info-label">Current Review Status</label>
                                <div class="badge-container-glass">
                                    <span
                                        class="status-pill-modern badge-fixed-layout @GetStatusBadgeClass(request.Status) force-gpu">
                                        <i class="@GetStatusIcon(request.Status) me-2"></i>@request.Status.ToUpper()
                                    </span>
                                </div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Tax Identification Number</label>
                                <div class="info-value-box tax-code-style">@request.TaxCode</div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Registered Business Address</label>
                                <div class="info-value-box address-area">@request.Address</div>
                            </div>
                            <div class="info-group">
                                <label class="info-label">Submission Timestamp</label>
                                <div class="info-value-box text-muted small">@request.RequestedAt.ToString("MMMM dd, yyyy - HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- History Section --- *@
                @if (request.Status != "Pending")
                {
                    <div class="col-12 mt-2">
                        <div class="glass-card-history shadow-sm force-gpu @GetStatusBorderClass(request.Status)">
                            <div class="d-flex align-items-center p-4">
                                <div class="history-icon-circle @GetStatusTextClass(request.Status)">
                                    <i class="@GetStatusIcon(request.Status) fa-2x"></i>
                                </div>
                                <div class="ms-4">
                                    <h5 class="fw-bold mb-1 @GetStatusTextClass(request.Status)">
                                        This request was @request.Status.ToUpper()
                                    </h5>
                                    <div class="text-muted small">
                                        <span class="me-3"><i class="fas fa-calendar-check me-1"></i>
                                            @request.ProcessedAt?.ToString("g")</span>
                                            <span><i class="fas fa-user-shield me-1"></i> Auditor:
                                                <strong>@request.ProcessedByName</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* --- CONFIRMATION MODAL --- *@
            <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content glass-modal force-gpu">
                        <div class="modal-header border-0 @modalHeaderClass text-white glass-modal-header shadow-sm">
                            <h5 class="modal-title fw-bold">
                                <i class="@modalIcon me-2"></i>@modalTitle
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4 text-center">
                            <div class="mb-3">
                                <i
                                class="@modalIcon fa-3x @(actionType == "approve" ? "text-success" : "text-danger") opacity-25"></i>
                            </div>
                            <p class="text-dark fw-bold fs-5">@modalMessage</p>
                            <p class="text-muted small">Target Request: <strong>#@RequestId</strong></p>
                        </div>
                        <div class="modal-footer border-0 pb-4 justify-content-center gap-2">
                            <button type="button" class="btn-glass-cancel px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn @modalBtnClass px-4 shadow-sm fw-bold" @onclick="ConfirmAction"
                                    disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Confirm Action
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                /* --- LAYOUT STYLES --- */
                .details-page-animate {
                    animation: fadeIn 0.5s ease-out;
                }

                .header-glass {
                    background: var(--glass-bg);
                    backdrop-filter: var(--glass-blur);
                    border: 1px solid var(--glass-border);
                    border-radius: 20px;
                }

                .glass-card-info {
                    background: var(--glass-bg);
                    border: 1px solid var(--glass-border);
                    border-radius: 24px;
                    overflow: hidden;
                }

                /* --- INFO ELEMENTS --- */
                .glass-card-header-inner {
                    padding: 1.25rem 1.5rem;
                    font-weight: 800;
                    font-size: 0.85rem;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    color: white;
                }

                .glass-card-header-inner.blue {
                    background: linear-gradient(135deg, #3a7bd5, #00d2ff);
                }

                .glass-card-header-inner.cyan {
                    background: linear-gradient(135deg, #0891b2, #06b6d4);
                }

                .glass-card-body-inner {
                    padding: 2rem;
                }

                .info-group {
                    margin-bottom: 1.5rem;
                }

                .info-label {
                    font-size: 0.7rem;
                    font-weight: 800;
                    color: var(--text-muted);
                    text-transform: uppercase;
                    margin-bottom: 8px;
                    display: block;
                }

                .info-value-box {
                    color: var(--text-dark);
                    font-size: 1rem;
                    font-weight: 600;
                    padding: 12px 16px;
                    background: #fff;
                    border: 1.5px solid #e2e8f0;
                    border-radius: 12px;
                }

                .tax-code-style {
                    font-family: 'JetBrains Mono', monospace;
                    color: var(--admin-blue);
                    background: rgba(58, 123, 213, 0.05);
                }

                /* --- BUTTONS --- */
                .btn-glass-back {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    border: 1.5px solid #e2e8f0;
                    background: #fff;
                    color: var(--text-muted);
                    transition: 0.3s;
                }

                .btn-glass-back:hover {
                    background: #f8fafc;
                    color: var(--text-dark);
                    transform: translateX(-3px);
                }

                .btn-glass-success {
                    background: var(--color-success);
                    color: #fff;
                    border: none;
                    padding: 10px 24px;
                    border-radius: 12px;
                    font-weight: 700;
                    transition: 0.3s;
                }

                .btn-glass-danger {
                    background: var(--color-danger);
                    color: #fff;
                    border: none;
                    padding: 10px 24px;
                    border-radius: 12px;
                    font-weight: 700;
                    transition: 0.3s;
                }

                /* --- MODAL STYLES --- */
                .glass-modal {
                    background: rgba(255, 255, 255, 0.95) !important;
                    backdrop-filter: blur(20px);
                    border-radius: 28px !important;
                    border: 1px solid var(--glass-border) !important;
                    overflow: hidden;
                }

                .glass-modal-header {
                    padding: 1.5rem;
                }

                .btn-glass-cancel {
                    background: #f1f5f9;
                    border: 1.5px solid #e2e8f0;
                    color: var(--text-muted);
                    border-radius: 12px;
                    font-weight: 700;
                    padding: 10px 20px;
                    transition: 0.3s;
                }

                .btn-glass-cancel:hover {
                    background: #e2e8f0;
                    color: var(--text-dark);
                }

                .badge-fixed-layout {
                    display: inline-flex !important;
                    align-items: center !important;
                    justify-content: center !important;
                    line-height: 1 !important;
                    min-height: 32px;
                    padding: 0 16px !important;
                    white-space: nowrap;
                    border-radius: 50px;
                    font-weight: 800;
                    font-size: 0.7rem;
                    letter-spacing: 0.5px;
                    text-transform: uppercase;
                    border: 1px solid transparent;
                }

                .badge-container-glass {
                    background: #ffffff;
                    border: 1.5px solid #e2e8f0;
                    border-radius: 12px;
                    padding: 8px 12px;
                    display: flex;
                    align-items: center;
                    min-height: 52px;
                    transition: border-color 0.3s;
                }

                .badge-container-glass:hover {
                    border-color: var(--admin-blue);
                }

                .status-pill-modern.bg-warning {
                    background: #fffbeb !important;
                    color: #92400e !important;
                    border-color: #fde68a !important;
                }

                .status-pill-modern.bg-success {
                    background: #f0fdf4 !important;
                    color: #15803d !important;
                    border-color: #bbf7d0 !important;
                }

                .status-pill-modern.bg-danger {
                    background: #fef2f2 !important;
                    color: #991b1b !important;
                    border-color: #fecaca !important;
                }

                /* --- HISTORY --- */
                .glass-card-history {
                    background: var(--glass-bg);
                    border-radius: 20px;
                    border-left: 6px solid #cbd5e1;
                }

                .border-success-thick {
                    border-left-color: var(--color-success) !important;
                    background: rgba(16, 185, 129, 0.05);
                }

                .border-danger-thick {
                    border-left-color: var(--color-danger) !important;
                    background: rgba(244, 63, 94, 0.05);
                }

                @@keyframes fadeIn {
                    from {
                        opacity: 0;
                        transform: translateY(15px);
                    }

                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }
            </style>

@code {
    [Parameter] public int RequestId { get; set; }
    private HttpClient _httpClient = null!;
    private UpgradeRequestVM? request;
    private bool isLoading = true;
    private bool isProcessing = false;

    // Modal State Variables
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalHeaderClass = "";
    private string modalBtnClass = "";
    private string modalIcon = "";
    private string actionType = "";

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await LoadRequestAsync();
    }

    private async Task LoadRequestAsync()
    {
        isLoading = true;
        try
        {
            var response = await _httpClient.GetAsync($"v1/admin/upgrade-requests/{RequestId}");
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();
                request = apiResponse?.Content;
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        finally { isLoading = false; }
    }

    private void GoBack() => NavigationManager.NavigateTo("/admin/requests/upgrade-owner");

    private async Task ShowApproveModal()
    {
        modalTitle = "Approve Upgrade";
        modalMessage = "Are you sure you want to approve this request? The user will be immediately granted the Owner role.";
        modalHeaderClass = "bg-success";
        modalBtnClass = "btn-success";
        modalIcon = "fas fa-check-circle";
        actionType = "approve";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ShowRejectModal()
    {
        modalTitle = "Reject Upgrade";
        modalMessage = "Are you sure you want to reject this request? This action cannot be undone.";
        modalHeaderClass = "bg-danger";
        modalBtnClass = "btn-danger";
        modalIcon = "fas fa-times-circle";
        actionType = "reject";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ConfirmAction()
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            var url = actionType == "approve"
                                                                            ? $"v1/admin/upgrade-requests/{RequestId}/approve"
            : $"v1/admin/upgrade-requests/{RequestId}/reject";

            var response = await _httpClient.PostAsync(url, null);

            // Close modal using JS
            await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide()");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Request successfully {actionType}ed!", Severity.Success);
                await LoadRequestAsync();
            }
            else
            {
                Snackbar.Add("An error occurred while processing the request.", Severity.Error);
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // Helper Methods
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning",
        "Approved" =>
        "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
    private string GetStatusBorderClass(string status) => status switch { "Approved" => "border-success-thick", "Rejected" => "border-danger-thick", _ => "" };
    private string GetStatusTextClass(string status) => status switch
    {
        "Approved" => "text-success",
        "Rejected" =>
        "text-danger",
        _ => "text-secondary"
    };
    private string GetStatusIcon(string status) => status switch { "Pending" => "fas fa-hourglass-half", "Approved" => "fas fa-check-circle", "Rejected" => "fas fa-times-circle", _ => "fas fa-question-circle" };
}