@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Request\UpgradeOwner\Index.razor *@

@page "/admin/requests/upgrade-owner"
@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Services.Interface
@inherits AdminPageBase<IRequestService>

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="container-fluid py-4 page-content-animate force-gpu">
    <PageTitle>Upgrade Owner Requests</PageTitle>

    @* --- Header Section --- *@
    <div class="text-center mb-5">
        <h2 class="main-title">Upgrade Owner Requests</h2>
        <p class="text-muted small text-uppercase fw-bold" style="letter-spacing: 1px;">Manage and verify partner
            registration requests</p>
            <div class="title-underline"></div>
        </div>

        @* Summary Statistics Cards *@
        <div class="mb-4">
            <UpgradeStatsCard Stats="@stats" OnStatusClick="FilterByStatus" SelectedStatus="@selectedStatus" />
        </div>

        @* Advanced Filtering Section *@
        <div class="glass-filter-wrapper mb-4 shadow-sm">
            <UpgradeFilters SearchTerm="@searchTerm" SelectedStatus="@selectedStatus" PageSize="@pageSize"
                            StatusList="@statusList" SearchTermChanged="OnSearchTermChanged"
                            SelectedStatusChanged="OnSelectedStatusChanged" PageSizeChanged="OnPageSizeChanged" OnApply="ApplyFilters"
                            OnReset="ResetFilters" />
        </div>

        @* Data Management Table (Wrapped in Glass Container) *@
        <div class="glass-table-container shadow-sm overflow-hidden">
            <UpgradeTable Requests="@FilteredRequests" IsLoading="@isLoading" CurrentPage="@currentPage"
                          PageSize="@pageSize" TotalCount="@totalCount" OnView="ViewDetails" OnApprove="ShowApproveModal"
                          OnReject="ShowRejectModal" SelectedStatus="@selectedStatus" SearchTerm="@searchTerm" />

            @* Integration of Pagination inside table area for a cleaner look *@
            <div class="glass-footer p-3 border-top bg-light-glass d-flex justify-content-center">
                <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount"
                            IsLoading="@isLoading" OnPageChange="GoToPage" />
            </div>
        </div>
    </div>

    @* --- Action Confirmation Modal (Glass Style) --- *@
    <ConfirmModal @ref="_confirmModal" Title="@modalTitle" Message="@modalMessage"
                  ConfirmText="@(actionType == "approve" ? "Confirm Approve" : "Confirm Reject")"
                  ConfirmIcon="@(actionType == "approve" ? "fa-check" : "fa-trash-can")"
                  ConfirmButtonClass="@(actionType == "approve" ? "btn-glass-confirm-success" : "btn-glass-confirm-danger")"
                  IsProcessing="@isProcessing" OnConfirm="ConfirmAction">


        @if (selectedRequest != null)
        {
            <div class="selected-request-info-box mt-3 text-start">
                <div class="info-item">
                    <span class="label">REQUEST ID</span>
                    <span class="value text-primary">#@selectedRequest.RequestId</span>
                </div>
                <div class="info-item">
                    <span class="label">PARTNER NAME</span>
                    <span class="value">@selectedRequest.FullName</span>
                </div>
                <div class="info-item">
                    <span class="label">USERNAME</span>
                    <span class="value text-muted">@@@selectedRequest.UserName</span>
                </div>
            </div>
        }
    </ConfirmModal>

    <style>
        /* --- LAYOUT & THEME --- */
        .page-content-animate {
            animation: fadeInUp 0.5s ease-out;
        }

        .main-title {
            color: var(--text-dark);
            font-family: 'DM Serif Display', serif;
            font-size: 2.5rem;
        }

        .title-underline {
            width: 60px;
            height: 4px;
            background: var(--admin-primary-gradient);
            margin: 1rem auto;
            border-radius: 10px;
        }

        /* --- GLASS CONTAINERS --- */
        .glass-filter-wrapper,
        .glass-table-container {
            background: var(--glass-bg);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
        }

        .bg-light-glass {
            background: rgba(0, 0, 0, 0.02);
        }

        /* --- MODAL GLASS STYLE --- */
        .glass-modal {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(20px);
            border-radius: 28px !important;
            border: 1px solid var(--glass-border) !important;
        }

        .glass-modal-header {
            border-radius: 28px 28px 0 0 !important;
            padding: 1.5rem;
        }

        .selected-request-info-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 1.25rem;
            border-radius: 16px;
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 0.85rem;
        }

        .info-item .label {
            color: var(--text-muted);
            font-weight: 800;
            font-size: 0.7rem;
        }

        .info-item .value {
            color: var(--text-dark);
            font-weight: 700;
        }

        /* --- BUTTONS --- */
        .btn-glass-cancel {
            background: #fff;
            border: 1.5px solid #e2e8f0;
            color: var(--text-muted);
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 700;
            transition: 0.3s;
        }

        .btn-glass-cancel:hover {
            background: #f1f5f9;
            color: var(--text-dark);
        }

        .glass-btn-confirm {
            padding: 10px 30px;
            border-radius: 12px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>

@code {
    // Modal Reference
    private ConfirmModal _confirmModal = default!;


    private CancellationTokenSource _cts = new();
    private List<UpgradeRequestVM> requests = new();
    private List<string> statusList = new() { "Pending", "Approved", "Rejected", "Cancelled" };
    private RequestTypeStatsVM stats = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalCount = 0;
    private string searchTerm = "";
    private string? selectedStatus = null;

    private bool isLoading = false;
    private bool isProcessing = false;

    private UpgradeRequestVM? selectedRequest;
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalHeaderClass = "bg-primary";
    private string modalBtnClass = "btn-primary";
    private string modalIcon = "fas fa-question-circle";
    private string actionType = "";

    private IEnumerable<UpgradeRequestVM> FilteredRequests => string.IsNullOrWhiteSpace(searchTerm)
    ? requests
    : requests.Where(r =>
    r.RequestId.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
    (r.UserName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
    (r.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
    (r.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
    (r.TaxCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
    (r.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
    );

    protected override async Task LoadDataAsync()
    {
        await LoadStatsAsync();
        await LoadRequestsAsync();
    }

    public override void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        base.Dispose();
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var response = await Service.GetStatsAsync();
            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
                stats = response.Content.UpgradeRequest;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER);
        }
    }

    private async Task LoadRequestsAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var response = await Service.GetUpgradeRequestsAsync(currentPage, pageSize, selectedStatus);
            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
            {
                requests = response.Content.Items;
                totalPages = response.Content.TotalPages;
                totalCount = response.Content.TotalCount;
            }
            else
            {
                requests = new();
                SnackbarHelper.Show(Snackbar, response.StatusCode ?? StatusCodeResponse.Error, response.Message ??
                MessageResponse.Common.ERROR_IN_SERVER);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER);
            requests = new();
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    private void OnSearchTermChanged(string value) => searchTerm = value;

    private async Task OnSelectedStatusChanged(string? value)
    {
        selectedStatus = value;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task OnPageSizeChanged(int value)
    {
        pageSize = value;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task FilterByStatus(string? status)
    {
        selectedStatus = status;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task ApplyFilters() { currentPage = 1; await LoadRequestsAsync(); }

    private async Task ResetFilters()
    {
        searchTerm = "";
        selectedStatus = null;
        pageSize = 10;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadRequestsAsync();
        }
    }

    private void ViewDetails(UpgradeRequestVM request) =>
    Navigation.NavigateTo($"/admin/requests/upgrade-owner/{request.RequestId}");

    private void ShowApproveModal(UpgradeRequestVM request)
    {
        selectedRequest = request;
        modalTitle = "Confirm Approval";
        modalMessage = "Are you sure you want to APPROVE this request? The user will be upgraded to Owner role.";
        actionType = "approve";

        _confirmModal.Show();
    }

    private void ShowRejectModal(UpgradeRequestVM request)
    {
        selectedRequest = request;
        modalTitle = "Confirm Rejection";
        modalMessage = "Are you sure you want to REJECT this request?";
        actionType = "reject";

        _confirmModal.Show();
    }

    private async Task ConfirmAction()
    {
        if (selectedRequest == null) return;
        isProcessing = true;
        StateHasChanged();
        try
        {
            var response = actionType == "approve"
            ? await Service.ApproveUpgradeRequestAsync(selectedRequest.RequestId)
            : await Service.RejectUpgradeRequestAsync(selectedRequest.RequestId);

            if (response.StatusCode == StatusCodeResponse.Success)
            {
                string successMsg = actionType == "approve" ? "Approved successfully!" : "Rejected successfully!";
                SnackbarHelper.Show(Snackbar, response.StatusCode ?? StatusCodeResponse.Success, response.Message ?? successMsg);

                _confirmModal.Hide();

                currentPage = 1;

                await LoadDataAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception) { SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER); }
        finally { isProcessing = false; StateHasChanged(); }
    }
}
