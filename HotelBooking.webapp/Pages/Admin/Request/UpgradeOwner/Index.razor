@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Request\UpgradeOwner\Index.razor *@

@page "/admin/requests/upgrade-owner"
@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.Pages.Admin.Base
@using HotelBooking.webapp.Services.Interface
@using Microsoft.Extensions.Logging
@inherits AdminPageBase<IRequestService>

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="container-fluid py-4 page-content-animate">
    <PageTitle>Upgrade Owner Requests</PageTitle>

    @* --- Header Section --- *@
    <div class="text-center mb-5">
        <h2 class="fw-extrabold main-title">Upgrade Owner Requests</h2>
        <p class="text-muted">Manage and verify partner registration requests</p>
        <div class="title-underline"></div>
    </div>

    @* Summary Statistics Cards *@
    <UpgradeStatsCard Stats="@stats" OnStatusClick="FilterByStatus" SelectedStatus="@selectedStatus" />

    @* Advanced Filtering Section *@
    <UpgradeFilters SearchTerm="@searchTerm" SelectedStatus="@selectedStatus" PageSize="@pageSize"
                    StatusList="@statusList" SearchTermChanged="OnSearchTermChanged" SelectedStatusChanged="OnSelectedStatusChanged"
                    PageSizeChanged="OnPageSizeChanged" OnApply="ApplyFilters" OnReset="ResetFilters" />

    @* Data Management Table *@
    <div class="table-container-glass">
        <UpgradeTable Requests="@FilteredRequests" IsLoading="@isLoading" CurrentPage="@currentPage"
                      PageSize="@pageSize" TotalCount="@totalCount" OnView="ViewDetails" OnApprove="ShowApproveModal"
                      OnReject="ShowRejectModal" SelectedStatus="@selectedStatus" SearchTerm="@searchTerm" />
    </div>

    @* Standard Pagination *@
    <div class="mt-4 d-flex justify-content-center">
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" IsLoading="@isLoading"
                    OnPageChange="GoToPage" />
    </div>
</div>

@* --- Action Confirmation Modal (Glass Style) --- *@
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal">
            <div class="modal-header border-0 @modalHeaderClass text-white glass-modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="@modalIcon me-2"></i>@modalTitle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dark fw-medium fs-6">@modalMessage</p>
                @if (selectedRequest != null)
                {
                    <div class="selected-request-info">
                        <div class="info-row">
                            <span class="label">Request ID:</span>
                            <span class="value text-primary">#@selectedRequest.RequestId</span>
                        </div>
                        <div class="info-row">
                            <span class="label">User:</span>
                            <span class="value">@selectedRequest.FullName (@selectedRequest.UserName)</span>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer border-0 pb-4">
                <button type="button" class="btn-glass-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn @modalBtnClass glass-btn-confirm" @onclick="ConfirmAction"
                        disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <span>Confirm Action</span>
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .page-content-animate {
        animation: fadeInUp 0.6s ease;
    }

    /* Typography */
    .main-title {
        color: #1e293b;
        font-family: 'DM Serif Display', serif;
        font-size: 2.5rem;
        letter-spacing: -0.5px;
        margin-bottom: 0.25rem;
    }

    .title-underline {
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, #00d2ff, #3a7bd5);
        margin: 1.5rem auto;
        border-radius: 10px;
    }

    /* Modal Glass Style */
    .glass-modal {
        background: rgba(255, 255, 255, 0.9) !important;
        backdrop-filter: blur(20px);
        border-radius: 28px !important;
        border: 1px solid rgba(255, 255, 255, 0.4) !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
    }

    .glass-modal-header {
        border-radius: 28px 28px 0 0 !important;
        padding: 1.5rem;
    }

    .selected-request-info {
        background: rgba(0, 96, 230, 0.05);
        border: 1px solid rgba(0, 96, 230, 0.1);
        padding: 1rem;
        border-radius: 16px;
        margin-top: 1rem;
    }

    .info-row {
        display: flex;
        gap: 10px;
        margin-bottom: 4px;
        font-size: 0.9rem;
    }

    .info-row .label {
        color: #64748b;
        font-weight: 600;
        min-width: 90px;
    }

    .info-row .value {
        color: #1e293b;
        font-weight: 700;
    }

    /* Buttons in Modal */
    .btn-glass-cancel {
        background: #f1f5f9;
        border: none;
        color: #64748b;
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-glass-cancel:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .glass-btn-confirm {
        padding: 10px 30px;
        border-radius: 12px;
        font-weight: 700;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    /* Table Container padding */
    .table-container-glass {
        margin-top: 1.5rem;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private CancellationTokenSource _cts = new();

    // Data Collections
    private List<UpgradeRequestVM> requests = new();
    private List<string> statusList = new() { "Pending", "Approved", "Rejected", "Cancelled" };
    private RequestTypeStatsVM stats = new();

    // Pagination & Filter State
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 0;
    private int totalCount = 0;
    private string searchTerm = "";
    private string? selectedStatus = null;

    // Loading States
    private bool isLoading = false;
    private bool isProcessing = false;

    // Modal Configuration
    private UpgradeRequestVM? selectedRequest;
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalHeaderClass = "bg-primary";
    private string modalBtnClass = "btn-primary";
    private string modalIcon = "fas fa-question-circle";
    private string actionType = "";

    // Reactive Client-side search logic
    private IEnumerable<UpgradeRequestVM> FilteredRequests => string.IsNullOrWhiteSpace(searchTerm)
        ? requests
        : requests.Where(r =>
            r.RequestId.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (r.UserName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.TaxCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (r.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
        );

    // ==========================================
    // LIFECYCLE OVERRIDES
    // ==========================================

    /// <summary>
    /// Overrides LoadDataAsync from AdminPageBase.
    /// Automatically invoked once the authentication token is validated.
    /// </summary>
    protected override async Task LoadDataAsync()
    {
        await LoadStatsAsync();
        await LoadRequestsAsync();
    }

    public override void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        base.Dispose();
    }

    // ==========================================
    // DATA ACQUISITION
    // ==========================================

    private async Task LoadStatsAsync()
    {
        try
        {
            var response = await Service.GetStatsAsync();
            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
            {
                stats = response.Content.UpgradeRequest;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER);
        }
    }

    private async Task LoadRequestsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await Service.GetUpgradeRequestsAsync(currentPage, pageSize, selectedStatus);

            if (response.StatusCode == StatusCodeResponse.Success && response.Content != null)
            {
                requests = response.Content.Items;
                totalPages = response.Content.TotalPages;
                totalCount = response.Content.TotalCount;
            }
            else
            {
                requests = new();
                SnackbarHelper.Show(Snackbar, response.StatusCode ?? StatusCodeResponse.Error,
                    response.Message ?? MessageResponse.Common.ERROR_IN_SERVER);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER);
            requests = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ==========================================
    // UI EVENT HANDLERS
    // ==========================================

    private void OnSearchTermChanged(string value) => searchTerm = value;

    private async Task OnSelectedStatusChanged(string? value)
    {
        selectedStatus = value;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task OnPageSizeChanged(int value)
    {
        pageSize = value;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task FilterByStatus(string? status)
    {
        selectedStatus = status;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task ResetFilters()
    {
        searchTerm = "";
        selectedStatus = null;
        pageSize = 10;
        currentPage = 1;
        await LoadRequestsAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages && page != currentPage)
        {
            currentPage = page;
            await LoadRequestsAsync();
        }
    }

    // ==========================================
    // ACTION WORKFLOWS
    // ==========================================

    private void ViewDetails(UpgradeRequestVM request)
    {
        Navigation.NavigateTo($"/admin/requests/upgrade-owner/{request.RequestId}");
    }

    private async Task ShowApproveModal(UpgradeRequestVM request)
    {
        selectedRequest = request;
        modalTitle = "Confirm Approval";
        modalMessage = "Are you sure you want to APPROVE this request? The user will be upgraded to Owner role.";
        modalHeaderClass = "bg-success";
        modalBtnClass = "btn-success";
        modalIcon = "fas fa-check-circle";
        actionType = "approve";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ShowRejectModal(UpgradeRequestVM request)
    {
        selectedRequest = request;
        modalTitle = "Confirm Rejection";
        modalMessage = "Are you sure you want to REJECT this request?";
        modalHeaderClass = "bg-danger";
        modalBtnClass = "btn-danger";
        modalIcon = "fas fa-times-circle";
        actionType = "reject";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmModal')).show()");
    }

    private async Task ConfirmAction()
    {
        if (selectedRequest == null) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = actionType == "approve"
                ? await Service.ApproveUpgradeRequestAsync(selectedRequest.RequestId)
                : await Service.RejectUpgradeRequestAsync(selectedRequest.RequestId);

            SnackbarHelper.Show(Snackbar, response.StatusCode ?? StatusCodeResponse.Error,
                response.Message ?? MessageResponse.Common.ERROR_IN_SERVER);

            if (response.StatusCode == StatusCodeResponse.Success)
            {
                await JSRuntime.InvokeVoidAsync("eval",
                    "bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide()");
                await LoadStatsAsync();
                await LoadRequestsAsync();
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}