@* Filepath: HotelBooking.webapp\Pages\Admin\Request\RequestDetails.razor *@
@page "/admin/requests/details/{RequestId:int}"
@page "/admin/upgrade-requests/{RequestId:int}"
@implements IDisposable
@using System.Net.Http.Headers
@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.ViewModels.Request

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<PageTitle>Request Review #@RequestId</PageTitle>

<div class="details-wrapper animate__animated animate__fadeIn force-gpu">
    <div class="glass-card-detail shadow-lg force-gpu">
        @* --- Header Section --- *@
        <div class="glass-header-detail shadow-sm">
            <div class="header-info">
                <span class="request-id-badge force-gpu">#@RequestId</span>
                <h2 class="detail-title">Request Review</h2>
                <p class="text-muted small mb-0 mt-1 uppercase-tracking">Review partner upgrade application</p>
            </div>
            <button class="btn-back-glass shadow-sm force-gpu" @onclick="NavigateBack">
                <i class="fas fa-arrow-left me-2"></i> <span>Back to Dashboard</span>
            </button>
        </div>

        @* --- Body Section --- *@
        <div class="glass-body-detail">
            @if (request != null)
            {
                <div class="info-grid">
                    @* Group: Personal Information *@
                    <div class="info-section-glass mb-4 shadow-sm force-gpu">
                        <h5 class="section-label"><i class="fas fa-user-circle"></i> Personal Identity</h5>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="custom-form-label">Username</label>
                                <div class="readonly-value">@@@request.UserName</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-form-label">Full Name</label>
                                <div class="readonly-value fw-bold">@request.FullName</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-form-label">Phone Number</label>
                                <div class="readonly-value text-primary fw-bold">@request.PhoneNumber</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-form-label">Application Date</label>
                                <div class="readonly-value">@request.RequestedAt.ToString("dd MMM yyyy, HH:mm")</div>
                            </div>
                        </div>
                    </div>

                    @* Group: Business Information *@
                    <div class="info-section-glass shadow-sm force-gpu">
                        <h5 class="section-label"><i class="fas fa-briefcase"></i> Professional Details</h5>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="custom-form-label">Tax Identification (TIN)</label>
                                <div class="readonly-value tax-code-highlight">@request.TaxCode</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-form-label">Verification Status</label>
                                <div class="status-badge-container mt-1">
                                    @* FIX: Use badge-fixed-layout class for alignment and text color *@
                                    <span
                                        class="status-pill-modern badge-fixed-layout @GetStatusBadgeClass(request.Status) force-gpu">
                                        <i class="@GetStatusIcon(request.Status) me-2"></i> @request.Status.ToUpper()
                                    </span>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="custom-form-label">Registered Office Address</label>
                                <div class="readonly-value address-box">@request.Address</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- Actions Section --- *@
                @if (request.Status == "Pending")
                {
                    <div class="action-footer mt-5 animate__animated animate__slideInUp">
                        <button class="btn-action approve shadow force-gpu" @onclick="ShowApproveModal"
                                disabled="@isProcessing">
                            <i class="fas fa-check-circle me-2"></i>APPROVE PARTNER
                        </button>
                        <button class="btn-action reject shadow force-gpu" @onclick="ShowRejectModal" disabled="@isProcessing">
                            <i class="fas fa-times-circle me-2"></i>REJECT REQUEST
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="loader-container-center">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3 fw-bold text-primary tracking-wider">FETCHING SECURE DATA...</p>
                </div>
            }
        </div>
    </div>
</div>

@* --- SHARED CONFIRMATION MODAL --- *@
<ConfirmModal @ref="_confirmModal" Title="@modalTitle" Message="@modalMessage"
              ConfirmText="@(actionType == "approve" ? "Confirm Approve" : "Confirm Reject")"
              ConfirmIcon="@(actionType == "approve" ? "fa-check" : "fa-trash-can")"
              ConfirmButtonClass="@(actionType == "approve" ? "btn-success glass-btn-confirm text-white" : "btn-glass-confirm-danger")"
              IsProcessing="@isProcessing" OnConfirm="ConfirmAction">

    <div class="mt-3 p-2 rounded" style="background: rgba(0,0,0,0.03);">
        <p class="text-muted small mb-0 text-center">
            Reference Request: <strong class="text-primary fs-6">#@RequestId</strong>
        </p>
    </div>
</ConfirmModal>

<style>
    /* --- STYLES REFINED --- */
    .details-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 3rem 1.5rem;
        min-height: calc(100vh - 120px);
    }

    .glass-card-detail {
        width: 100%;
        max-width: 900px;
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        border-radius: 32px;
        border: 1px solid var(--glass-border);
        overflow: hidden;
    }

    .glass-header-detail {
        padding: 2.5rem;
        background: var(--glass-header);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(0, 0, 0, 0.02);
    }

    .detail-title {
        font-family: 'DM Serif Display', serif;
        color: var(--text-dark);
        font-size: 2rem;
        margin: 0;
    }

    .request-id-badge {
        background: var(--admin-blue);
        color: white;
        padding: 4px 14px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.8rem;
    }

    .glass-body-detail {
        padding: 3rem;
    }

    .info-section-glass {
        background: rgba(255, 255, 255, 0.4);
        border-radius: 24px;
        padding: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .section-label {
        font-weight: 800;
        color: var(--text-dark);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .section-label i {
        color: var(--admin-blue);
    }

    .custom-form-label {
        font-size: 0.7rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
    }

    .readonly-value {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        padding: 12px 16px;
        border-radius: 14px;
        color: var(--text-dark);
        font-weight: 600;
        font-size: 1rem;
        min-height: 50px;
        display: flex;
        align-items: center;
    }

    .tax-code-highlight {
        font-family: 'JetBrains Mono', monospace;
        color: var(--admin-blue);
        background: rgba(58, 123, 213, 0.05);
    }

    .address-box {
        min-height: 90px;
        line-height: 1.5;
        align-items: flex-start;
        padding-top: 12px;
    }

    /* Fix Badge Color Contrast */
    .badge-fixed-layout {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        line-height: 1 !important;
        min-height: 36px;
        padding: 0 20px !important;
        white-space: nowrap;
        border-radius: 50px;
        font-weight: 800;
        font-size: 0.75rem;
        border: 1px solid transparent;
    }

    .status-pill-modern.bg-primary {
        background: #e0f2fe !important;
        color: #0369a1 !important;
        border-color: #bae6fd !important;
    }

    .status-pill-modern.bg-success {
        background: #f0fdf4 !important;
        color: #15803d !important;
        border-color: #bbf7d0 !important;
    }

    .status-pill-modern.bg-danger {
        background: #fef2f2 !important;
        color: #991b1b !important;
        border-color: #fecaca !important;
    }

    .status-pill-modern.bg-secondary {
        background: #f1f5f9 !important;
        color: #475569 !important;
        border-color: #e2e8f0 !important;
    }

    /* Buttons */
    .action-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .btn-action {
        padding: 16px;
        border-radius: 18px;
        border: none;
        font-weight: 800;
        color: white;
        transition: 0.3s;
        letter-spacing: 0.5px;
    }

    .btn-action.approve {
        background: var(--admin-primary-gradient);
    }

    .btn-action.reject {
        background: linear-gradient(135deg, #f43f5e, #dc2626);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-3px);
        filter: brightness(1.1);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .glass-modal {
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(20px);
        border-radius: 28px !important;
        border: 1px solid var(--glass-border) !important;
        overflow: hidden;
    }

    .btn-glass-cancel {
        background: #f1f5f9;
        border: 1.5px solid #e2e8f0;
        color: var(--text-muted);
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 24px;
        transition: 0.3s;
    }

    .btn-back-glass {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        padding: 10px 24px;
        border-radius: 14px;
        font-weight: 700;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        transition: 0.2s;
    }

    .btn-back-glass:hover {
        background: #f8fafc;
        color: var(--text-dark);
        border-color: var(--admin-blue);
    }

    .uppercase-tracking {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }
</style>

@code {
    [Parameter] public int RequestId { get; set; }

    // Modal Reference
    private ConfirmModal _confirmModal = default!;

    // Data & State
    private HttpClient _httpClient = null!;
    private CancellationTokenSource _cts = new();
    private UpgradeRequestVM? request;
    private bool isProcessing = false;

    // Modal State
    private string modalTitle = "";
    private string modalMessage = "";
    private string actionType = "";

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await LoadRequestDetails();
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }

    private async Task LoadRequestDetails()
    {
        try
        {
            var response = await _httpClient.GetAsync($"v1/admin/upgrade-requests/{RequestId}", _cts.Token);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();
                request = apiResponse?.Content;
            }
        }
        catch (Exception) { SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, "Failed to load request."); }
    }

    private void NavigateBack() { NavigationManager.NavigateTo("/admin/requests/requests-overview"); }

    private async Task ShowApproveModal()
    {
        modalTitle = "Confirm Approval";
        modalMessage = "Are you sure you want to approve this partner? They will be granted full Owner permissions.";
        actionType = "approve";
        
        _confirmModal.Show();
    }

    private async Task ShowRejectModal()
    {
        modalTitle = "Confirm Rejection";
        modalMessage = "Are you sure you want to reject this request? The applicant will be notified.";
        actionType = "reject";
        
        _confirmModal.Show();
    }

    private async Task ConfirmAction()
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            var url = actionType == "approve" ? $"v1/admin/upgrade-requests/{RequestId}/approve" :
$"v1/admin/upgrade-requests/{RequestId}/reject";
            var response = await _httpClient.PostAsync(url, null, _cts.Token);

            if (response.IsSuccessStatusCode)
            {
                _confirmModal.Hide();

                string successMsg = actionType == "approve" ? MessageResponse.RequestManagement.UpgradeRequest.APPROVE_SUCCESS :
MessageResponse.RequestManagement.UpgradeRequest.REJECT_SUCCESS;
                Snackbar.Add(successMsg, Severity.Success);

                await LoadRequestDetails();
            }
        }
        catch (Exception) { SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error, MessageResponse.Common.ERROR_IN_SERVER); }
        finally { isProcessing = false; StateHasChanged(); }
    }

    // Helper methods
    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-primary",
        "Approved" =>
"bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
    private string GetStatusIcon(string status) => status switch { "Pending" => "fas fa-hourglass-half", "Approved" => "fas fa-check-circle", "Rejected" => "fas fa-times-circle", _ => "fas fa-question-circle" };
}