@* filepath: e:\Cybersoft\FinalProject\Hotel_Blazor\HotelBooking.webapp\Pages\Admin\Request\RequestDetails.razor *@
@page "/admin/requests/details/{RequestId:int}"
@page "/admin/upgrade-requests/{RequestId:int}"
@implements IDisposable
@using System.Net.Http.Headers
@using HotelBooking.webapp.Helpers.Common
@using HotelBooking.webapp.ViewModels.Request

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject ISnackbar Snackbar

<div class="details-wrapper animate__animated animate__fadeIn">
    <div class="glass-card-detail">
        @* --- Header Section --- *@
        <div class="glass-header-detail">
            <div class="header-info">
                <span class="request-id-badge">#@RequestId</span>
                <h2 class="detail-title">Request Review</h2>
            </div>
            <button class="btn-back-glass" @onclick="NavigateBack">
                <i class="fas fa-chevron-left"></i> <span>Back to List</span>
            </button>
        </div>

        @* --- Body Section --- *@
        <div class="glass-body-detail">
            @if (request != null)
            {
                <div class="info-grid">
                    @* Group: Personal Information *@
                    <div class="info-section">
                        <h5 class="section-label"><i class="fas fa-user-circle"></i> Personal Info</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="custom-label">Username</label>
                                <div class="readonly-value">@request.UserName</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-label">Full Name</label>
                                <div class="readonly-value">@request.FullName</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-label">Phone Number</label>
                                <div class="readonly-value">@request.PhoneNumber</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-label">Requested At</label>
                                <div class="readonly-value">@request.RequestedAt.ToString("dd MMM yyyy, HH:mm")</div>
                            </div>
                        </div>
                    </div>

                    @* Group: Business Information *@
                    <div class="info-section">
                        <h5 class="section-label"><i class="fas fa-briefcase"></i> Business Details</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="custom-label">Tax Code</label>
                                <div class="readonly-value">@request.TaxCode</div>
                            </div>
                            <div class="col-md-6">
                                <label class="custom-label">Current Status</label>
                                <div class="status-indicator @GetStatusBadgeClass(request.Status)">
                                    <span class="dot"></span> @request.Status
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="custom-label">Business Address</label>
                                <div class="readonly-value address-box">@request.Address</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- Actions Section --- *@
                @if (request.Status == "Pending")
                {
                    <div class="action-footer">
                        <button class="btn-action approve" @onclick="ApproveRequest" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {

                                <i class="fas fa-check-circle me-2"></i>
                            }
                            Approve Partner
                        </button>
                        <button class="btn-action reject" @onclick="RejectRequest" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            else
                            {

                                <i class="fas fa-times-circle me-2"></i>
                            }
                            Reject Request
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="loader-container">
                    <div class="custom-loader"></div>
                    <p>Fetching request data...</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Wrapper & Container */
    .details-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 2rem;
        min-height: calc(100vh - 100px);
    }

    .glass-card-detail {
        width: 100%;
        max-width: 850px;
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.7);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    /* Header Section */
    .glass-header-detail {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.3);
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-title {
        font-family: 'DM Serif Display', serif;
        color: #1e293b;
        margin: 0;
        font-size: 1.75rem;
    }

    .request-id-badge {
        background: #0060e6;
        color: white;
        padding: 4px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 5px;
        display: inline-block;
    }

    /* Info Sections */
    .glass-body-detail {
        padding: 2.5rem;
    }

    .info-section {
        background: rgba(255, 255, 255, 0.4);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .section-label {
        font-weight: 800;
        color: #334155;
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-label i {
        color: #0060e6;
    }

    .custom-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 6px;
        display: block;
    }

    .readonly-value {
        background: rgba(255, 255, 255, 0.8);
        border: 1.5px solid #e2e8f0;
        padding: 10px 14px;
        border-radius: 12px;
        color: #1e293b;
        font-weight: 600;
        min-height: 45px;
    }

    .address-box {
        min-height: 80px;
    }

    /* Status & Badges */
    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        color: white;
    }

    .status-indicator.bg-primary {
        background: #0284c7;
    }

    .status-indicator.bg-success {
        background: #059669;
    }

    .status-indicator.bg-danger {
        background: #dc2626;
    }

    .status-indicator.bg-secondary {
        background: #64748b;
    }

    .status-indicator .dot {
        width: 8px;
        height: 8px;
        background: white;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    /* Action Buttons */
    .action-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 1rem;
    }

    .btn-action {
        padding: 14px;
        border-radius: 15px;
        border: none;
        font-weight: 700;
        color: white;
        transition: all 0.3s;
    }

    .approve {
        background: linear-gradient(135deg, #10b981, #059669);
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2);
    }

    .reject {
        background: linear-gradient(135deg, #f43f5e, #dc2626);
        box-shadow: 0 10px 20px rgba(244, 63, 94, 0.2);
    }

    .btn-action:hover:not(:disabled) {
        transform: translateY(-3px);
        filter: brightness(1.1);
    }

    /* Back Button */
    .btn-back-glass {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        padding: 8px 20px;
        border-radius: 12px;
        font-weight: 600;
        color: #475569;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-back-glass:hover {
        background: #f8fafc;
        color: #1e293b;
    }

    /* Animations */
    @@keyframes pulse {
        0% {
            transform: scale(0.95);
            opacity: 0.8;
        }

        70% {
            transform: scale(1.1);
            opacity: 1;
        }

        100% {
            transform: scale(0.95);
            opacity: 0.8;
        }
    }
</style>

@code {
    [Parameter] public int RequestId { get; set; }

    private HttpClient _httpClient = null!;
    private CancellationTokenSource _cts = new();

    private UpgradeRequestVM? request;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");

        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
        {
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }

        await LoadRequestDetails();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadRequestDetails()
    {
        try
        {
            var response = await _httpClient.GetAsync($"v1/admin/upgrade-requests/{RequestId}", _cts.Token);

            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<UpgradeRequestVM>>();
                if (apiResponse?.Content != null)
                {
                    request = apiResponse.Content;
                }
                else
                {
                    SnackbarHelper.Show(Snackbar, StatusCodeResponse.NotFound, MessageResponse.RequestManagement.Request.NOT_FOUND);
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            SnackbarHelper.Show(Snackbar, StatusCodeResponse.Error,
MessageResponse.RequestManagement.Request.ERROR_LOADING_DETAILS);
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/admin/requests/requests-overview");
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        UpgradeRequestStatusConst.Pending => "bg-primary",
        UpgradeRequestStatusConst.Approved => "bg-success",
        UpgradeRequestStatusConst.Rejected => "bg-danger",
        UpgradeRequestStatusConst.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };

    private async Task ApproveRequest()
    {
        if (isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = await _httpClient.PostAsync($"v1/admin/upgrade-requests/{RequestId}/approve", null, _cts.Token);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (apiResponse != null && !string.IsNullOrEmpty(apiResponse.StatusCode))
            {
                SnackbarHelper.Show(Snackbar, apiResponse.StatusCode, apiResponse.Message ?? string.Empty);
            }

            if (response.IsSuccessStatusCode)
            {
                request!.Status = UpgradeRequestStatusConst.Approved;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RejectRequest()
    {
        if (isProcessing) return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = await _httpClient.PostAsync($"v1/admin/upgrade-requests/{RequestId}/reject", null, _cts.Token);
            var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (apiResponse != null && !string.IsNullOrEmpty(apiResponse.StatusCode))
            {
                SnackbarHelper.Show(Snackbar, apiResponse.StatusCode, apiResponse.Message ?? string.Empty);
            }

            if (response.IsSuccessStatusCode)
            {
                request!.Status = UpgradeRequestStatusConst.Rejected;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
}