@using HotelBooking.webapp.ViewModels
@using HotelBooking.webapp.ViewModels.Request

@code {
    [Parameter] public RequestStatsVM Stats { get; set; } = new();
}

<div class="stats-overview force-gpu">
    @* --- Row 1: Primary Status Indicators --- *@
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card-glass shadow-sm">
                <div class="stat-label">Pending</div>
                <div class="stat-value text-blue">@Stats.Overall.Pending</div>
                <div class="stat-indicator bg-blue"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-glass shadow-sm">
                <div class="stat-label">Approved</div>
                <div class="stat-value text-green">@Stats.Overall.Approved</div>
                <div class="stat-indicator bg-green"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-glass shadow-sm">
                <div class="stat-label">Rejected</div>
                <div class="stat-value text-red">@Stats.Overall.Rejected</div>
                <div class="stat-indicator bg-red"></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card-glass shadow-sm">
                <div class="stat-label">Today</div>
                <div class="stat-value text-info">@Stats.TotalToday</div>
                <div class="stat-indicator bg-info"></div>
            </div>
        </div>
    </div>

    @* --- Row 2: Historical/Timeline Stats --- *@
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card-glass detail-type shadow-sm d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-small-label">This Week</div>
                    <h3 class="stat-total-val">@Stats.Overall.ThisWeek</h3>
                </div>
                <div class="stat-icon-box blue force-gpu">
                    <i class="fas fa-calendar-week"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-glass detail-type shadow-sm d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-small-label">This Month</div>
                    <h3 class="stat-total-val">@Stats.Overall.ThisMonth</h3>
                </div>
                <div class="stat-icon-box green force-gpu">
                    <i class="fas fa-calendar-alt"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-glass detail-type shadow-sm d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-small-label">Total History</div>
                    <h3 class="stat-total-val">@Stats.Overall.Total</h3>
                </div>
                <div class="stat-icon-box dark force-gpu">
                    <i class="fas fa-list-check"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* --- INTEGRATED CSS WITH site.css VARIABLES --- */

    .stat-card-glass {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .stat-card-glass:hover {
        transform: translateY(-5px);
        background: var(--glass-bg-deep);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05) !important;
    }

    /* Text Elements */
    .stat-label {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 900;
        line-height: 1;
        margin: 0;
    }

    .stat-small-label {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .stat-total-val {
        color: var(--text-dark);
        font-weight: 800;
        font-size: 1.75rem;
        margin: 0;
    }

    /* Semantic Colors using Variables */
    .text-blue {
        color: var(--admin-blue);
    }

    .text-green {
        color: var(--color-success);
    }

    .text-red {
        color: var(--color-danger);
    }

    .text-info {
        color: var(--color-info);
    }

    .bg-blue {
        background: var(--admin-blue);
    }

    .bg-green {
        background: var(--color-success);
    }

    .bg-red {
        background: var(--color-danger);
    }

    .bg-info {
        background: var(--color-info);
    }

    /* Bottom Decorative Indicator */
    .stat-indicator {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 5px;
        width: 100%;
        opacity: 0.4;
    }

    /* Icon Boxes */
    .stat-icon-box {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .stat-icon-box.blue {
        background: rgba(58, 123, 213, 0.1);
        color: var(--admin-blue);
    }

    .stat-icon-box.green {
        background: rgba(16, 185, 129, 0.1);
        color: var(--color-success);
    }

    .stat-icon-box.dark {
        background: rgba(30, 41, 59, 0.1);
        color: var(--text-main);
    }

    /* Details styling */
    .stat-card-glass.detail-type {
        padding: 1.25rem 1.5rem;
    }
</style>
