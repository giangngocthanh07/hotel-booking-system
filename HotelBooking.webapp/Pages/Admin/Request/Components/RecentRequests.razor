@using HotelBooking.webapp.ViewModels
@using HotelBooking.webapp.ViewModels.Request
@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory

<div class="glass-inner-card animate__animated animate__fadeIn force-gpu">
    @* --- Header Section with Filters --- *@
    <div class="glass-header-controls d-flex justify-content-between align-items-center p-4">
        <h5 class="mb-0 fw-bold text-dark">Recent Requests</h5>
        <div class="d-flex gap-3 search-filter-area">
            <div class="search-box-glass">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control glass-input-search" placeholder="Search ID, Name..."
                       @bind="searchTerm" @bind:event="oninput" />
            </div>
            <select class="form-select glass-select-filter" @bind="selectedStatus">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
    </div>

    @* --- Data Table Section --- *@
    <div class="table-responsive">
        <table class="table align-middle mb-0 glass-table-modern">
            <thead>
                <tr>
                    <th class="text-center" style="width: 100px;">Request ID</th>
                    <th class="text-start px-4">User Information</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Requested At</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredRequests.Any())
                {
                    @foreach (var req in FilteredRequests)
                    {
                        <tr class="glass-row-hover">
                            <td class="text-center fw-bold text-primary">#@req.Id</td>
                            <td class="text-start px-4">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-dark fs-6">@req.RequesterName</span>
                                    <small class="text-muted font-monospace"
                                           style="font-size: 0.7rem;">@@@req.TypeDisplay</small>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="status-badge-modern @GetStatusBadgeClass(req.Status) force-gpu">
                                    <span class="status-dot"></span> @req.Status.ToUpper()
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="text-dark small fw-600">@req.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted extra-small">@req.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td class="text-end pe-4">
                                <button class="btn-glass-action" @onclick="() => ViewDetails(req.Id, req.Type)">
                                    <span>View Details</span>
                                    <i class="fas fa-arrow-right"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="empty-state-wrap">
                                <i class="fas fa-inbox fa-3x mb-3 opacity-20"></i>
                                <p class="text-muted fw-bold">No requests match your criteria</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* --- CSS REORGANIZED & LINKED TO site.css VARIABLES --- */

    .glass-inner-card {
        background: transparent;
        /* Parent Dashboard component handled the glass bg */
    }

    .glass-header-controls {
        background: rgba(255, 255, 255, 0.2);
        border-bottom: 1px solid var(--glass-border);
    }

    /* Inputs & Search */
    .search-box-glass {
        position: relative;
        min-width: 250px;
    }

    .search-box-glass i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        z-index: 5;
    }

    .glass-input-search,
    .glass-select-filter {
        background: #fff !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 12px;
        padding: 0.6rem 1rem 0.6rem 2.5rem;
        /* Space for icon */
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-dark) !important;
        transition: 0.3s;
    }

    .glass-select-filter {
        padding-left: 1rem;
    }

    .glass-input-search:focus,
    .glass-select-filter:focus {
        border-color: var(--admin-blue) !important;
        box-shadow: 0 0 0 4px rgba(58, 123, 213, 0.1) !important;
    }

    /* Table Typography & Spacing */
    .glass-table-modern thead th {
        background: rgba(0, 0, 0, 0.02);
        color: var(--text-muted) !important;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 1.25rem 1rem;
        border: none;
    }

    .glass-row-hover {
        transition: 0.2s;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03);
    }

    .glass-row-hover:hover {
        background: rgba(255, 255, 255, 0.5);
    }

    .glass-row-hover td {
        padding: 1.25rem 0.75rem;
    }

    /* Modern Status Badges (Soft-Solid Style) */
    .status-badge-modern {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 0.7rem;
        letter-spacing: 0.5px;
        border: 1px solid transparent;
    }

    .status-pending {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #bae6fd;
    }

    .status-approved {
        background: #dcfce7;
        color: var(--color-success);
        border-color: #bbf7d0;
    }

    .status-rejected {
        background: #fee2e2;
        color: var(--color-danger);
        border-color: #fecaca;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: currentColor;
        border-radius: 50%;
    }

    /* Action Button */
    .btn-glass-action {
        background: #fff;
        border: 1.5px solid #e2e8f0;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: 0.2s;
    }

    .btn-glass-action:hover {
        background: var(--admin-blue);
        color: #fff;
        border-color: var(--admin-blue);
        box-shadow: 0 4px 12px rgba(58, 123, 213, 0.2);
    }

    /* General Utilities */
    .fw-600 {
        font-weight: 600;
    }

    .extra-small {
        font-size: 0.65rem;
    }

    .opacity-20 {
        opacity: 0.2;
    }
</style>

@code {
    [Parameter] public List<RecentRequestVM> Requests { get; set; } = new();

    [Parameter] public EventCallback<(int id, string type)> OnApprove { get; set; }
    [Parameter] public EventCallback<(int id, string type)> OnReject { get; set; }

    private string searchTerm = "";
    private string selectedStatus = "";
    private HttpClient? _httpClient;

    protected override void OnInitialized()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
    }

    private IEnumerable<RecentRequestVM> FilteredRequests => Requests
        .Where(r => (string.IsNullOrEmpty(searchTerm) ||
        r.Id.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        r.RequesterName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        r.TypeDisplay.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
        .Where(r => string.IsNullOrEmpty(selectedStatus) || r.Status == selectedStatus)
        .ToList();

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "status-pending",
        "Approved" => "status-approved",
        "Rejected" => "status-rejected",
        _ => "bg-secondary text-white"
    };

    private void ViewDetails(int id, string type)
    {
        if (type == "UpgradeOwner")
        {
            NavigationManager.NavigateTo($"/admin/requests/upgrade-owner/{id}");
        }
        else if (type == "HotelApproval")
        {
            NavigationManager.NavigateTo($"/admin/requests/hotel-approvals/{id}");
        }
    }
}
