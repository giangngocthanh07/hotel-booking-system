@* Filepath: HotelBooking.webapp\Pages\Admin\Request\RequestDashboard.razor *@
@page "/admin/requests/requests-overview"
@implements IDisposable
@using HotelBooking.webapp.ViewModels
@using System.Net.Http.Headers
@using HotelBooking.webapp.ViewModels.Request

@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@inject NavigationManager NavigationManager
@inject IHttpClientFactory _httpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<div class="dashboard-wrapper page-fade-in force-gpu">
    <div class="container-xl">
        <PageTitle>Requests Dashboard</PageTitle>

        @* --- HEADER SECTION --- *@
        <div class="dashboard-header mb-4">
            <div class="d-flex align-items-center">
                <div class="header-icon-wrap me-3 shadow-sm">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div>
                    <h2 class="m-0 fw-bold text-dark">Requests Dashboard</h2>
                    <p class="text-muted small mb-0">Overview of all pending and processed upgrade requests</p>
                </div>
            </div>
        </div>

        @* --- STATS OVERVIEW --- *@
        <div class="glass-container p-4 mb-4 shadow-sm">
            <RequestOverview Stats="@stats" />
        </div>

        @* --- RECENT REQUESTS TABLE/LIST --- *@
        <div class="glass-container shadow-sm overflow-hidden">
            <div class="glass-header-inner p-3 border-bottom">
                <h6 class="m-0 fw-bold text-primary text-uppercase" style="letter-spacing: 1px;">
                    <i class="fa-solid fa-list-ul me-2"></i>Recent Activity
                </h6>
            </div>

            <div class="p-0">
                @* Lưu ý: RecentRequests cần nhận các EventCallback để Dashboard xử lý Modal *@
                <RecentRequests Requests="@pagedRequests" OnApprove="ShowApproveModal" OnReject="ShowRejectModal" />
            </div>

            @* --- FOOTER / PAGINATION --- *@
            <div class="glass-footer-inner p-3 bg-light-glass border-top">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="small text-muted">
                        Showing total <strong>@TotalCount</strong> global requests
                    </div>
                    <div class="pagination-wrapper">
                        <Pagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" TotalCount="@TotalCount"
                                    IsLoading="@isLoading" OnPageChange="GoToPage" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- DASHBOARD CONFIRMATION MODAL --- *@
<div class="modal fade" id="confirmDashboardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-modal force-gpu">
            <div class="modal-header border-0 @modalHeaderClass text-white glass-modal-header shadow-sm">
                <h5 class="modal-title fw-bold">
                    <i class="@modalIcon me-2"></i>@modalTitle
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="@modalIcon fa-3x @modalTextClass opacity-25"></i>
                </div>
                <p class="text-dark fw-bold fs-5">@modalMessage</p>
                @if (selectedRequestId > 0)
                {
                    <p class="text-muted small">Confirming action for request <strong>#@selectedRequestId</strong></p>
                }
            </div>
            <div class="modal-footer border-0 pb-4 justify-content-center gap-2">
                <button type="button" class="btn-glass-cancel px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn @modalBtnClass px-4 shadow-sm fw-bold"
                        @onclick="ConfirmDashboardAction" disabled="@isProcessingAction">
                    @if (isProcessingAction)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Confirm Action
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* --- DASHBOARD SPECIFIC STYLES --- */
    .dashboard-wrapper {
        padding: 2rem 0;
        min-height: calc(100vh - 100px);
    }

    .header-icon-wrap {
        width: 50px;
        height: 50px;
        background: var(--admin-primary-gradient);
        color: white;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .glass-container {
        background: var(--glass-bg);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
    }

    .glass-header-inner {
        background: rgba(255, 255, 255, 0.3);
    }

    .bg-light-glass {
        background: rgba(0, 0, 0, 0.02);
    }

    .page-fade-in {
        animation: fadeInDashboard 0.5s ease;
    }

    /* Modal Styles Sync */
    .glass-modal {
        background: rgba(255, 255, 255, 0.95) !important;
        backdrop-filter: blur(20px);
        border-radius: 28px !important;
        border: 1px solid var(--glass-border) !important;
        overflow: hidden;
    }

    .glass-modal-header {
        padding: 1.5rem;
    }

    .btn-glass-cancel {
        background: #f1f5f9;
        border: 1.5px solid #e2e8f0;
        color: var(--text-muted);
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 20px;
        transition: 0.3s;
    }

    .btn-glass-cancel:hover {
        background: #e2e8f0;
        color: var(--text-dark);
    }

    @@keyframes fadeInDashboard {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private HttpClient _httpClient = null!;
    private CancellationTokenSource _cts = new();

    private List<UpgradeRequestVM> pagedRequests = new();
    private RequestStatsVM stats = new();
    private bool isLoading = false;

    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 5;
    private int TotalPages { get; set; } = 0;
    private int TotalCount { get; set; } = 0;

    // --- MODAL ACTION STATE ---
    private int selectedRequestId = 0;
    private string actionType = "";
    private string modalTitle = "";
    private string modalMessage = "";
    private string modalHeaderClass = "";
    private string modalBtnClass = "";
    private string modalTextClass = "";
    private string modalIcon = "";
    private bool isProcessingAction = false;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = _httpClientFactory.CreateClient("HotelBookingAPI");
        var token = await _localStorage.GetItemAsync<string>("accessToken");
        if (!string.IsNullOrEmpty(token))
            _httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        await LoadStatsAsync();
        await LoadPagedRequestsAsync();
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }

    private async Task LoadStatsAsync()
    {
        try
        {
            var response = await _httpClient.GetAsync("v1/admin/requests/stats", _cts.Token);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<RequestStatsVM>>();
                if (apiResponse?.Content != null) stats = apiResponse.Content;
            }
        }
        catch (Exception ex) { Console.WriteLine($"Error stats: {ex.Message}"); }
    }

    private async Task LoadPagedRequestsAsync()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var url = $"v1/admin/upgrade-requests?pageIndex={CurrentPage}&pageSize={PageSize}";
            var response = await _httpClient.GetAsync(url, _cts.Token);
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<PagedResult<UpgradeRequestVM>>>();
                if (apiResponse?.Content != null)
                {
                    pagedRequests = apiResponse.Content.Items;
                    TotalPages = apiResponse.Content.TotalPages;
                    TotalCount = apiResponse.Content.TotalCount;
                }
            }
        }
        finally { isLoading = false; StateHasChanged(); }
    }

    // --- MODAL HANDLERS ---
    private async Task ShowApproveModal(int reqId)
    {
        selectedRequestId = reqId;
        actionType = "approve";
        modalTitle = "Approve Partner";
        modalMessage = "Confirm approval for this upgrade request?";
        modalHeaderClass = "bg-success";
        modalBtnClass = "btn-success";
        modalTextClass = "text-success";
        modalIcon = "fas fa-check-circle";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmDashboardModal')).show()");
    }

    private async Task ShowRejectModal(int reqId)
    {
        selectedRequestId = reqId;
        actionType = "reject";
        modalTitle = "Reject Request";
        modalMessage = "Are you sure you want to reject this application?";
        modalHeaderClass = "bg-danger";
        modalBtnClass = "btn-danger";
        modalTextClass = "text-danger";
        modalIcon = "fas fa-times-circle";
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('confirmDashboardModal')).show()");
    }

    private async Task ConfirmDashboardAction()
    {
        if (isProcessingAction) return;
        isProcessingAction = true;
        try
        {
            var url = actionType == "approve"
                ? $"v1/admin/upgrade-requests/{selectedRequestId}/approve"
                : $"v1/admin/upgrade-requests/{selectedRequestId}/reject";

            var response = await _httpClient.PostAsync(url, null);
            await JSRuntime.InvokeVoidAsync("eval",
"bootstrap.Modal.getInstance(document.getElementById('confirmDashboardModal')).hide()");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Request processed successfully!", Severity.Success);
                await LoadStatsAsync();
                await LoadPagedRequestsAsync();
            }
        }
        finally { isProcessingAction = false; }
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            CurrentPage =
page; await LoadPagedRequestsAsync();
        }
    }
}